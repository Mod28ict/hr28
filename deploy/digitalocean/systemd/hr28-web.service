# HR28 web app - behind Nginx (127.0.0.1:5000). Settings: /etc/hr28/web.env (mode 640).
# Install: /etc/systemd/system/hr28-web.service, then: systemctl daemon-reload && systemctl enable --now hr28-web
[Unit]
Description=HR28 web app
After=network-online.target hr28-api.service
Wants=network-online.target

[Service]
User=hr28web
Group=hr28web
WorkingDirectory=/var/www/hr28
ExecStart=/usr/bin/dotnet /var/www/hr28/HR28.Web.dll
EnvironmentFile=/etc/hr28/web.env
Environment=DOTNET_NOLOGO=1 DOTNET_CLI_TELEMETRY_OPTOUT=1
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
SyslogIdentifier=hr28-web

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hr28/web-keys
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
