# /etc/hr28/api.env  (root:hr28api, mode 640) - created by scripts/setup-secrets.sh.
# Names only here; the real values are generated on the server and never committed.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5001
ConnectionStrings__DefaultConnection=Server=127.0.0.1,1433;Database=HR28Db;User Id=hr28_app;Password=<generated>;Encrypt=True;TrustServerCertificate=True
Jwt__Key=<generated>
Security__AuthorizationCodeKey=<generated>
App__SignInUrl=https://shamheed.com
Logging__LogLevel__Default=Warning
# SMS: the Dhiraagu Bulk SMS login is NOT here but in /etc/hr28/sms.env (written by
# hr28-sms-credentials): DhiraaguSms__Endpoint, DhiraaguSms__Username, DhiraaguSms__Password.
