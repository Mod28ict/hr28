# HR28 TRAINING web app (127.0.0.1:5010, https://tr.shamheed.com). Settings: /etc/hr28/train-web.env.
# Installed by training/setup-training.sh.
[Unit]
Description=HR28 TRAINING web app
After=network-online.target hr28-train-api.service
Wants=network-online.target

[Service]
User=hr28tweb
Group=hr28tweb
WorkingDirectory=/var/www/hr28-train
ExecStart=/usr/bin/dotnet /var/www/hr28-train/HR28.Web.dll
EnvironmentFile=/etc/hr28/train-web.env
Environment=DOTNET_NOLOGO=1 DOTNET_CLI_TELEMETRY_OPTOUT=1
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
SyslogIdentifier=hr28-train-web

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hr28/train-web-keys
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
