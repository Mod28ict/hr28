<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] | HR28</title>

    <script>
        // Apply the saved theme before the page paints (no light flash in dark mode).
        (function () {
            var key = 'hr28-theme';
            var media = window.matchMedia('(prefers-color-scheme: dark)');

            function get() {
                try { return localStorage.getItem(key) || 'light'; } catch (e) { return 'light'; }
            }

            function resolve(pref) {
                return pref === 'system' ? (media.matches ? 'dark' : 'light') : pref;
            }

            function apply(pref) {
                var theme = resolve(pref);
                document.documentElement.setAttribute('data-theme', theme);
                document.documentElement.setAttribute('data-bs-theme', theme);
            }

            apply(get());

            media.addEventListener('change', function () {
                if (get() === 'system') apply('system');
            });

            window.hr28Theme = {
                get: get,
                resolved: function () { return resolve(get()); },
                set: function (pref) {
                    try { localStorage.setItem(key, pref); } catch (e) { }
                    apply(pref);
                    document.dispatchEvent(new CustomEvent('hr28:theme'));
                }
            };
        })();
    </script>

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/shell.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/ui.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/theme-dark.css" asp-append-version="true" />
<link rel="stylesheet" href="~/HR28.Web.styles.css" asp-append-version="true" />

    <style>
        @@import url("https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css");
        .select2-container--default .select2-selection--single {
    height: 46px !important;
    border: 1px solid #dbe4ef !important;
    border-radius: 12px !important;
    background: #ffffff;
}

.select2-container--default .select2-selection--single .select2-selection__rendered {
    padding-left: 14px !important;
    padding-right: 50px !important;
    line-height: 44px !important;
    color: #0f172a;
    font-size: 15px;
}

.select2-container--default .select2-selection--single .select2-selection__arrow {
    height: 44px !important;
    right: 10px !important;
}

.select2-container--default .select2-selection--single .select2-selection__clear {
    height: 44px;
    margin-right: 22px;
    color: #94a3b8;
    font-size: 18px;
}

.select2-container--default.select2-container--focus .select2-selection--single,
.select2-container--default.select2-container--open .select2-selection--single {
    border-color: #2563eb !important;
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.10);
}

.select2-dropdown {
    border: 1px solid #dbe4ef !important;
    border-radius: 12px !important;
    overflow: hidden;
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.10);
}

.select2-search--dropdown .select2-search__field {
    height: 38px;
    padding: 0 10px;
    border: 1px solid #dbe4ef !important;
    border-radius: 8px;
    outline: none;
}

.select2-results__option {
    padding: 9px 14px;
    font-size: 14px;
}

.select2-container--default .select2-results__option--highlighted[aria-selected],
.select2-results__option--highlighted {
    background: #2563eb !important;
    color: #ffffff !important;
}
.h28-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 18px;
    background: rgba(248, 250, 252, 0.82);
    backdrop-filter: blur(6px);
}

.h28-loader.show {
    display: flex;
}

.h28-loader-ring {
    position: relative;
    width: 64px;
    height: 64px;
}

.h28-loader-ring::before,
.h28-loader-ring::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 4px solid transparent;
}

.h28-loader-ring::before {
    border-color: #dbeafe;
}

.h28-loader-ring::after {
    border-top-color: #2563eb;
    border-right-color: #60a5fa;
    animation: h28Spin 0.8s linear infinite;
}

.h28-loader-mark {
    position: absolute;
    inset: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    background: linear-gradient(135deg, #2563eb, #60a5fa);
}

.h28-loader-text {
    color: #334155;
    font-size: 14px;
    font-weight: 600;
}

.h28-loader-sub {
    margin-top: -12px;
    color: #94a3b8;
    font-size: 12px;
}

@@keyframes h28Spin {
    to { transform: rotate(360deg); }
}
    </style>

</head>

<body class="shell-body">
<div class="h28-loader" id="h28Loader">
    <div class="h28-loader-ring">
        <div class="h28-loader-mark">H28</div>
    </div>
    <div class="h28-loader-text">Loading campaign data…</div>
    <div class="h28-loader-sub">This may take a few seconds</div>
</div>
@{
    var role = Context.Session.GetString("UserRole");

    var userName =
        Context.Session.GetString("UserName")
        ?? "User";

    var initials = string.Concat(
        userName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0])));

    if (string.IsNullOrEmpty(initials))
    {
        initials = "U";
    }

    // Menus follow the person's rights (the API checks them again on every request).
    bool Can(string right) => HR28.Web.Services.Hr28Permissions.Has(Context.Session, right);
    var canViewVoters = Can(HR28.Web.Services.Hr28Permissions.VotersView);

    // Quick entry: find a voter by ID card and add records on one page.
    var canQuickEntry = HR28.Web.Services.Hr28Permissions.CanUseQuickEntry(Context.Session);
    var skipDashboard = HR28.Web.Services.Hr28Permissions.StartsOnQuickEntry(Context.Session);
    var isSuperAdmin = HR28.Web.Services.Hr28Roles.IsSuperAdministrator(role);

    var campaignName = Context.Session.GetString("CampaignName");

    var flashError = TempData["FlashError"] as string;

    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString()
        ?? "";

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString()
        ?? "";

    string NavClass(bool active) =>
        active ? "shell-nav-link is-active" : "shell-nav-link";
}

<div class="shell">

    <aside class="shell-sidebar" id="shellSidebar" aria-label="Main navigation">

        <a class="shell-brand" asp-controller="@(skipDashboard ? "QuickEntry" : "Dashboard")" asp-action="Index">
            <span class="shell-brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 3 7v10l9 5 9-5V7l-9-5zm0 2.3 6.8 3.8L12 11.9 5.2 8.1 12 4.3zM5 9.8l6 3.4v6.6l-6-3.4V9.8zm8 10v-6.6l6-3.4v6.6l-6 3.4z" /></svg>
            </span>
            <span class="shell-brand-text">
                <span>HR28</span>
                <small>Campaign Intelligence</small>
            </span>
        </a>

        <nav class="shell-nav">

            @if (!skipDashboard)
            {
            <a class="@NavClass(currentController == "Dashboard")"
               asp-controller="Dashboard" asp-action="Index">
                <partial name="_Icon" model='"dashboard"' />
                <span>Dashboard</span>
            </a>
            }

            @if (canQuickEntry)
            {
                <a class="@NavClass(currentController == "QuickEntry")"
                   asp-controller="QuickEntry" asp-action="Index">
                    <partial name="_Icon" model='"search"' />
                    <span>Quick entry</span>
                </a>
            }

            @if (canViewVoters)
            {
                <a class="@NavClass(currentController == "Voters")"
                   asp-controller="Voters" asp-action="Index">
                    <partial name="_Icon" model='"users"' />
                    <span>Voters</span>
                </a>
            }

            @if (Can(HR28.Web.Services.Hr28Permissions.InfluencersView))
            {
                <a class="@NavClass(currentController == "Influencers")"
                   asp-controller="Influencers" asp-action="Index">
                    <partial name="_Icon" model='"star"' />
                    <span>Influencers</span>
                </a>
            }

            @if (Can(HR28.Web.Services.Hr28Permissions.EncountersView))
            {
                <a class="@NavClass(currentController == "Encounters")"
                   asp-controller="Encounters" asp-action="Index">
                    <partial name="_Icon" model='"calendar"' />
                    <span>Encounters</span>
                </a>
            }

            @if (Can(HR28.Web.Services.Hr28Permissions.PledgesView))
            {
                <a class="@NavClass(currentController == "Pledges")"
                   asp-controller="Pledges" asp-action="Index">
                    <partial name="_Icon" model='"handshake"' />
                    <span>Pledges</span>
                </a>
            }

            <a class="@NavClass(currentController == "Reports")"
               asp-controller="Reports" asp-action="Index">
                <partial name="_Icon" model='"chart"' />
                <span>Reports</span>
            </a>

            <a class="@NavClass(currentController == "Audit")"
               asp-controller="Audit" asp-action="Index">
                <partial name="_Icon" model='"clipboard"' />
                <span>Audit Trail</span>
            </a>

            @if (isSuperAdmin)
            {
                <div class="shell-nav-section">Administration</div>

                <a class="@NavClass(currentController == "Users")"
                   asp-controller="Users" asp-action="Index">
                    <partial name="_Icon" model='"user"' />
                    <span>Users</span>
                </a>
            }

            <a class="@NavClass(currentController == "Settings")"
               asp-controller="Settings" asp-action="Index">
                <partial name="_Icon" model='"key"' />
                <span>Settings</span>
            </a>

        </nav>

        @* The client's campaign name (Settings → System), one word per line. *@
        <div class="shell-sidebar-tagline" aria-hidden="true">
            @{
                // "Campaign Intelligence" is the default when no name has been set.
                var taglineWords = (string.IsNullOrWhiteSpace(campaignName) || campaignName == "Campaign Intelligence"
                        ? "People Insights Progress"
                        : campaignName)
                    .Split(' ', StringSplitOptions.RemoveEmptyEntries);
            }
            @for (var w = 0; w < taglineWords.Length; w++)
            {
                @taglineWords[w]
                if (w < taglineWords.Length - 1)
                {
                    <br />
                }
            }
        </div>

    </aside>

    <div class="shell-backdrop" id="shellBackdrop" hidden></div>

    <div class="shell-main">

        <header class="shell-topbar">

            <button type="button"
                    class="shell-menu-toggle"
                    id="shellMenuToggle"
                    aria-controls="shellSidebar"
                    aria-expanded="false"
                    aria-label="Open navigation">
                <partial name="_Icon" model='"menu"' />
            </button>

            @if (canViewVoters)
            {
                <form class="shell-search"
                      role="search"
                      method="get"
                      asp-controller="Voters"
                      asp-action="Index">
                    @* Looking up a person: search every party, not just the list's default. *@
                    <input type="hidden" name="party" value="all" />
                    <label for="shellSearch" class="visually-hidden">Search voters</label>
                    <partial name="_Icon" model='"search"' />
                    <input id="shellSearch"
                           name="searchTerm"
                           type="search"
                           autocomplete="off"
                           placeholder="Search voters by name or National ID…" />
                    <kbd class="shell-kbd" aria-hidden="true">Ctrl + K</kbd>
                </form>
            }
            else
            {
                <div class="shell-search-spacer"></div>
            }

            <div class="dropdown">
                <button type="button"
                        class="shell-user"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">
                    <span class="shell-user-avatar" aria-hidden="true">@initials</span>
                    <span class="shell-user-text">
                        <strong>@userName</strong>
                        <small>@HR28.Web.Services.Hr28Roles.Summary(role)</small>
                    </span>
                    <partial name="_Icon" model='"chevron-down"' />
                </button>

                <ul class="dropdown-menu dropdown-menu-end shell-user-menu">
                    <li>
                        <a class="dropdown-item" asp-controller="Settings" asp-action="Index" asp-route-tab="account">
                            <partial name="_Icon" model='"user"' />
                            My account
                        </a>
                    </li>
                    <li>
                        <div class="dropdown-item shell-theme-toggle">
                            <label class="form-check form-switch m-0 d-flex align-items-center gap-2" for="shellThemeSwitch">
                                <input class="form-check-input m-0" type="checkbox" role="switch" id="shellThemeSwitch" />
                                <span>Dark mode</span>
                            </label>
                        </div>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        @* A form, not a link: another site cannot sign people out, and the anti-forgery token is checked. *@
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="dropdown-item text-danger">
                                <partial name="_Icon" model='"logout"' />
                                Sign out
                            </button>
                        </form>
                    </li>
                </ul>
            </div>

        </header>

        <main role="main" class="shell-content">
            @if (!string.IsNullOrWhiteSpace(flashError))
            {
                <div class="ui-alert is-red" role="alert">
                    <partial name="_Icon" model='"alert"' />
                    <span>@flashError</span>
                </div>
            }

            @RenderBody()
        </main>

        <footer class="shell-footer">
            &copy; @HR28.Web.Services.Hr28Time.Now.Year HR28 &middot; Campaign Intelligence Platform | Designed and Developed by: Ahmed Rasheed
        </footer>

    </div>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
    (function () {
        const loader = document.getElementById("h28Loader");

        function showLoader() {
            loader.classList.add("show");
        }

        function hideLoader() {
            loader.classList.remove("show");
        }

        document.addEventListener("click", function (e) {
            const link = e.target.closest("a");

            if (!link) return;

            const href = link.getAttribute("href");

            if (!href ||
                href.startsWith("#") ||
                href.startsWith("javascript") ||
                link.target === "_blank" ||
                link.hasAttribute("download") ||
                e.ctrlKey || e.metaKey || e.shiftKey) {
                return;
            }

            if (link.origin !== window.location.origin) return;

            showLoader();
        });

        document.addEventListener("submit", function () {
            showLoader();
        });

        // Hide the loader again if the user presses Back
        window.addEventListener("pageshow", hideLoader);
    })();

    (function () {
        const sidebar = document.getElementById("shellSidebar");
        const backdrop = document.getElementById("shellBackdrop");
        const toggle = document.getElementById("shellMenuToggle");
        const search = document.getElementById("shellSearch");
        const themeSwitch = document.getElementById("shellThemeSwitch");

        // Quick light/dark switch in the user menu (full choice lives in Settings).
        if (themeSwitch && window.hr28Theme) {
            const sync = function () {
                themeSwitch.checked = window.hr28Theme.resolved() === "dark";
            };

            sync();
            document.addEventListener("hr28:theme", sync);

            themeSwitch.addEventListener("change", function () {
                window.hr28Theme.set(themeSwitch.checked ? "dark" : "light");
            });
        }

        function setSidebar(open) {
            sidebar.classList.toggle("is-open", open);
            backdrop.hidden = !open;
            toggle.setAttribute("aria-expanded", open ? "true" : "false");
        }

        toggle.addEventListener("click", function () {
            setSidebar(!sidebar.classList.contains("is-open"));
        });

        backdrop.addEventListener("click", function () {
            setSidebar(false);
        });

        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && sidebar.classList.contains("is-open")) {
                setSidebar(false);
                toggle.focus();
            }

            if (search && (e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
                e.preventDefault();
                search.focus();
            }
        });

        // Fields marked h28-digits-only (e.g. mobile numbers) keep digits only,
        // whether typed or pasted ("777 1234" becomes "7771234").
        document.addEventListener("input", function (e) {
            var field = e.target;
            if (!field.classList || !field.classList.contains("h28-digits-only")) return;
            var digits = field.value.replace(/\D/g, "");
            var max = parseInt(field.getAttribute("maxlength"), 10);
            if (max > 0) digits = digits.slice(0, max);
            if (digits !== field.value) field.value = digits;
        });

        // The hint says how to reach the box (Ctrl + K) until you are in it,
        // then how to search (Enter).
        var searchHint = document.querySelector(".shell-search .shell-kbd");

        if (search && searchHint) {
            search.addEventListener("focus", function () { searchHint.textContent = "Enter"; });
            search.addEventListener("blur", function () { searchHint.textContent = "Ctrl + K"; });
        }
    })();
</script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
