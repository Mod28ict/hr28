@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="ui-page is-narrow" style="max-width: 560px;">

    <section class="ui-card ui-card-lg" style="margin-top: 40px; text-align: center;">

        <span class="ui-head-icon is-red" style="width: 64px; height: 64px; margin: 4px auto 16px; border-radius: 50%;">
            <partial name="_Icon" model='"alert"' />
        </span>

        <h1 class="ui-title">Something went wrong</h1>
        <p class="ui-sub">
            We couldn't complete your request. Please try again in a moment.
            If the problem continues, contact your system administrator.
        </p>

        <div class="ui-form-actions" style="justify-content: center; margin-top: 22px;">
            <a asp-controller="Dashboard" asp-action="Index" class="ui-btn ui-btn-primary">
                <partial name="_Icon" model='"dashboard"' />
                Go to dashboard
            </a>

            <button type="button" class="ui-btn ui-btn-secondary" onclick="history.back()">
                <partial name="_Icon" model='"arrow-left"' />
                Go back
            </button>
        </div>

    </section>

</div>
