@model string?
@* An ID card number with a copy button that appears on hover (always shown on touch screens). Script: wwwroot/js/site.js *@
@if (string.IsNullOrWhiteSpace(Model))
{
    <span>—</span>
}
else
{
    <span class="ui-copy-id"><span class="ui-num">@Model</span><button type="button" class="ui-copy-btn" data-copy="@Model" title="Copy ID card number" aria-label="Copy ID card number @Model"><partial name="_Icon" model='"copy"' /></button></span>
}
