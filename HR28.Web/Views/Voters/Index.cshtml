@model HR28.Web.Models.PagedResult<HR28.Web.Models.VoterSearchDto>

@{
    ViewData["Title"] = "Voters";

    var searchTerm = ViewBag.SearchTerm as string ?? string.Empty;
    var filter = ViewBag.Filter as HR28.Web.Models.VoterListFilterModel ?? new HR28.Web.Models.VoterListFilterModel();
    var errorMessage = ViewBag.ErrorMessage as string;

    // Page links keep the search and filters.
    Dictionary<string, string> PageRoute(int pageNumber)
    {
        var values = filter.RouteValues();
        values["page"] = pageNumber.ToString();
        return values;
    }

    var userRole = Context.Session.GetString("UserRole");
    var isAdministrator = HR28.Web.Services.Hr28Roles.IsAdministrator(userRole);
    // Rights (the API checks them again): adding voters, and changing status from the list.
    var canAdd = HR28.Web.Services.Hr28Permissions.Has(Context.Session, HR28.Web.Services.Hr28Permissions.VotersAdd);
    var canWrite = HR28.Web.Services.Hr28Permissions.Has(Context.Session, HR28.Web.Services.Hr28Permissions.VotersEdit);

    var startRecord = Model.TotalCount == 0
        ? 0
        : ((Model.Page - 1) * Model.PageSize) + 1;

    var endRecord = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);

    var firstVisiblePage = Math.Max(1, Model.Page - 2);
    var lastVisiblePage = Math.Min(Model.TotalPages, Model.Page + 2);

    string InitialsOf(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
}

<div class="ui-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="ui-alert is-green" role="status">
            <partial name="_Icon" model='"check-circle"' />
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <header class="ui-head">
        <div class="ui-head-main">
            <span class="ui-head-icon is-blue"><partial name="_Icon" model='"users"' /></span>
            <div>
                <h1 class="ui-title">Voters</h1>
                <p class="ui-sub">
                    @Model.TotalCount.ToString("N0")
                    @(filter.IsNarrowed
                        ? (Model.TotalCount == 1 ? "voter matches your search and filters" : "voters match your search and filters")
                        : (Model.TotalCount == 1 ? "voter within your assigned scope" : "voters within your assigned scope"))
                </p>
            </div>
        </div>

        <div class="ui-head-actions">
            @if (isAdministrator)
            {
                <a asp-controller="VoterImport" asp-action="Index" class="ui-btn ui-btn-secondary">
                    <partial name="_Icon" model='"upload"' />
                    Upload voter list
                </a>
                <a asp-controller="VoterImport" asp-action="Membership" class="ui-btn ui-btn-secondary">
                    <partial name="_Icon" model='"upload"' />
                    Upload membership list
                </a>
            }
            @if (canAdd)
            {
                <a asp-action="Create" class="ui-btn ui-btn-primary">
                    <partial name="_Icon" model='"plus"' />
                    Add Voter
                </a>
            }
        </div>
    </header>

    <section class="ui-card">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="ui-alert is-red" role="alert">
                <partial name="_Icon" model='"alert"' />
                <span>@errorMessage</span>
            </div>
        }

        <form asp-action="Index" method="get" role="search" id="h28VoterFilters">

            <div class="ui-toolbar">
                <div class="ui-search">
                    <partial name="_Icon" model='"search"' />
                    <label for="voterSearch" class="visually-hidden">Search voters</label>
                    <input type="search"
                           id="voterSearch"
                           name="searchTerm"
                           value="@filter.SearchTerm"
                           maxlength="100"
                           class="ui-input"
                           placeholder="Search by name, National ID, phone or island" />
                </div>

                @* Party sits next to the search: the list opens on the default party (MDP). *@
                <label for="filterParty" class="visually-hidden">Party</label>
                <select id="filterParty"
                        name="party"
                        class="ui-select ui-select-auto ui-party-select"
                        title="Party"
                        onchange="this.form.requestSubmit()">
                    <option value="@HR28.Web.Models.VoterListFilterModel.AllParties" selected="@(filter.Party == HR28.Web.Models.VoterListFilterModel.AllParties)">All parties</option>
                    @foreach (var p in filter.Parties)
                    {
                        <option value="@p.Id" selected="@(filter.PartyId == p.Id)">@p.Label</option>
                    }
                    <option value="@HR28.Web.Models.VoterListFilterModel.PartyNotKnown" selected="@filter.NoParty">Party not known</option>
                </select>

                <button type="submit" class="ui-btn ui-btn-primary">Search</button>

                <label for="voterPageSize" class="visually-hidden">Rows per page</label>
                <select name="pageSize"
                        id="voterPageSize"
                        class="ui-select ui-select-auto"
                        onchange="this.form.requestSubmit()">
                    @foreach (var size in new[] { 10, 20, 50, 100 })
                    {
                        if (filter.PageSize == size)
                        {
                            <option value="@size" selected>@size per page</option>
                        }
                        else
                        {
                            <option value="@size">@size per page</option>
                        }
                    }
                </select>
            </div>

            <div class="ui-filter-row is-5">
                <div class="ui-filter">
                    <label for="filterConstituency" class="ui-label">Constituency</label>
                    <select id="filterConstituency" name="constituencyId" class="ui-select">
                        <option value="">All constituencies</option>
                        @foreach (var c in filter.Constituencies)
                        {
                            if (filter.ConstituencyId == c.Id)
                            {
                                <option value="@c.Id" selected>@HR28.Web.Models.VoterListFilterModel.Label(c)</option>
                            }
                            else
                            {
                                <option value="@c.Id">@HR28.Web.Models.VoterListFilterModel.Label(c)</option>
                            }
                        }
                    </select>
                </div>

                <div class="ui-filter">
                    <label for="filterIsland" class="ui-label">Island</label>
                    <select id="filterIsland"
                            name="islandId"
                            class="ui-select"
                            data-islands-url="@Url.Action("IslandsInScope", "Voters")"
                            disabled="@(!filter.ConstituencyId.HasValue)">
                        <option value="">@(filter.ConstituencyId.HasValue ? "All islands" : "Choose a constituency first")</option>
                        @foreach (var i in filter.Islands)
                        {
                            if (filter.IslandId == i.Id)
                            {
                                <option value="@i.Id" selected>@i.Name</option>
                            }
                            else
                            {
                                <option value="@i.Id">@i.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="ui-filter">
                    <label for="filterHouse" class="ui-label">House</label>
                    <input type="text"
                           id="filterHouse"
                           name="house"
                           value="@filter.House"
                           maxlength="100"
                           class="ui-input"
                           placeholder="House name" />
                    <label class="ui-check-inline" for="filterHouseExact">
                        <input type="checkbox" id="filterHouseExact" name="houseExact" value="true" @(filter.HouseExact ? "checked" : "") />
                        Match house name exactly
                    </label>
                </div>

                <div class="ui-filter">
                    <label for="filterGender" class="ui-label">Gender</label>
                    <select id="filterGender" name="gender" class="ui-select">
                        <option value="">All</option>
                        @foreach (var g in HR28.Web.Models.VoterListFilterModel.Genders)
                        {
                            <option value="@g.Value" selected="@(filter.Gender == g.Value)">@g.Label</option>
                        }
                    </select>
                </div>

                <div class="ui-filter">
                    <label for="filterStatus" class="ui-label">Status</label>
                    <select id="filterStatus" name="status" class="ui-select">
                        <option value="">All statuses</option>
                        @foreach (var st in HR28.Web.Models.VoterListFilterModel.Statuses)
                        {
                            if (filter.Status == st)
                            {
                                <option value="@st" selected>@st</option>
                            }
                            else
                            {
                                <option value="@st">@st</option>
                            }
                        }
                    </select>
                </div>

                <div class="ui-filter ui-filter-actions">
                    <button type="submit" class="ui-btn ui-btn-secondary">Apply filters</button>
                    @if (filter.IsNarrowed)
                    {
                        <a asp-action="Index"
                           asp-route-pageSize="@filter.PageSize"
                           asp-route-party="@HR28.Web.Models.VoterListFilterModel.AllParties"
                           class="ui-btn ui-btn-ghost">Clear all</a>
                    }
                </div>
            </div>

        </form>

        @if (!Model.Items.Any())
        {
            <div class="ui-empty">
                <partial name="_Icon" model='"search"' />
                @(filter.IsNarrowed
                    ? "No voters match your search and filters."
                    : "No voters found within your assigned scope.")

                @if (filter.Party != HR28.Web.Models.VoterListFilterModel.AllParties)
                {
                    // The list opens on one party; make the way to everyone obvious.
                    var partyRoute = filter.RouteValues();
                    partyRoute["party"] = HR28.Web.Models.VoterListFilterModel.AllParties;

                    <a asp-action="Index" asp-all-route-data="partyRoute" class="ui-btn ui-btn-secondary ui-btn-sm" style="margin-top: 6px;">
                        Show all parties
                    </a>
                }
            </div>
        }
        else
        {
            <div class="ui-meta">
                Showing <strong>@startRecord.ToString("N0")</strong>
                to <strong>@endRecord.ToString("N0")</strong>
                of <strong>@Model.TotalCount.ToString("N0")</strong> voters
            </div>

            <div class="ui-table-wrap">
                <table class="ui-table">
                    <thead>
                        <tr>
                            <th>Voter</th>
                            <th>National ID</th>
                            <th>Phone</th>
                            <th>Island</th>
                            <th class="ui-hide-sm">Address</th>
                            <th>Party</th>
                            <th class="is-center">Pledges</th>
                            <th>Status</th>
                            <th><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var voter in Model.Items)
                        {
                            var name = string.IsNullOrWhiteSpace(voter.FullName) ? "Unnamed voter" : voter.FullName;
                            var profileUrl = Url.Action("Profile", new { id = voter.Id });

                            <tr class="ui-row-link" onclick="window.location='@profileUrl'">
                                <td>
                                    <div class="ui-person">
                                        <span class="ui-avatar" aria-hidden="true">@InitialsOf(name)</span>
                                        <span>
                                            <strong>@name</strong>
                                            @if (!string.IsNullOrEmpty(voter.GenderAndAge))
                                            {
                                                <small class="ui-muted">@voter.GenderAndAge</small>
                                            }
                                        </span>
                                    </div>
                                </td>

                                <td class="ui-num ui-muted">@voter.NationalId</td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(voter.MobileNumber))
                                    {
                                        <a href="tel:@voter.MobileNumber"
                                           class="ui-link ui-num"
                                           onclick="event.stopPropagation()">@voter.MobileNumber</a>
                                    }
                                    else
                                    {
                                        <span class="ui-faint">—</span>
                                    }
                                </td>

                                <td style="min-width: 130px;">
                                    @if (!string.IsNullOrWhiteSpace(voter.IslandName))
                                    {
                                        <div>@voter.IslandName</div>
                                    }
                                    else
                                    {
                                        <div class="ui-faint">No island</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(voter.ConstituencyName))
                                    {
                                        <div class="ui-muted" style="font-size: 12px;">@voter.ConstituencyLabel</div>
                                    }
                                </td>

                                <td class="ui-muted ui-hide-sm">
                                    @if (!string.IsNullOrWhiteSpace(voter.Address))
                                    {
                                        @* Everyone at this house, in the same constituency and island *@
                                        <a class="ui-link"
                                           title="Show everyone at @voter.Address"
                                           onclick="event.stopPropagation()"
                                           href="@Url.Action("Index", new { constituencyId = voter.ConstituencyId, islandId = voter.IslandId, house = voter.Address, houseExact = true, party = HR28.Web.Models.VoterListFilterModel.AllParties, pageSize = filter.PageSize })">@voter.Address</a>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(voter.PartyShortName))
                                    {
                                        <span class="ui-tag" title="@voter.PartyName">@voter.PartyShortName</span>
                                    }
                                    else
                                    {
                                        <span class="ui-faint">Not known</span>
                                    }
                                </td>

                                <td class="is-center">
                                    @if (voter.PledgeCount > 0)
                                    {
                                        <span class="ui-count is-amber" title="@voter.PledgeCount pledge@(voter.PledgeCount == 1 ? "" : "s")">@voter.PledgeCount</span>
                                    }
                                    else
                                    {
                                        <span class="ui-faint">0</span>
                                    }
                                </td>

                                <td>
                                    @if (canWrite)
                                    {
                                        <button type="button"
                                                class="ui-status-btn h28-status-btn"
                                                title="Change status"
                                                onclick="event.stopPropagation()"
                                                data-id="@voter.Id"
                                                data-name="@name"
                                                data-status="@voter.SupportStatus">
                                            <partial name="_StatusPill" model="voter.SupportStatus" />
                                        </button>
                                    }
                                    else
                                    {
                                        <partial name="_StatusPill" model="voter.SupportStatus" />
                                    }
                                </td>

                                <td class="is-right">
                                    <a asp-action="Profile"
                                       asp-route-id="@voter.Id"
                                       class="ui-btn ui-btn-secondary ui-btn-sm"
                                       onclick="event.stopPropagation()">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <nav class="ui-pager" aria-label="Voter pagination">

                @if (Model.HasPreviousPage)
                {
                    <a class="ui-page-btn"
                       asp-action="Index"
                       asp-all-route-data="PageRoute(Model.Page - 1)">‹ Previous</a>
                }
                else
                {
                    <span class="ui-page-btn is-disabled">‹ Previous</span>
                }

                @if (firstVisiblePage > 1)
                {
                    <a class="ui-page-btn"
                       asp-action="Index"
                       asp-all-route-data="PageRoute(1)">1</a>

                    if (firstVisiblePage > 2)
                    {
                        <span class="ui-page-btn is-disabled">…</span>
                    }
                }

                @for (var pageNumber = firstVisiblePage; pageNumber <= lastVisiblePage; pageNumber++)
                {
                    if (pageNumber == Model.Page)
                    {
                        <span class="ui-page-btn is-current" aria-current="page">@pageNumber</span>
                    }
                    else
                    {
                        <a class="ui-page-btn"
                           asp-action="Index"
                           asp-all-route-data="PageRoute(pageNumber)">@pageNumber</a>
                    }
                }

                @if (lastVisiblePage < Model.TotalPages)
                {
                    if (lastVisiblePage < Model.TotalPages - 1)
                    {
                        <span class="ui-page-btn is-disabled">…</span>
                    }

                    <a class="ui-page-btn"
                       asp-action="Index"
                       asp-all-route-data="PageRoute(Model.TotalPages)">@Model.TotalPages.ToString("N0")</a>
                }

                @if (Model.HasNextPage)
                {
                    <a class="ui-page-btn"
                       asp-action="Index"
                       asp-all-route-data="PageRoute(Model.Page + 1)">Next ›</a>
                }
                else
                {
                    <span class="ui-page-btn is-disabled">Next ›</span>
                }

            </nav>
        }

    </section>

</div>

@if (canWrite)
{
    <dialog id="h28StatusDialog" class="ui-dialog" aria-labelledby="h28StatusTitle">
        <form asp-action="SetStatus" method="post" class="ui-dialog-body">
            <input type="hidden" name="id" id="h28StatusVoterId" />
            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />

            <h2 id="h28StatusTitle" class="ui-dialog-title">Change status</h2>
            <p class="ui-muted" id="h28StatusVoterName"></p>

            <div class="ui-status-choices" role="radiogroup" aria-labelledby="h28StatusTitle">
                @foreach (var st in HR28.Web.Models.VoterListFilterModel.Statuses)
                {
                    <label class="ui-status-choice">
                        <input type="radio" name="status" value="@st" required />
                        <partial name="_StatusPill" model="st" />
                    </label>
                }
            </div>

            <div class="ui-form-actions">
                <button type="submit" class="ui-btn ui-btn-primary">Save status</button>
                <button type="button" class="ui-btn ui-btn-secondary" id="h28StatusCancel">Cancel</button>
            </div>
        </form>
    </dialog>
}

@section Scripts
{
    <script>
        (function ($) {
            var $constituency = $("#filterConstituency");
            var $island = $("#filterIsland");

            if (!$constituency.length || !$island.length) return;

            var searchable = typeof $.fn.select2 === "function";

            // Type-to-search inside the dropdowns (by name or constituency code).
            if (searchable) {
                $constituency.select2({ width: "100%", placeholder: "All constituencies", allowClear: true });

                // No placeholder here, so the box shows its first option:
                // "Choose a constituency first" while disabled, "All islands" once loaded.
                $island.select2({ width: "100%" });
            }

            function resetIslands(text, disabled) {
                $island.empty().append($("<option>", { value: "", text: text }));
                $island.prop("disabled", disabled).trigger("change.select2");
            }

            // Islands follow the chosen constituency (only islands inside the user's areas).
            $constituency.on("change", function () {
                var id = $constituency.val();

                if (!id) {
                    resetIslands("Choose a constituency first", true);
                    return;
                }

                resetIslands("Loading islands…", true);

                $.getJSON($island.data("islandsUrl"), { constituencyId: id })
                    .done(function (islands) {
                        resetIslands("All islands", false);
                        $.each(islands, function (_, i) {
                            $island.append($("<option>", { value: i.id, text: i.name }));
                        });
                        $island.trigger("change.select2");
                    })
                    .fail(function () { resetIslands("All islands", false); });
            });
        })(window.jQuery);

        // Status pop-up: click a voter's status to change it.
        (function () {
            var dialog = document.getElementById("h28StatusDialog");
            if (!dialog) return;

            document.querySelectorAll(".h28-status-btn").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    document.getElementById("h28StatusVoterId").value = btn.dataset.id;
                    document.getElementById("h28StatusVoterName").textContent = btn.dataset.name;
                    dialog.querySelectorAll('input[name="status"]').forEach(function (r) {
                        r.checked = r.value === btn.dataset.status;
                    });
                    dialog.showModal();
                });
            });

            document.getElementById("h28StatusCancel").addEventListener("click", function () { dialog.close(); });
        })();
    </script>
}
