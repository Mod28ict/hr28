@model HR28.Web.Models.PagedResult<
    HR28.Web.Models.VoterSearchDto>

@{
    ViewData["Title"] = "Voters";

    var searchTerm =
        ViewBag.SearchTerm as string
        ?? string.Empty;

    var startRecord =
        Model.TotalCount == 0
            ? 0
            : ((Model.Page - 1)
               * Model.PageSize) + 1;

    var endRecord =
        Math.Min(
            Model.Page * Model.PageSize,
            Model.TotalCount);

    var firstVisiblePage =
        Math.Max(1, Model.Page - 2);

    var lastVisiblePage =
        Math.Min(
            Model.TotalPages,
            Model.Page + 2);
}

<div class="container mt-4">

    <h2>Voters</h2>

    <p class="text-muted">
        Showing voters within your assigned scope.
    </p>

    <form asp-action="Index"
          method="get"
          class="mb-3">

        <input type="hidden"
               name="page"
               value="1" />

        <input type="hidden"
               name="pageSize"
               value="@Model.PageSize" />

        <div class="row g-2">

            <div class="col-md-9">

                <input type="text"
                       name="searchTerm"
                       value="@searchTerm"
                       class="form-control"
                       placeholder=
                       "Search by National ID or name" />

            </div>

            <div class="col-md-3">

                <button type="submit"
                        class="btn btn-primary">

                    Search

                </button>

                @if (!string.IsNullOrWhiteSpace(
                    searchTerm))
                {
                    <a asp-action="Index"
                       asp-route-pageSize=
                           "@Model.PageSize"
                       class="btn btn-secondary">

                        Clear

                    </a>
                }

            </div>

        </div>

    </form>

    <div class="d-flex
                justify-content-between
                align-items-center
                mb-3">

        <span>
            Showing
            <strong>@startRecord</strong>
            to
            <strong>@endRecord</strong>
            of
            <strong>@Model.TotalCount</strong>
            voters
        </span>

        <form asp-action="Index"
              method="get">

            <input type="hidden"
                   name="page"
                   value="1" />

            <input type="hidden"
                   name="searchTerm"
                   value="@searchTerm" />

            <select name="pageSize"
                    class="form-select"
                    onchange="this.form.submit()">

                @foreach (
                    var size
                    in new[] { 10, 20, 50, 100 })
                {
                    if (Model.PageSize == size)
                    {
                        <option value="@size"
                                selected>
                            @size per page
                        </option>
                    }
                    else
                    {
                        <option value="@size">
                            @size per page
                        </option>
                    }
                }

            </select>

        </form>

    </div>

    <div class="table-responsive">

        <table class="table table-striped">

            <thead>
                <tr>
                    <th>National ID</th>
                    <th>Name</th>
                    <th>Address</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="5"
                        class="text-center
                               text-muted">

                        No voters found within
                        your assigned scope.

                    </td>
                </tr>
            }
            else
            {
                @foreach (
                    var voter in Model.Items)
                {
                    <tr>

                        <td>
                            @voter.NationalId
                        </td>

                        <td>
                            @voter.FullName
                        </td>

                        <td>
                            @voter.Address
                        </td>

                        <td>
                            @voter.SupportStatus
                        </td>

                        <td>
                            <a asp-action="Profile"
                               asp-route-id=
                                   "@voter.Id"
                               class=
                                   "btn btn-sm btn-success">

                                View

                            </a>
                        </td>

                    </tr>
                }
            }

            </tbody>

        </table>

    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Voter pagination">

            <ul class="pagination
                       justify-content-center">

                <li class="page-item
                    @(Model.HasPreviousPage
                        ? ""
                        : "disabled")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page=
                           "@(Model.Page - 1)"
                       asp-route-pageSize=
                           "@Model.PageSize"
                       asp-route-searchTerm=
                           "@searchTerm">

                        Previous

                    </a>

                </li>

                @if (firstVisiblePage > 1)
                {
                    <li class="page-item">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="1"
                           asp-route-pageSize=
                               "@Model.PageSize"
                           asp-route-searchTerm=
                               "@searchTerm">

                            1

                        </a>

                    </li>

                    @if (firstVisiblePage > 2)
                    {
                        <li class="page-item
                                   disabled">
                            <span class="page-link">
                                ...
                            </span>
                        </li>
                    }
                }

                @for (
                    var pageNumber =
                        firstVisiblePage;
                    pageNumber <=
                        lastVisiblePage;
                    pageNumber++)
                {
                    <li class="page-item
                        @(pageNumber == Model.Page
                            ? "active"
                            : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page=
                               "@pageNumber"
                           asp-route-pageSize=
                               "@Model.PageSize"
                           asp-route-searchTerm=
                               "@searchTerm">

                            @pageNumber

                        </a>

                    </li>
                }

                @if (
                    lastVisiblePage <
                    Model.TotalPages)
                {
                    @if (
                        lastVisiblePage <
                        Model.TotalPages - 1)
                    {
                        <li class="page-item
                                   disabled">
                            <span class="page-link">
                                ...
                            </span>
                        </li>
                    }

                    <li class="page-item">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page=
                               "@Model.TotalPages"
                           asp-route-pageSize=
                               "@Model.PageSize"
                           asp-route-searchTerm=
                               "@searchTerm">

                            @Model.TotalPages

                        </a>

                    </li>
                }

                <li class="page-item
                    @(Model.HasNextPage
                        ? ""
                        : "disabled")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page=
                           "@(Model.Page + 1)"
                       asp-route-pageSize=
                           "@Model.PageSize"
                       asp-route-searchTerm=
                           "@searchTerm">

                        Next

                    </a>

                </li>

            </ul>

        </nav>
    }

</div>