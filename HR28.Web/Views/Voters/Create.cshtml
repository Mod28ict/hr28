@model HR28.Web.Models.VoterCreateViewModel

@{
    ViewData["Title"] = "Add Voter";

    var selectedIslandId = Model?.Voter?.IslandId?.ToString() ?? string.Empty;
}

<div class="ui-page is-narrow">

    <header class="ui-head">
        <div class="ui-head-main">
            <span class="ui-head-icon is-blue"><partial name="_Icon" model='"user-plus"' /></span>
            <div>
                <nav class="ui-crumb" aria-label="Breadcrumb">
                    <a asp-action="Index">Voters</a> <span aria-hidden="true">/</span> <span>Add voter</span>
                </nav>
                <h1 class="ui-title">Add Voter</h1>
                <p class="ui-sub">Register a new voter and assign them to a constituency and island.</p>
            </div>
        </div>
    </header>

    <section class="ui-card ui-card-lg">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="ui-summary"></div>

            <!-- 1. IDENTITY -->
            <div class="ui-section">
                <div class="ui-section-head">
                    <span class="ui-step">1</span>
                    <div>
                        <div class="ui-section-title">Identity</div>
                        <div class="ui-section-sub">Who the voter is and how to reach them</div>
                    </div>
                </div>

                <div class="ui-grid-2">
                    <div class="ui-field">
                        <label asp-for="Voter.NationalId" class="ui-label">National ID</label>
                        <input asp-for="Voter.NationalId"
                               id="h28NationalId"
                               class="ui-input ui-upper"
                               maxlength="7"
                               placeholder="A123456"
                               autocomplete="off"
                               aria-describedby="h28NidStatus" />
                        <div id="h28NidStatus" class="ui-field-status" aria-live="polite"></div>
                        <span asp-validation-for="Voter.NationalId" class="ui-error"></span>
                    </div>

                    <div class="ui-field">
                        <label asp-for="Voter.MobileNumber" class="ui-label">
                            Mobile number <span class="ui-optional">(optional)</span>
                        </label>
<input asp-for="Voter.MobileNumber"
                               class="ui-input h28-digits-only"
                               inputmode="numeric"
                               maxlength="7"
                               pattern="\d{7}"
                               title="7 digits, e.g. 7771234"
                               placeholder="7XXXXXX" />
                        <span asp-validation-for="Voter.MobileNumber" class="ui-error"></span>
                    </div>

                    <div class="ui-field ui-full">
                        <label asp-for="Voter.FullName" class="ui-label">Full name</label>
                        <input asp-for="Voter.FullName"
                               class="ui-input"
                               placeholder="As shown on the national ID card" />
                        <span asp-validation-for="Voter.FullName" class="ui-error"></span>
                    </div>
                </div>
            </div>

            <!-- 2. LOCATION -->
            <div class="ui-section">
                <div class="ui-section-head">
                    <span class="ui-step">2</span>
                    <div>
                        <div class="ui-section-title">Location</div>
                        <div class="ui-section-sub">Choose the constituency first; islands load automatically</div>
                    </div>
                </div>

                <div class="ui-grid-2">
                    <div class="ui-field">
                        <label asp-for="Voter.ConstituencyId" class="ui-label">Constituency</label>
                        <select asp-for="Voter.ConstituencyId"
                                id="ConstituencyDropdown"
                                class="ui-select">
                            <option value="">Select Constituency</option>
                            @foreach (var item in Model!.Constituencies)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        </select>
                        <span asp-validation-for="Voter.ConstituencyId" class="ui-error"></span>
                    </div>

                    <div class="ui-field">
                        <label asp-for="Voter.IslandId" class="ui-label">Island</label>
                        <select asp-for="Voter.IslandId"
                                id="IslandDropdown"
                                class="ui-select">
                            <option value="">Select Island</option>
                        </select>
                        <div class="ui-hint" id="h28IslandHint">Select a constituency to load its islands.</div>
                        <span asp-validation-for="Voter.IslandId" class="ui-error"></span>
                    </div>

                    <div class="ui-field ui-full">
                        <label asp-for="Voter.Address" class="ui-label">Address</label>
                        <textarea asp-for="Voter.Address"
                                  class="ui-textarea"
                                  placeholder="House name and street"></textarea>
                        <span asp-validation-for="Voter.Address" class="ui-error"></span>
                    </div>
                </div>
            </div>

            <!-- 3. CAMPAIGN -->
            <div class="ui-section">
                <div class="ui-section-head">
                    <span class="ui-step">3</span>
                    <div>
                        <div class="ui-section-title">Campaign</div>
                        <div class="ui-section-sub">Current support status and any notes</div>
                    </div>
                </div>

                <div class="ui-field">
                    <span class="ui-label" id="h28StatusLabel">Support status</span>

                    <div class="ui-chips" id="h28StatusChips" role="radiogroup" aria-labelledby="h28StatusLabel">
                        <span class="ui-chip is-amber" data-v="Undecided" role="radio" tabindex="0">Undecided</span>
                        <span class="ui-chip is-green" data-v="Supporter" role="radio" tabindex="0">Supporter</span>
                        <span class="ui-chip is-red" data-v="Opponent" role="radio" tabindex="0">Opponent</span>
                        <span class="ui-chip is-blue" data-v="Neutral" role="radio" tabindex="0">Neutral</span>
                    </div>

                    <!-- The real field that gets posted; the chips just set it -->
                    <select asp-for="Voter.SupportStatus" id="h28StatusSelect" class="ui-hidden" aria-hidden="true" tabindex="-1">
                        <option value="Undecided">Undecided</option>
                        <option value="Supporter">Supporter</option>
                        <option value="Opponent">Opponent</option>
                        <option value="Neutral">Neutral</option>
                    </select>

                    <span asp-validation-for="Voter.SupportStatus" class="ui-error"></span>
                </div>

                <div class="ui-field">
                    <label asp-for="Voter.Remarks" class="ui-label">
                        Remarks <span class="ui-optional">(optional)</span>
                    </label>
                    <textarea asp-for="Voter.Remarks"
                              class="ui-textarea"
                              placeholder="Any factual notes about this voter"></textarea>
                    <span asp-validation-for="Voter.Remarks" class="ui-error"></span>
                </div>
            </div>

            <div class="ui-form-actions">
                <button type="submit" class="ui-btn ui-btn-primary">
                    <partial name="_Icon" model='"check"' />
                    Save voter
                </button>

                <a asp-controller="Voters"
                   asp-action="Index"
                   class="ui-btn ui-btn-secondary">
                    Cancel
                </a>
            </div>

        </form>

    </section>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {
            var $constituency = $('#ConstituencyDropdown');
            var $island = $('#IslandDropdown');
            var $hint = $('#h28IslandHint');
            var preselectedIsland = '@selectedIslandId';

            // ---- Constituency / island cascade ----
            if (typeof $.fn.select2 === 'function') {
                $constituency.select2({ placeholder: 'Search constituency', width: '100%' });
                $island.select2({ placeholder: 'Search island', width: '100%' });
            }

            function resetIslands(message) {
                $island.empty()
                    .append($('<option>').val('').text('Select Island'))
                    .prop('disabled', true)
                    .trigger('change');
                $hint.text(message);
            }

            function loadIslands(constituencyId, selectId) {
                if (!constituencyId) {
                    resetIslands('Select a constituency to load its islands.');
                    return;
                }

                resetIslands('Loading islands…');

                $.getJSON('/Voters/GetIslands?constituencyId=' + encodeURIComponent(constituencyId))
                    .done(function (data) {
                        $.each(data, function (i, item) {
                            $island.append($('<option>').val(item.id).text(item.name));
                        });

                        $island.prop('disabled', false);

                        if (selectId) {
                            $island.val(selectId);
                        }

                        $island.trigger('change');

                        $hint.text(data.length
                            ? data.length + ' island(s) available.'
                            : 'No islands found for this constituency.');
                    })
                    .fail(function () {
                        resetIslands('Could not load islands. Please try again.');
                    });
            }

            $constituency.on('change', function () {
                loadIslands($(this).val(), null);
            });

            // After a failed post-back, reload the islands and keep the chosen one
            loadIslands($constituency.val(), preselectedIsland);

            // ---- Support status chips ----
            var $status = $('#h28StatusSelect');
            var $chips = $('#h28StatusChips .ui-chip');

            function syncChips() {
                $chips.each(function () {
                    var selected = $(this).data('v') === $status.val();
                    $(this).toggleClass('active', selected).attr('aria-checked', selected);
                });
            }

            $chips.on('click', function () {
                $status.val($(this).data('v'));
                syncChips();
            });

            $chips.on('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    $(this).trigger('click');
                }
            });

            syncChips();

            // ---- National ID: store in upper case ----
            $('#h28NationalId').on('input', function () {
                var pos = this.selectionStart;
                this.value = this.value.toUpperCase();
                this.setSelectionRange(pos, pos);
            });

            // ---- National ID: live duplicate check ----
            var $nid = $('#h28NationalId');
            var $nidStatus = $('#h28NidStatus');
            var checkUrl = '@Url.Action("CheckNationalId", "Voters")';
            var nidTimer = null;
            var nidRequest = null;
            var nidDuplicate = false;
            var lastChecked = '';

            function setNidStatus(kind, html) {
                $nidStatus.removeClass('is-error is-ok is-muted').addClass(kind ? 'is-' + kind : '').html(html || '');
                $nid.toggleClass('input-validation-error', kind === 'error')
                    .attr('aria-invalid', kind === 'error' ? 'true' : null);
            }

            function escapeHtml(text) {
                return $('<div>').text(text).html();
            }

            function checkNationalId() {
                var value = $.trim($nid.val());

                if (value === lastChecked) return;
                lastChecked = value;

                if (nidRequest) nidRequest.abort();

                if (value.length < 5) {
                    nidDuplicate = false;
                    setNidStatus('', '');
                    return;
                }

                setNidStatus('muted', 'Checking…');

                nidRequest = $.getJSON(checkUrl, { nationalId: value })
                    .done(function (data) {
                        nidDuplicate = !!data.exists;

                        if (!data.exists) {
                            setNidStatus('ok', '✓ Not registered yet');
                            return;
                        }

                        var html = 'This National ID is already registered';
                        if (data.fullName) {
                            html += ' to <strong>' + escapeHtml(data.fullName) + '</strong>.';
                            if (data.profileUrl) {
                                html += ' <a href="' + data.profileUrl + '">View profile</a>';
                            }
                        } else {
                            html += '.';
                        }

                        setNidStatus('error', html);
                    })
                    .fail(function (xhr, status) {
                        if (status === 'abort') return;
                        nidDuplicate = false;
                        lastChecked = '';
                        setNidStatus('', '');   // the server still checks when saving
                    });
            }

            $nid.on('input', function () {
                clearTimeout(nidTimer);
                nidTimer = setTimeout(checkNationalId, 450);
            });

            $nid.on('blur', checkNationalId);

            // Don't submit a known duplicate.
            $nid.closest('form').on('submit', function (e) {
                if (nidDuplicate) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    $nid.trigger('focus');
                }
            });

            if ($.trim($nid.val()).length >= 5) checkNationalId();
        });
    </script>
}
