@model HR28.Web.Models.VoterCreateViewModel

@{
bool isSuperAdmin = false;

if (ViewBag.IsSuperAdmin != null)
{
    isSuperAdmin = (bool)ViewBag.IsSuperAdmin;
}

}

<div class="container mt-4">

    <h2>Edit Voter</h2>

    <form asp-action="Edit" method="post">
<input asp-for="Voter.Id"
       type="hidden" />


        <div class="mb-3">
            <label class="form-label">National ID</label>
            <input asp-for="Voter.NationalId" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Full Name</label>
            <input asp-for="Voter.FullName" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Mobile Number</label>
            <input asp-for="Voter.MobileNumber" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Address</label>
            <textarea asp-for="Voter.Address" class="form-control"></textarea>
        </div>

<div class="mb-3">
    <label class="form-label">Constituency</label>

    <select asp-for="Voter.ConstituencyId"
            id="ConstituencyDropdown"
            class="form-select"
            disabled="@(!isSuperAdmin)">

        <option value="">
            Select Constituency
        </option>

        @foreach (var item in Model.Constituencies)
        {
            if (item.Id == Model.Voter.ConstituencyId)
            {
                <option value="@item.Id" selected>
                    @item.Name
                </option>
            }
            else
            {
                <option value="@item.Id">
                    @item.Name
                </option>
            }
        }

    </select>

    @if (!isSuperAdmin)
    {
        <input type="hidden"
               asp-for="Voter.ConstituencyId" />
    }
</div>
<div class="mb-3">
    <label class="form-label">Island</label>

    <select asp-for="Voter.IslandId"
            id="IslandDropdown"
            class="form-select"
            disabled="@(!isSuperAdmin)">

        <option value="">
            Select Island
        </option>

        @foreach (var item in Model.Islands)
        {
            if (item.Id == Model.Voter.IslandId)
            {
                <option value="@item.Id" selected>
                    @item.Name
                </option>
            }
            else
            {
                <option value="@item.Id">
                    @item.Name
                </option>
            }
        }

    </select>

    @if (!isSuperAdmin)
    {
        <input type="hidden"
               asp-for="Voter.IslandId" />
    }

    <span id="islandDebug"></span>
</div>



        <div class="mb-3">
            <label class="form-label">Support Status</label>
            <select asp-for="Voter.SupportStatus" class="form-select">
                <option value="Undecided">Undecided</option>
                <option value="Supporter">Supporter</option>
                <option value="Opponent">Opponent</option>
                <option value="Neutral">Neutral</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Remarks</label>
            <textarea asp-for="Voter.Remarks" class="form-control"></textarea>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Update Voter
        </button>

    </form>



@section Scripts
{
    <script>

        $(document).ready(function () {
if ($('#IslandDropdown option').length <= 1)
{
    $('#IslandDropdown').empty();

    $('#IslandDropdown')
        .append(
            $('<option>')
                .text('Select Island')
                .val('')
        );
}

$('#IslandDropdown').change(function () {
    $('#islandDebug').text(
        'Selected Island ID = ' +
        $(this).val()
    );
});



            $('#ConstituencyDropdown').change(function () {

                var constituencyId =
                    $(this).val();

                $('#IslandDropdown')
                    .empty();

                $.getJSON(
                    '/Voters/GetIslands?constituencyId=' +
                    constituencyId,

                    function (data) {

                        $('#IslandDropdown')
                            .append(
                                $('<option>')
                                    .text('Select Island')
                                    .val('')
                            );

                        $.each(
                            data,
                            function (i, item) {

                                $('#IslandDropdown')
                                    .append(
                                        $('<option>')
                                            .text(item.name)
                                            .val(item.id)
                                    );
                            });
                       if (!$('#IslandDropdown').is(':disabled'))
{
    $('#IslandDropdown').prop('disabled', false);
}

                        $('#IslandDropdown')
                            .trigger('change');

                    });
            });

        });

    </script>
}

</div>