@model HR28.Web.Models.VoterCreateViewModel

@{
    var canStatus = HR28.Web.Services.Hr28Permissions.Has(Context.Session, HR28.Web.Services.Hr28Permissions.VotersStatus);
    ViewData["Title"] = "Edit Voter";

    bool isSuperAdmin = false;

    if (ViewBag.IsSuperAdmin != null)
    {
        isSuperAdmin = (bool)ViewBag.IsSuperAdmin;
    }

    var voterName = string.IsNullOrWhiteSpace(Model.Voter.FullName) ? "Voter" : Model.Voter.FullName;
}

<div class="ui-page is-narrow">

    <header class="ui-head">
        <div class="ui-head-main">
            <span class="ui-head-icon is-blue"><partial name="_Icon" model='"edit"' /></span>
            <div>
                <nav class="ui-crumb" aria-label="Breadcrumb">
                    <a asp-action="Index">Voters</a> <span aria-hidden="true">/</span>
                    <a asp-action="Profile" asp-route-id="@Model.Voter.Id">@voterName</a> <span aria-hidden="true">/</span>
                    <span>Edit</span>
                </nav>
                <h1 class="ui-title">Edit Voter</h1>
                <p class="ui-sub">Update this voter's details and current support status.</p>
            </div>
        </div>
    </header>

    <section class="ui-card ui-card-lg">

        <form asp-action="Edit" method="post">

            <input asp-for="Voter.Id" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="ui-summary"></div>

            <!-- 1. IDENTITY -->
            <div class="ui-section">
                <div class="ui-section-head">
                    <span class="ui-step">1</span>
                    <div>
                        <div class="ui-section-title">Identity</div>
                        <div class="ui-section-sub">Who the voter is and how to reach them</div>
                    </div>
                </div>

                <div class="ui-grid-2">
                    <div class="ui-field">
                        <label asp-for="Voter.NationalId" class="ui-label">National ID</label>
                        <input asp-for="Voter.NationalId" class="ui-input ui-upper" autocomplete="off" maxlength="7" />
                        <span asp-validation-for="Voter.NationalId" class="ui-error"></span>
                    </div>

                    <div class="ui-field">
                        <label asp-for="Voter.MobileNumber" class="ui-label">
                            Mobile number <span class="ui-optional">(optional)</span>
                        </label>
                        <input asp-for="Voter.MobileNumber"
                               class="ui-input h28-digits-only"
                               inputmode="numeric"
                               maxlength="7"
                               pattern="\d{7}"
                               title="7 digits, e.g. 7771234"
                               placeholder="7XXXXXX" />
                        <span asp-validation-for="Voter.MobileNumber" class="ui-error"></span>
                    </div>

                    <div class="ui-field ui-full">
                        <label asp-for="Voter.FullName" class="ui-label">Full name</label>
                        <input asp-for="Voter.FullName" class="ui-input" />
                        <span asp-validation-for="Voter.FullName" class="ui-error"></span>
                    </div>

                    <div class="ui-field">
                        <label asp-for="Voter.Gender" class="ui-label">Gender <span class="ui-optional">(optional)</span></label>
                        <select asp-for="Voter.Gender" class="ui-select">
                            <option value="">Not recorded</option>
                            <option value="M">Male</option>
                            <option value="F">Female</option>
                        </select>
                        <span asp-validation-for="Voter.Gender" class="ui-error"></span>
                    </div>

                    <div class="ui-field">
                        <label asp-for="Voter.DateOfBirth" class="ui-label">Date of birth <span class="ui-optional">(optional)</span></label>
                        <input asp-for="Voter.DateOfBirth" type="date" class="ui-input" min="1900-01-01" max="@DateOnly.FromDateTime(HR28.Web.Services.Hr28Time.Now).ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Voter.DateOfBirth" class="ui-error"></span>
                    </div>
                </div>
            </div>

            <!-- 2. LOCATION -->
            <div class="ui-section">
                <div class="ui-section-head">
                    <span class="ui-step">2</span>
                    <div>
                        <div class="ui-section-title">Location</div>
                        <div class="ui-section-sub">
                            @(isSuperAdmin
                                ? "Choose the constituency first; islands load automatically"
                                : "Only an Administrator can move a voter to another constituency or island")
                        </div>
                    </div>
                </div>

                <div class="ui-grid-2">
                    <div class="ui-field">
                        <label for="ConstituencyDropdown" class="ui-label">Constituency</label>

                        <select asp-for="Voter.ConstituencyId"
                                id="ConstituencyDropdown"
                                class="ui-select"
                                disabled="@(!isSuperAdmin)">

                            <option value="">Select Constituency</option>

                            @foreach (var item in Model.Constituencies)
                            {
                                if (item.Id == Model.Voter.ConstituencyId)
                                {
                                    <option value="@item.Id" selected>@item.Name</option>
                                }
                                else
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            }
                        </select>

                        @if (!isSuperAdmin)
                        {
                            <input type="hidden" asp-for="Voter.ConstituencyId" />
                        }

                        <span asp-validation-for="Voter.ConstituencyId" class="ui-error"></span>
                    </div>

                    <div class="ui-field">
                        <label for="IslandDropdown" class="ui-label">Island</label>

                        <select asp-for="Voter.IslandId"
                                id="IslandDropdown"
                                class="ui-select"
                                disabled="@(!isSuperAdmin)">

                            <option value="">Select Island</option>

                            @foreach (var item in Model.Islands)
                            {
                                if (item.Id == Model.Voter.IslandId)
                                {
                                    <option value="@item.Id" selected>@item.Name</option>
                                }
                                else
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            }
                        </select>

                        @if (!isSuperAdmin)
                        {
                            <input type="hidden" asp-for="Voter.IslandId" />
                        }

                        <span asp-validation-for="Voter.IslandId" class="ui-error"></span>
                    </div>

                    <div class="ui-field ui-full">
                        <label asp-for="Voter.Address" class="ui-label">Address</label>
                        <textarea asp-for="Voter.Address" class="ui-textarea"></textarea>
                        <span asp-validation-for="Voter.Address" class="ui-error"></span>
                    </div>
                </div>
            </div>

            <!-- 3. CAMPAIGN -->
            <div class="ui-section">
                <div class="ui-section-head">
                    <span class="ui-step">3</span>
                    <div>
                        <div class="ui-section-title">Campaign</div>
                        <div class="ui-section-sub">Political party, support status and any notes</div>
                    </div>
                </div>

                <div class="ui-field">
                    <label asp-for="Voter.PoliticalPartyId" class="ui-label">Political party</label>
                    <select asp-for="Voter.PoliticalPartyId" class="ui-select">
                        <option value="">Not known</option>
                        @foreach (var party in Model.Parties)
                        {
                            <option value="@party.Id" selected="@(party.Id == Model.Voter.PoliticalPartyId)">@party.Label</option>
                        }
                    </select>
                    <div class="ui-hint">Leave as "Not known" unless you are sure.</div>
                    <span asp-validation-for="Voter.PoliticalPartyId" class="ui-error"></span>
                </div>

                @* Only "Change support status" may choose it (the API checks this too). *@
                @if (canStatus)
                {
                <div class="ui-field">
                    <span class="ui-label" id="h28StatusLabel">Support status</span>

                    <div class="ui-chips" id="h28StatusChips" role="radiogroup" aria-labelledby="h28StatusLabel">
                        <span class="ui-chip is-amber" data-v="Undecided" role="radio" tabindex="0">Undecided</span>
                        <span class="ui-chip is-green" data-v="Supporter" role="radio" tabindex="0">Supporter</span>
                        <span class="ui-chip is-red" data-v="Opponent" role="radio" tabindex="0">Opponent</span>
                        <span class="ui-chip is-blue" data-v="Neutral" role="radio" tabindex="0">Neutral</span>
                    </div>

                    <!-- The real field that gets posted; the chips just set it -->
                    <select asp-for="Voter.SupportStatus" id="h28StatusSelect" class="ui-hidden" aria-hidden="true" tabindex="-1">
                        <option value="Undecided">Undecided</option>
                        <option value="Supporter">Supporter</option>
                        <option value="Opponent">Opponent</option>
                        <option value="Neutral">Neutral</option>
                    </select>

                    <span asp-validation-for="Voter.SupportStatus" class="ui-error"></span>
                </div>
                }
                else
                {
                <div class="ui-field">
                    <span class="ui-label">Support status</span>
                    <div><partial name="_StatusPill" model="Model.Voter.SupportStatus" /></div>
                    <input type="hidden" asp-for="Voter.SupportStatus" />
                    <div class="ui-hint">Changing the status needs the "Change support status" right.</div>
                </div>
                }

                <div class="ui-field">
                    <label asp-for="Voter.Remarks" class="ui-label">
                        Remarks <span class="ui-optional">(optional)</span>
                    </label>
                    <textarea asp-for="Voter.Remarks" class="ui-textarea"></textarea>
                    <span asp-validation-for="Voter.Remarks" class="ui-error"></span>
                </div>
            </div>

            <div class="ui-form-actions">
                <button type="submit" class="ui-btn ui-btn-primary">
                    <partial name="_Icon" model='"check"' />
                    Update voter
                </button>

                <a asp-action="Profile"
                   asp-route-id="@Model.Voter.Id"
                   class="ui-btn ui-btn-secondary">
                    Cancel
                </a>
            </div>

        </form>

    </section>

</div>

@section Scripts
{
    <script>
        $(function () {
            var $constituency = $('#ConstituencyDropdown');
            var $island = $('#IslandDropdown');

            if ($island.find('option').length <= 1) {
                $island.empty().append($('<option>').text('Select Island').val(''));
            }

            $constituency.on('change', function () {
                var constituencyId = $(this).val();

                $island.empty();

                $.getJSON('/Voters/GetIslands?constituencyId=' + encodeURIComponent(constituencyId), function (data) {
                    $island.append($('<option>').text('Select Island').val(''));

                    $.each(data, function (i, item) {
                        $island.append($('<option>').text(item.name).val(item.id));
                    });

                    $island.trigger('change');
                });
            });

            // ---- Support status chips ----
            var $status = $('#h28StatusSelect');
            var $chips = $('#h28StatusChips .ui-chip');

            function syncChips() {
                $chips.each(function () {
                    var selected = $(this).data('v') === $status.val();
                    $(this).toggleClass('active', selected).attr('aria-checked', selected);
                });
            }

            $chips.on('click', function () {
                $status.val($(this).data('v'));
                syncChips();
            });

            $chips.on('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    $(this).trigger('click');
                }
            });

            syncChips();
        });
    </script>
}
