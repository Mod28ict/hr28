@model HR28.Web.Models.VoterProfileDto

@{
    ViewData["Title"] = "Voter Profile";

    var voter = Model?.Voter;
    var voterId = voter?.Id;

    var influencers = Model?.Influencers ?? new List<HR28.Web.Models.VoterInfluencerDto>();
    var encounters = Model?.Encounters ?? new List<HR28.Web.Models.EncounterDto>();
    var pledges = Model?.Pledges ?? new List<HR28.Web.Models.PledgeDto>();

    var name = string.IsNullOrWhiteSpace(voter?.FullName) ? "Unnamed voter" : voter!.FullName;
    var initials = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    var mobile = voter?.MobileNumber;

    // Each section and button follows the person's rights; the API checks them again
    // (a section without its view right comes back empty from the API too).
    bool Can(string right) => HR28.Web.Services.Hr28Permissions.Has(Context.Session, right);

    var canEditVoter = Can(HR28.Web.Services.Hr28Permissions.VotersEdit);
    var canDeleteVoter = Can(HR28.Web.Services.Hr28Permissions.VotersDelete);

    var showInfluencers = Can(HR28.Web.Services.Hr28Permissions.InfluencersView);
    var canLinkInfluencers = Can(HR28.Web.Services.Hr28Permissions.InfluencersLink);

    var showEncounters = Can(HR28.Web.Services.Hr28Permissions.EncountersView);
    var canAddEncounters = Can(HR28.Web.Services.Hr28Permissions.EncountersAdd);
    var canEditEncounters = Can(HR28.Web.Services.Hr28Permissions.EncountersEdit);
    var canDeleteEncounters = Can(HR28.Web.Services.Hr28Permissions.EncountersDelete);

    var showPledges = Can(HR28.Web.Services.Hr28Permissions.PledgesView);
    var canAddPledges = Can(HR28.Web.Services.Hr28Permissions.PledgesAdd);
    var canEditPledges = Can(HR28.Web.Services.Hr28Permissions.PledgesEdit);
    var canDeletePledges = Can(HR28.Web.Services.Hr28Permissions.PledgesDelete);

    var statCount = new[] { showInfluencers, showEncounters, showPledges }.Count(x => x);

    // Photo: shown with "View voter photos"; changed with "Add or remove voter photos".
    var showPhoto = Model?.HasPhoto == true && Can(HR28.Web.Services.Hr28Permissions.VotersPhotoView);
    var canEditPhoto = Can(HR28.Web.Services.Hr28Permissions.VotersPhotoEdit);

    string OrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}

<div class="ui-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="ui-alert is-green" role="status">
            <partial name="_Icon" model='"check-circle"' />
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <header class="ui-head">
        <div class="ui-head-main">
            @if (showPhoto)
            {
                <img src="@Url.Action("Photo", new { id = voterId })" alt="Photo of @name" class="ui-voter-photo" />
            }
            else
            {
                <span class="ui-avatar ui-avatar-lg" aria-hidden="true">@initials</span>
            }
            <div>
                <nav class="ui-crumb" aria-label="Breadcrumb">
                    <a asp-action="Index">Voters</a> <span aria-hidden="true">/</span> <span>Profile</span>
                </nav>
                <h1 class="ui-title">@name</h1>
                <p class="ui-sub">
                    <span class="ui-num">@voter?.NationalId</span>
                    @if (!string.IsNullOrWhiteSpace(voter?.ConstituencyName))
                    {
                        <text> · @voter.ConstituencyName</text>
                    }
                </p>
            </div>
        </div>

        <div class="ui-head-actions">
            <partial name="_StatusPill" model="voter?.SupportStatus" />
            @if (canAddEncounters && !showEncounters)
            {
                @* Without the encounter history the main job here is adding one. *@
                <a asp-controller="Encounters" asp-action="Create" asp-route-voterId="@voterId" class="ui-btn ui-btn-primary">
                    <partial name="_Icon" model='"plus"' />
                    Add encounter
                </a>
            }
            @if (canEditVoter)
            {
                <a asp-action="Edit" asp-route-id="@voterId" class="ui-btn ui-btn-secondary">
                    <partial name="_Icon" model='"edit"' />
                    Edit voter
                </a>
            }
            @if (canDeleteVoter)
            {
                <form asp-action="Delete" asp-route-id="@voterId" method="post" class="h28-confirm"
                      data-confirm="Permanently delete @name with all their encounters and pledges? This cannot be undone.">
                    <button type="submit" class="ui-btn ui-btn-ghost ui-btn-danger">
                        <partial name="_Icon" model='"trash"' />
                        Delete
                    </button>
                </form>
            }
        </div>
    </header>

    <!-- DETAILS -->
    <section class="ui-card">
        <dl class="ui-details">
            <div>
                <dt>Mobile</dt>
                <dd>
                    @if (!string.IsNullOrWhiteSpace(mobile))
                    {
                        <a href="tel:@mobile" class="ui-link ui-num">@mobile</a>
                    }
                    else
                    {
                        <span class="ui-faint">Not recorded</span>
                    }
                </dd>
            </div>
            <div>
                <dt>Address</dt>
                <dd>@OrDash(voter?.Address)</dd>
            </div>
            <div>
                <dt>Constituency</dt>
                <dd>@OrDash(voter?.ConstituencyName)</dd>
            </div>
            <div>
                <dt>Island</dt>
                <dd>@OrDash(voter?.IslandName)</dd>
            </div>
            <div>
                <dt>Gender</dt>
                <dd>@OrDash(voter?.GenderLabel)</dd>
            </div>
            <div>
                <dt>Date of birth</dt>
                <dd>
                    @if (voter?.DateOfBirth is { } dob)
                    {
                        @($"{dob:dd MMM yyyy} ({voter.Age} years)")
                    }
                    else
                    {
                        <span class="ui-faint">Not recorded</span>
                    }
                </dd>
            </div>
            <div>
                <dt>Political party</dt>
                <dd>
                    @if (!string.IsNullOrWhiteSpace(voter?.PartyName))
                    {
                        @($"{voter.PartyName} ({voter.PartyShortName})")
                    }
                    else
                    {
                        <span class="ui-faint">Not known</span>
                    }
                </dd>
            </div>
        </dl>

        @if (canEditPhoto)
        {
            <div class="ui-photo-tools">
                <form asp-action="UploadPhoto" asp-route-id="@voterId" method="post" enctype="multipart/form-data" class="ui-photo-upload">
                    <label for="voterPhoto" class="ui-label">@(Model?.HasPhoto == true ? "Replace photo" : "Add a photo") <span class="ui-optional">(optional)</span></label>
                    <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                        <input id="voterPhoto" name="photo" type="file" accept="image/jpeg,image/png" class="ui-input" style="max-width: 320px;" required />
                        <button type="submit" class="ui-btn ui-btn-secondary ui-btn-sm">
                            <partial name="_Icon" model='"upload"' />
                            Upload
                        </button>
                    </div>
                    <div class="ui-hint">JPG or PNG, up to 2 MB. Location details inside the photo are removed when it is saved.</div>
                </form>

                @if (Model?.HasPhoto == true)
                {
                    <form asp-action="RemovePhoto" asp-route-id="@voterId" method="post" class="h28-confirm"
                          data-confirm="Remove the photo of @name?">
                        <button type="submit" class="ui-btn ui-btn-ghost ui-btn-sm ui-btn-danger">
                            <partial name="_Icon" model='"trash"' />
                            Remove photo
                        </button>
                    </form>
                }
            </div>
        }

        <div class="ui-note is-muted" style="margin: 18px 0 0;">
            <partial name="_Icon" model='"file"' />
            <div>
                <strong>Remarks</strong>
                @(string.IsNullOrWhiteSpace(voter?.Remarks) ? "No remarks added." : voter!.Remarks)
            </div>
        </div>
    </section>

    <!-- COUNTS (only for the sections this person may see) -->
    @if (statCount > 0)
    {
    <section class="ui-stats is-@statCount">
        @if (showInfluencers)
        {
        <div class="ui-stat is-violet">
            <span class="ui-stat-icon"><partial name="_Icon" model='"star"' /></span>
            <div>
                <div class="ui-stat-label">Influencers</div>
                <div class="ui-stat-value">@influencers.Count</div>
            </div>
        </div>
        }
        @if (showEncounters)
        {
        <div class="ui-stat is-green">
            <span class="ui-stat-icon"><partial name="_Icon" model='"message"' /></span>
            <div>
                <div class="ui-stat-label">Encounters</div>
                <div class="ui-stat-value">@encounters.Count</div>
            </div>
        </div>
        }
        @if (showPledges)
        {
        <div class="ui-stat is-amber">
            <span class="ui-stat-icon"><partial name="_Icon" model='"handshake"' /></span>
            <div>
                <div class="ui-stat-label">Pledges</div>
                <div class="ui-stat-value">@pledges.Count</div>
            </div>
        </div>
        }
    </section>
    }

    <!-- INFLUENCERS -->
    @if (showInfluencers)
    {
    <section class="ui-card">
        <div class="ui-card-head">
            <h2>Influencers <span class="ui-count is-violet">@influencers.Count</span></h2>

            @if (canLinkInfluencers)
            {
                <a asp-controller="Influencers"
                   asp-action="Link"
                   asp-route-voterId="@voterId"
                   class="ui-btn ui-btn-soft is-violet ui-btn-sm">
                    <partial name="_Icon" model='"link"' />
                    Link influencer
                </a>
            }
        </div>

        @if (!influencers.Any())
        {
            <div class="ui-empty">No influencers linked yet.</div>
        }
        else
        {
            <div class="ui-table-wrap">
                <table class="ui-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>National ID</th>
                            <th>Contact</th>
                            <th>Relationship</th>
                            <th><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var influencer in influencers)
                        {
                            <tr>
                                <td class="ui-strong">@influencer.FullName</td>
                                <td class="ui-num ui-muted">@influencer.NationalId</td>
                                <td class="ui-num">@OrDash(influencer.ContactNumber)</td>
                                <td><span class="ui-tag">@influencer.RelationshipType</span></td>
                                <td class="is-right">
                                    @if (canLinkInfluencers)
                                    {
                                        <a asp-controller="Influencers"
                                           asp-action="EditRelationship"
                                           asp-route-voterId="@voterId"
                                           asp-route-influencerId="@influencer.InfluencerId"
                                           class="ui-btn ui-btn-secondary ui-btn-sm">
                                            Edit
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
    }

    <!-- ENCOUNTERS -->
    @if (showEncounters)
    {
    <section class="ui-card">
        <div class="ui-card-head">
            <h2>Encounters <span class="ui-count is-green">@encounters.Count</span></h2>

            @if (canAddEncounters)
            {
                <a asp-controller="Encounters"
                   asp-action="Create"
                   asp-route-voterId="@voterId"
                   class="ui-btn ui-btn-soft is-green ui-btn-sm">
                    <partial name="_Icon" model='"plus"' />
                    Add encounter
                </a>
            }
        </div>

        @if (!encounters.Any())
        {
            <div class="ui-empty">No encounters recorded yet.</div>
        }
        else
        {
            <div class="ui-table-wrap">
                <table class="ui-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Outcome</th>
                            <th>Response</th>
                            <th>Notes</th>
                            @if (canEditEncounters || canDeleteEncounters)
                            {
                                <th><span class="visually-hidden">Actions</span></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var encounter in encounters.OrderByDescending(x => x.EncounterDate))
                        {
                            <tr>
                                <td class="ui-strong ui-num" style="white-space: nowrap;">@encounter.EncounterDate.ToString("dd MMM yyyy")</td>
                                <td><span class="ui-tag">@encounter.EncounterType</span></td>
                                <td><span class="ui-tag">@encounter.Outcome</span></td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(encounter.Response))
                                    {
                                        <span class="ui-faint">—</span>
                                    }
                                    else
                                    {
                                        <span class="ui-pill is-filled @HR28.Web.Models.EncounterListFilterModel.ToneOf(encounter.Response)">@encounter.Response</span>
                                    }
                                </td>
                                <td class="ui-muted">@encounter.Notes</td>
                                @if (canEditEncounters || canDeleteEncounters)
                                {
                                    <td class="is-right" style="white-space: nowrap;">
                                        @if (canEditEncounters)
                                        {
                                            <a asp-controller="Encounters"
                                               asp-action="Edit"
                                               asp-route-id="@encounter.Id"
                                               class="ui-btn ui-btn-secondary ui-btn-sm">
                                                <partial name="_Icon" model='"edit"' />
                                                Edit
                                            </a>
                                        }
                                        @if (canDeleteEncounters)
                                        {
                                            <form asp-controller="Encounters" asp-action="Delete" asp-route-id="@encounter.Id" method="post"
                                                  class="h28-confirm" style="display: inline;"
                                                  data-confirm="Permanently delete this encounter (@encounter.EncounterDate.ToString("dd MMM yyyy"))? This cannot be undone.">
                                                <input type="hidden" name="voterId" value="@voterId" />
                                                <button type="submit" class="ui-btn ui-btn-ghost ui-btn-sm ui-btn-danger" aria-label="Delete encounter" title="Delete">
                                                    <partial name="_Icon" model='"trash"' />
                                                </button>
                                            </form>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
    }

    <!-- PLEDGES -->
    @if (showPledges)
    {
    <section class="ui-card">
        <div class="ui-card-head">
            <h2>Pledges <span class="ui-count is-amber">@pledges.Count</span></h2>

            @if (canAddPledges)
            {
                <a asp-controller="Pledges"
                   asp-action="Create"
                   asp-route-voterId="@voterId"
                   class="ui-btn ui-btn-soft is-amber ui-btn-sm">
                    <partial name="_Icon" model='"plus"' />
                    Add pledge
                </a>
            }
        </div>

        @if (!pledges.Any())
        {
            <div class="ui-empty">No pledges recorded yet.</div>
        }
        else
        {
            <div class="ui-table-wrap">
                <table class="ui-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Pledge date</th>
                            <th>Due date</th>
                            <th><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pledge in pledges.OrderByDescending(x => x.PledgeDate))
                        {
                            <tr>
                                <td class="ui-strong">@pledge.Title</td>
                                <td class="ui-muted">
                                    @(string.IsNullOrWhiteSpace(pledge.Description) ? "—" : pledge.Description)
                                    @if (!string.IsNullOrWhiteSpace(pledge.ResolutionNotes))
                                    {
                                        <div style="margin-top: 4px; font-size: 12px;"><strong>Update:</strong> @pledge.ResolutionNotes</div>
                                    }
                                </td>
                                <td>
                                    @{
                                        var tone = HR28.Web.Models.UpdatePledgeViewModel.Statuses
                                            .FirstOrDefault(s => string.Equals(s.Value, pledge.Status, StringComparison.OrdinalIgnoreCase))
                                            .Tone ?? "is-muted";
                                    }
                                    <span class="ui-pill @tone">@pledge.Status</span>
                                </td>
                                <td class="ui-num" style="white-space: nowrap;">@HR28.Web.Services.Hr28Time.FromUtc(pledge.PledgeDate).ToString("dd MMM yyyy")</td>
                                <td class="ui-num" style="white-space: nowrap;">@(pledge.DueDate.HasValue ? pledge.DueDate.Value.ToString("dd MMM yyyy") : "—")</td>
                                <td class="is-right" style="white-space: nowrap;">
                                    @if (canEditPledges)
                                    {
                                        <a asp-controller="Pledges"
                                           asp-action="Update"
                                           asp-route-id="@pledge.Id"
                                           class="ui-btn ui-btn-secondary ui-btn-sm">
                                            Update
                                        </a>
                                    }
                                    @if (canDeletePledges)
                                    {
                                        <form asp-controller="Pledges" asp-action="Delete" asp-route-id="@pledge.Id" method="post"
                                              class="h28-confirm" style="display: inline;"
                                              data-confirm="Permanently delete the pledge &quot;@pledge.Title&quot;? This cannot be undone.">
                                            <input type="hidden" name="voterId" value="@voterId" />
                                            <button type="submit" class="ui-btn ui-btn-ghost ui-btn-sm ui-btn-danger" aria-label="Delete pledge" title="Delete">
                                                <partial name="_Icon" model='"trash"' />
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
    }

</div>

@section Scripts
{
    <script>
        // Permanent deletes ask first (the text comes from data-confirm, never from script).
        document.querySelectorAll('form.h28-confirm').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                if (!window.confirm(form.dataset.confirm)) e.preventDefault();
            });
        });
    </script>
}
