@model HR28.Web.Models.LinkInfluencerViewModel

@{
    ViewData["Title"] = "Link Influencer";
}

<div class="ui-page is-narrow">

    <header class="ui-head">
        <div class="ui-head-main">
            <span class="ui-head-icon is-violet"><partial name="_Icon" model='"link"' /></span>
            <div>
                <nav class="ui-crumb" aria-label="Breadcrumb">
                    <a asp-controller="Voters" asp-action="Profile" asp-route-id="@Model.Link.VoterId">Voter profile</a>
                    <span aria-hidden="true">/</span> <span>Link influencer</span>
                </nav>
                <h1 class="ui-title">Link Influencer</h1>
                <p class="ui-sub">Select an existing influencer and record their relationship to this voter.</p>
            </div>
        </div>
    </header>

    <section class="ui-card ui-card-lg">

        <form asp-action="Link" method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Link.VoterId" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="ui-summary"></div>

            <div class="ui-field">
                <div class="ui-section-head" style="margin-bottom: 10px;">
                    <span class="ui-step">1</span>
                    <label for="InfluencerDropdown" class="ui-section-title" style="margin: 0;">Choose influencer</label>
                </div>

                <select asp-for="Link.InfluencerId"
                        id="InfluencerDropdown"
                        class="ui-select">
                    <option value="">Select Influencer</option>

                    @foreach (var influencer in Model.Influencers)
                    {
                        <option value="@influencer.Id">
                            @influencer.FullName (@influencer.NationalId)
                        </option>
                    }
                </select>

                <div class="ui-hint">Type a name or National ID to search.</div>

                <span asp-validation-for="Link.InfluencerId" class="ui-error"></span>
            </div>

            <div class="ui-field">
                <div class="ui-section-head" style="margin-bottom: 10px;">
                    <span class="ui-step">2</span>
                    <label asp-for="Link.RelationshipType" class="ui-section-title" style="margin: 0;">Relationship to voter</label>
                </div>

                <select asp-for="Link.RelationshipType" class="ui-select">
                    <option value="">Select Relationship</option>
                    <option value="Spouse">Spouse</option>
                    <option value="Parent">Parent</option>
                    <option value="Child">Child</option>
                    <option value="Sibling">Sibling</option>
                    <option value="Relative">Relative</option>
                    <option value="Friend">Friend</option>
                    <option value="Colleague">Colleague</option>
                    <option value="Community Leader">Community Leader</option>
                    <option value="Other">Other</option>
                </select>

                <span asp-validation-for="Link.RelationshipType" class="ui-error"></span>
            </div>

            <div class="ui-form-actions">
                <button type="submit" class="ui-btn ui-btn-primary">
                    <partial name="_Icon" model='"link"' />
                    Link influencer
                </button>

                <a asp-controller="Voters"
                   asp-action="Profile"
                   asp-route-id="@Model.Link.VoterId"
                   class="ui-btn ui-btn-secondary">
                    Cancel
                </a>
            </div>

        </form>

    </section>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {
            var $dd = $('#InfluencerDropdown');

            if (!$dd.length || typeof $.fn.select2 !== 'function') {
                return;
            }

            $dd.select2({
                placeholder: 'Search by influencer name or National ID',
                allowClear: true,
                width: '100%'
            });
        });
    </script>
}
