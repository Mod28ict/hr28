@model HR28.Web.Models.UpdateInfluencerRelationshipDto

@{
    ViewData["Title"] = "Edit Relationship";
}

<div class="ui-page is-narrow">

    <header class="ui-head">
        <div class="ui-head-main">
            <span class="ui-head-icon is-violet"><partial name="_Icon" model='"edit"' /></span>
            <div>
                <nav class="ui-crumb" aria-label="Breadcrumb">
                    <a asp-controller="Voters" asp-action="Profile" asp-route-id="@Model.VoterId">Voter profile</a>
                    <span aria-hidden="true">/</span> <span>Edit relationship</span>
                </nav>
                <h1 class="ui-title">Edit Relationship</h1>
                <p class="ui-sub">Change how this influencer is related to the voter.</p>
            </div>
        </div>
    </header>

    <section class="ui-card ui-card-lg">

        <form asp-action="EditRelationship" method="post">

            <input asp-for="VoterId" type="hidden" />
            <input asp-for="InfluencerId" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="ui-summary"></div>

            <div class="ui-field">
                <label asp-for="RelationshipType" class="ui-label">Relationship type</label>

                <select asp-for="RelationshipType" class="ui-select">
                    <option value="Spouse">Spouse</option>
                    <option value="Parent">Parent</option>
                    <option value="Child">Child</option>
                    <option value="Sibling">Sibling</option>
                    <option value="Relative">Relative</option>
                    <option value="Friend">Friend</option>
                    <option value="Colleague">Colleague</option>
                    <option value="Community Leader">Community Leader</option>
                </select>

                <span asp-validation-for="RelationshipType" class="ui-error"></span>
            </div>

            <div class="ui-form-actions">
                <button type="submit" class="ui-btn ui-btn-primary">
                    <partial name="_Icon" model='"check"' />
                    Save changes
                </button>

                <a asp-controller="Voters"
                   asp-action="Profile"
                   asp-route-id="@Model.VoterId"
                   class="ui-btn ui-btn-secondary">
                    Cancel
                </a>
            </div>

        </form>

    </section>

</div>
