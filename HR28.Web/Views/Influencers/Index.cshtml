@model HR28.Web.Models.PagedResult<HR28.Web.Models.InfluencerDto>
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Influencers";

    var filter = ViewBag.Filter as HR28.Web.Models.InfluencerListFilterModel ?? new HR28.Web.Models.InfluencerListFilterModel();
    var errorMessage = ViewBag.ErrorMessage as string;

    // Page links keep the search and filters.
    Dictionary<string, string> PageRoute(int pageNumber)
    {
        var values = filter.RouteValues();
        values["page"] = pageNumber.ToString();
        return values;
    }

    var role = Context.Session.GetString("UserRole");
    var canManage = HR28.Web.Services.Hr28Permissions.Has(Context.Session, HR28.Web.Services.Hr28Permissions.InfluencersAdd);

    // Rights granted by the Administrator (the API checks them again).
    var canEdit = HR28.Web.Services.Hr28Permissions.Has(Context.Session, HR28.Web.Services.Hr28Permissions.InfluencersEdit);
    var canDelete = HR28.Web.Services.Hr28Permissions.Has(Context.Session, HR28.Web.Services.Hr28Permissions.InfluencersDelete);

    var startRecord = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
    var endRecord = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);

    var firstVisiblePage = Math.Max(1, Model.Page - 2);
    var lastVisiblePage = Math.Min(Model.TotalPages, Model.Page + 2);

    var constituencyCodes = filter.Constituencies.ToDictionary(c => c.Id, c => c.Code);

    string InitialsOf(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    string ConstituencyLabel(HR28.Web.Models.InfluencerDto i) =>
        constituencyCodes.TryGetValue(i.ConstituencyId, out var code) && !string.IsNullOrWhiteSpace(code)
            ? $"{i.ConstituencyName} ({code.Trim()})"
            : i.ConstituencyName;
}

<div class="ui-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="ui-alert is-green" role="status">
            <partial name="_Icon" model='"check-circle"' />
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <header class="ui-head">
        <div class="ui-head-main">
            <span class="ui-head-icon is-violet"><partial name="_Icon" model='"star"' /></span>
            <div>
                <h1 class="ui-title">Influencers</h1>
                <p class="ui-sub">
                    @Model.TotalCount.ToString("N0")
                    @(filter.IsNarrowed
                        ? (Model.TotalCount == 1 ? "influencer matches your search and filters" : "influencers match your search and filters")
                        : (Model.TotalCount == 1 ? "influencer, shared by everyone across all constituencies" : "influencers, shared by everyone across all constituencies"))
                </p>
            </div>
        </div>

        @if (canManage)
        {
            <div class="ui-head-actions">
                <a asp-action="Create" class="ui-btn ui-btn-primary">
                    <partial name="_Icon" model='"plus"' />
                    Add Influencer
                </a>
            </div>
        }
    </header>

    <section class="ui-card">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="ui-alert is-red" role="alert">
                <partial name="_Icon" model='"alert"' />
                <span>@errorMessage</span>
            </div>
        }

        <form asp-action="Index" method="get" role="search">

            <div class="ui-toolbar">
                <div class="ui-search">
                    <partial name="_Icon" model='"search"' />
                    <label for="influencerSearch" class="visually-hidden">Search influencers</label>
                    <input type="search"
                           id="influencerSearch"
                           name="searchTerm"
                           value="@filter.SearchTerm"
                           maxlength="100"
                           class="ui-input"
                           placeholder="Search by name, National ID, phone or island" />
                </div>

                <button type="submit" class="ui-btn ui-btn-primary">Search</button>

                <label for="influencerPageSize" class="visually-hidden">Rows per page</label>
                <select name="pageSize"
                        id="influencerPageSize"
                        class="ui-select ui-select-auto"
                        onchange="this.form.requestSubmit()">
                    @foreach (var size in new[] { 10, 20, 50, 100 })
                    {
                        <option value="@size" selected="@(filter.PageSize == size)">@size per page</option>
                    }
                </select>
            </div>

            <div class="ui-filter-row">
                <div class="ui-filter">
                    <label for="filterConstituency" class="ui-label">Constituency</label>
                    <select id="filterConstituency" name="constituencyId" class="ui-select">
                        <option value="">All constituencies</option>
                        @foreach (var c in filter.Constituencies)
                        {
                            <option value="@c.Id" selected="@(filter.ConstituencyId == c.Id)">@HR28.Web.Models.VoterListFilterModel.Label(c)</option>
                        }
                    </select>
                </div>

                <div class="ui-filter">
                    <label for="filterIsland" class="ui-label">Island</label>
                    <select id="filterIsland"
                            name="islandId"
                            class="ui-select"
                            data-islands-url="@Url.Action("Islands", "Influencers")"
                            disabled="@(!filter.ConstituencyId.HasValue)">
                        <option value="">@(filter.ConstituencyId.HasValue ? "All islands" : "Choose a constituency first")</option>
                        @foreach (var i in filter.Islands)
                        {
                            <option value="@i.Id" selected="@(filter.IslandId == i.Id)">@i.Name</option>
                        }
                    </select>
                </div>

                <div class="ui-filter">
                    <label for="filterCategory" class="ui-label">Category</label>
                    <select id="filterCategory" name="category" class="ui-select">
                        <option value="">All categories</option>
                        @foreach (var cat in filter.Categories)
                        {
                            <option value="@cat.Id" selected="@(filter.CategoryId == cat.Id)">@cat.Name</option>
                        }
                        <option value="@HR28.Web.Models.InfluencerListFilterModel.NoCategoryValue" selected="@filter.NoCategory">No category</option>
                    </select>
                </div>

                <div class="ui-filter ui-filter-actions">
                    <button type="submit" class="ui-btn ui-btn-secondary">Apply filters</button>
                    @if (filter.IsNarrowed)
                    {
                        <a asp-action="Index" asp-route-pageSize="@filter.PageSize" class="ui-btn ui-btn-ghost">Clear all</a>
                    }
                </div>
            </div>

        </form>

        @if (!Model.Items.Any())
        {
            <div class="ui-empty">
                <partial name="_Icon" model='@(filter.IsNarrowed ? "search" : "star")' />
                @(filter.IsNarrowed
                    ? "No influencers match your search and filters."
                    : "No influencers recorded yet.")
                @if (canManage && !filter.IsNarrowed)
                {
                    <a asp-action="Create" class="ui-btn ui-btn-secondary ui-btn-sm" style="margin-top: 6px;">Add the first influencer</a>
                }
            </div>
        }
        else
        {
            <div class="ui-meta">
                Showing <strong>@startRecord.ToString("N0")</strong>
                to <strong>@endRecord.ToString("N0")</strong>
                of <strong>@Model.TotalCount.ToString("N0")</strong> influencers
            </div>

            <div class="ui-table-wrap">
                <table class="ui-table">
                    <thead>
                        <tr>
                            <th>Influencer</th>
                            <th>National ID</th>
                            <th>Category</th>
                            <th>Phone</th>
                            <th>Island</th>
                            <th class="ui-hide-sm">Remarks</th>
                            <th class="is-center">Linked voters</th>
                            <th><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var influencer in Model.Items)
                        {
                            var name = string.IsNullOrWhiteSpace(influencer.FullName) ? "Unnamed influencer" : influencer.FullName;

                            <tr>
                                <td>
                                    <div class="ui-person">
                                        <span class="ui-avatar is-violet-soft" aria-hidden="true">@InitialsOf(name)</span>
                                        <span><strong>@name</strong></span>
                                    </div>
                                </td>

                                <td class="ui-num ui-muted">@influencer.NationalId</td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(influencer.CategoryName))
                                    {
                                        <a class="ui-pill is-violet ui-pill-link"
                                           title="Show all @influencer.CategoryName influencers"
                                           href="@Url.Action("Index", new { category = influencer.CategoryId, pageSize = filter.PageSize })">@influencer.CategoryName</a>
                                    }
                                    else
                                    {
                                        <span class="ui-faint">—</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(influencer.ContactNumber))
                                    {
                                        <a href="tel:@influencer.ContactNumber" class="ui-link ui-num">@influencer.ContactNumber</a>
                                    }
                                    else
                                    {
                                        <span class="ui-faint">—</span>
                                    }
                                </td>

                                <td style="min-width: 130px;">
                                    @if (!string.IsNullOrWhiteSpace(influencer.IslandName))
                                    {
                                        <div>@influencer.IslandName</div>
                                    }
                                    else
                                    {
                                        <div class="ui-faint">Whole constituency</div>
                                    }
                                    <div class="ui-muted" style="font-size: 12px;">@ConstituencyLabel(influencer)</div>
                                </td>

                                <td class="ui-muted ui-hide-sm" style="max-width: 260px; font-size: 13px;">@influencer.Remarks</td>

                                <td class="is-center">
                                    <a asp-action="Voters"
                                       asp-route-id="@influencer.Id"
                                       class="ui-pill is-violet ui-pill-link"
                                       title="See the voters linked to @name">@influencer.LinkedVoters ›</a>
                                </td>

                                <td class="is-right" style="white-space: nowrap;">
                                    @if (canEdit)
                                    {
                                        <a asp-action="Edit" asp-route-id="@influencer.Id" class="ui-btn ui-btn-ghost ui-btn-sm" aria-label="Edit @name" title="Edit">
                                            <partial name="_Icon" model='"edit"' />
                                        </a>
                                    }

                                    @if (canDelete)
                                    {
                                        <form asp-action="Delete"
                                              asp-route-id="@influencer.Id"
                                              method="post"
                                              class="h28-delete-influencer"
                                              style="display: inline;"
                                              data-name="@name"
                                              data-links="@influencer.LinkedVoters">
                                            <button type="submit" class="ui-btn ui-btn-ghost ui-btn-sm ui-btn-danger" aria-label="Delete @name" title="Delete">
                                                <partial name="_Icon" model='"trash"' />
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <nav class="ui-pager" aria-label="Influencer pagination">

                @if (Model.HasPreviousPage)
                {
                    <a class="ui-page-btn" asp-action="Index" asp-all-route-data="PageRoute(Model.Page - 1)">‹ Previous</a>
                }
                else
                {
                    <span class="ui-page-btn is-disabled">‹ Previous</span>
                }

                @if (firstVisiblePage > 1)
                {
                    <a class="ui-page-btn" asp-action="Index" asp-all-route-data="PageRoute(1)">1</a>

                    if (firstVisiblePage > 2)
                    {
                        <span class="ui-page-btn is-disabled">…</span>
                    }
                }

                @for (var pageNumber = firstVisiblePage; pageNumber <= lastVisiblePage; pageNumber++)
                {
                    if (pageNumber == Model.Page)
                    {
                        <span class="ui-page-btn is-current" aria-current="page">@pageNumber</span>
                    }
                    else
                    {
                        <a class="ui-page-btn" asp-action="Index" asp-all-route-data="PageRoute(pageNumber)">@pageNumber</a>
                    }
                }

                @if (lastVisiblePage < Model.TotalPages)
                {
                    if (lastVisiblePage < Model.TotalPages - 1)
                    {
                        <span class="ui-page-btn is-disabled">…</span>
                    }

                    <a class="ui-page-btn" asp-action="Index" asp-all-route-data="PageRoute(Model.TotalPages)">@Model.TotalPages.ToString("N0")</a>
                }

                @if (Model.HasNextPage)
                {
                    <a class="ui-page-btn" asp-action="Index" asp-all-route-data="PageRoute(Model.Page + 1)">Next ›</a>
                }
                else
                {
                    <span class="ui-page-btn is-disabled">Next ›</span>
                }

            </nav>
        }

    </section>

</div>

@section Scripts
{
    <script>
        (function ($) {
            // Permanent delete: say exactly what will be lost before going ahead.
            document.querySelectorAll('.h28-delete-influencer').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    var links = parseInt(form.dataset.links || '0', 10);
                    var message =
                        'Permanently delete ' + form.dataset.name + '?\n\n' +
                        (links > 0
                            ? 'This also removes their link to ' + links + ' voter' + (links === 1 ? '' : 's') + '.\n'
                            : '') +
                        'This cannot be undone.';

                    if (!window.confirm(message)) {
                        e.preventDefault();
                        e.stopImmediatePropagation();
                    }
                });
            });

            var $constituency = $("#filterConstituency");
            var $island = $("#filterIsland");

            if (!$constituency.length || !$island.length) return;

            // Type-to-search inside the dropdowns (by name or constituency code).
            if (typeof $.fn.select2 === "function") {
                $constituency.select2({ width: "100%", placeholder: "All constituencies", allowClear: true });
                $island.select2({ width: "100%" });
            }

            function resetIslands(text, disabled) {
                $island.empty().append($("<option>", { value: "", text: text }));
                $island.prop("disabled", disabled).trigger("change.select2");
            }

            // Islands follow the chosen constituency.
            $constituency.on("change", function () {
                var id = $constituency.val();

                if (!id) {
                    resetIslands("Choose a constituency first", true);
                    return;
                }

                resetIslands("Loading islands…", true);

                $.getJSON($island.data("islandsUrl"), { constituencyId: id })
                    .done(function (islands) {
                        resetIslands("All islands", false);
                        $.each(islands, function (_, i) {
                            $island.append($("<option>", { value: i.id, text: i.name }));
                        });
                        $island.trigger("change.select2");
                    })
                    .fail(function () { resetIslands("All islands", false); });
            });
        })(window.jQuery);
    </script>
}
