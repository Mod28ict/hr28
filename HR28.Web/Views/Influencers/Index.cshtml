@model List<HR28.Web.Models.InfluencerDto>

<div class="container mt-4">

    <h2>Influencers</h2>

    <table class="table table-striped">

        <thead>
            <tr>
                <th>National ID</th>
                <th>Name</th>
                <th>Contact Number</th>
                <th>Remarks</th>
            </tr>
        </thead>

        <tbody>

        @foreach(var item in Model)
        {
            <tr>
                <td>@item.NationalId</td>
                <td>@item.FullName</td>
                <td>@item.ContactNumber</td>
                <td>@item.Remarks</td>
            </tr>
        }

        </tbody>

    </table>

</div>