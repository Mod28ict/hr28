@model HR28.Web.Models.SettingsViewModel

@{
    ViewData["Title"] = "Settings";

    var tabs = new List<(string Key, string Label, string Icon)>
    {
        ("appearance", "Appearance", "eye"),
        ("account", "My account", "user")
    };

    if (Model.IsAdministrator)
    {
        tabs.Add(("system", "System", "key"));
        tabs.Add(("geography", "Constituencies & islands", "map"));
        tabs.Add(("lists", "Lists", "star"));
    }

    if (Model.IsSuperAdministrator)
    {
        tabs.Add(("permissions", "Roles & rights", "shield"));
    }

    string LocalTime(DateTime? value) =>
        value.HasValue
            ? HR28.Web.Services.Hr28Time.FromUtc(value.Value).ToString("dd MMM yyyy, HH:mm")
            : "—";
}

<div class="ui-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="ui-alert is-green" role="status">
            <partial name="_Icon" model='"check-circle"' />
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="ui-alert is-red" role="alert">
            <partial name="_Icon" model='"alert"' />
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <header class="ui-head">
        <div class="ui-head-main">
            <span class="ui-head-icon is-muted" style="background: #64748b;"><partial name="_Icon" model='"key"' /></span>
            <div>
                <h1 class="ui-title">Settings</h1>
                <p class="ui-sub">Personalise HR28 and @(Model.IsAdministrator ? "manage platform-wide options." : "review your account.")</p>
            </div>
        </div>
    </header>

    <nav class="ui-tabs" aria-label="Settings sections">
        @foreach (var t in tabs)
        {
            <a asp-action="Index"
               asp-route-tab="@t.Key"
               class="ui-tab @(Model.Tab == t.Key ? "is-active" : "")"
               aria-current="@(Model.Tab == t.Key ? "page" : null)">
                <partial name="_Icon" model="@t.Icon" />
                @t.Label
            </a>
        }
    </nav>

    @* ---------------- APPEARANCE ---------------- *@
    @if (Model.Tab == "appearance")
    {
        <section class="ui-card ui-card-lg">
            <div class="ui-card-head">
                <h2>Theme</h2>
            </div>
            <p class="ui-muted" style="margin: -6px 0 16px; font-size: 13px;">
                Saved on this device. You can also switch quickly from the menu under your name.
            </p>

            <div class="ui-theme-options" role="radiogroup" aria-label="Theme">
                <label class="ui-theme-option">
                    <input type="radio" name="hr28Theme" value="light" />
                    <span class="ui-theme-preview is-light" aria-hidden="true"><i></i><b></b><b></b></span>
                    <span class="ui-strong">Light</span>
                    <small class="ui-muted">Bright and clear for daytime use</small>
                </label>
                <label class="ui-theme-option">
                    <input type="radio" name="hr28Theme" value="dark" />
                    <span class="ui-theme-preview is-dark" aria-hidden="true"><i></i><b></b><b></b></span>
                    <span class="ui-strong">Dark</span>
                    <small class="ui-muted">Easier on the eyes in low light</small>
                </label>
                <label class="ui-theme-option">
                    <input type="radio" name="hr28Theme" value="system" />
                    <span class="ui-theme-preview is-system" aria-hidden="true"><i></i><b></b><b></b></span>
                    <span class="ui-strong">Match device</span>
                    <small class="ui-muted">Follows your operating system setting</small>
                </label>
            </div>
        </section>
    }

    @* ---------------- MY ACCOUNT ---------------- *@
    @if (Model.Tab == "account")
    {
        var a = Model.Account;

        if (a == null)
        {
            <div class="ui-empty">Your account details could not be loaded.</div>
        }
        else
        {
            <section class="ui-card ui-card-lg">
                <div class="ui-head" style="margin-bottom: 18px;">
                    <div class="ui-head-main">
                        <span class="ui-avatar ui-avatar-lg" aria-hidden="true">
                            @string.Concat(a.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])))
                        </span>
                        <div>
                            <h2 class="ui-title" style="font-size: 22px;">@a.FullName</h2>
                            <p class="ui-sub">@(string.IsNullOrWhiteSpace(a.Designation) ? HR28.Web.Services.Hr28Roles.DisplayName(a.RoleName) : $"{a.Designation} · {HR28.Web.Services.Hr28Roles.DisplayName(a.RoleName)}")</p>
                        </div>
                    </div>
                    <div class="ui-chip-row">
                        @foreach (var r in (a.Roles.Count > 0 ? a.Roles : new List<string> { a.RoleName }))
                        {
                            <span class="ui-pill @(a.IsAdministrator ? "is-blue" : "is-violet")">@HR28.Web.Services.Hr28Roles.DisplayName(r)</span>
                        }
                    </div>
                </div>

                <dl class="ui-details">
                    <div>
                        <dt>National ID</dt>
                        <dd class="ui-num">@a.NationalId</dd>
                    </div>
                    <div>
                        <dt>Mobile</dt>
                        <dd class="ui-num">@(string.IsNullOrWhiteSpace(a.MobileNumber) ? "—" : a.MobileNumber)</dd>
                    </div>
                    <div>
                        <dt>Email</dt>
                        <dd>@(string.IsNullOrWhiteSpace(a.Email) ? "—" : a.Email)</dd>
                    </div>
                    <div>
                        <dt>Last sign-in</dt>
                        <dd>@LocalTime(a.LastLoginAt)</dd>
                    </div>
                </dl>
            </section>

            <section class="ui-card ui-card-lg">
                <div class="ui-card-head">
                    <h2>What you can see</h2>
                </div>

                @if (a.Scopes.Any())
                {
                    <ul style="display: grid; gap: 10px; margin: 0 0 16px; padding: 0; list-style: none;">
                        @foreach (var line in a.Scopes)
                        {
                            <li style="display: flex; align-items: center; gap: 10px;">
                                <span class="ui-avatar is-cyan" style="width: 32px; height: 32px; flex-basis: 32px; color: var(--tone); background: var(--tone-soft);" aria-hidden="true">
                                    <partial name="_Icon" model='"map-pin"' />
                                </span>
                                <span class="ui-strong">@line</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="ui-note is-amber">
                        <partial name="_Icon" model='"alert"' />
                        <div>
                            <strong>No area assigned yet</strong>
                            You won't see any voters or influencers until an administrator assigns your scope.
                        </div>
                    </div>
                }

                <div class="ui-note is-muted" style="margin-bottom: 0;">
                    <partial name="_Icon" model='"info"' />
                    <span>Your role decides what you can do; your scope decides which records it applies to. Contact your Administrator to change either.</span>
                </div>
            </section>
        }
    }

    @* ---------------- SYSTEM (administrators) ---------------- *@
    @if (Model.Tab == "system" && Model.System != null)
    {
        var s = Model.System;

        <section class="ui-card ui-card-lg">
            <form asp-action="SaveSystem" method="post">
                @Html.AntiForgeryToken()

                <div class="ui-section">
                    <div class="ui-section-head">
                        <span class="ui-step">1</span>
                        <div>
                            <div class="ui-section-title">Campaign</div>
                            <div class="ui-section-sub">Shown under the HR28 logo in the sidebar for everyone</div>
                        </div>
                    </div>

                    <div class="ui-field">
                        <label for="CampaignName" class="ui-label">Campaign name</label>
                        <input id="CampaignName" name="CampaignName" class="ui-input" value="@s.CampaignName" required minlength="2" maxlength="80" />
                    </div>
                </div>

                <div class="ui-section">
                    <div class="ui-section-head">
                        <span class="ui-step">2</span>
                        <div>
                            <div class="ui-section-title">Sign-in security</div>
                            <div class="ui-section-sub">Applies to the next OTP requested by any user</div>
                        </div>
                    </div>

                    <div class="ui-grid-2">
                        <div class="ui-field">
                            <label for="OtpExpiryMinutes" class="ui-label">OTP expiry (minutes)</label>
                            <input id="OtpExpiryMinutes" name="OtpExpiryMinutes" type="number" class="ui-input" value="@s.OtpExpiryMinutes" min="1" max="15" required />
                            <div class="ui-hint">Between 1 and 15 minutes.</div>
                        </div>
                        <div class="ui-field">
                            <label for="OtpMaxAttempts" class="ui-label">Maximum OTP attempts</label>
                            <input id="OtpMaxAttempts" name="OtpMaxAttempts" type="number" class="ui-input" value="@s.OtpMaxAttempts" min="3" max="10" required />
                            <div class="ui-hint">After this many wrong entries the code is locked and a new one is needed.</div>
                        </div>
                    </div>
                </div>

                <div class="ui-form-actions" style="align-items: center;">
                    <button type="submit" class="ui-btn ui-btn-primary">
                        <partial name="_Icon" model='"check"' />
                        Save settings
                    </button>
                    @if (s.UpdatedAt.HasValue)
                    {
                        <span class="ui-muted" style="font-size: 13px;">
                            Last changed @LocalTime(s.UpdatedAt)@(string.IsNullOrWhiteSpace(s.UpdatedByName) ? "" : $" by {s.UpdatedByName}"). Every change is recorded in the audit trail.
                        </span>
                    }
                </div>
            </form>
        </section>
    }

    @* ---------------- ROLES & RIGHTS (Administrator) ---------------- *@
    @if (Model.Tab == "permissions" && Model.Permissions != null)
    {
        var matrix = Model.Permissions;
        var selected = matrix.Roles.FirstOrDefault(r => r.RoleId == Model.SelectedRoleId);

        <div class="ui-note">
            <partial name="_Icon" model='"info"' />
            <span>
                A role is a set of rights. Everyone with the role gets them, but only inside their own areas
                (Users → Areas). To give a right to just one person, use Users → Roles → Extra rights.
            </span>
        </div>

        <div class="ui-roles-layout">

            <!-- Roles -->
            <section class="ui-card">
                <div class="ui-card-head">
                    <h2>Roles <span class="ui-count is-blue">@matrix.Roles.Count</span></h2>
                </div>

                <nav class="ui-role-list" aria-label="Roles">
                    @foreach (var r in matrix.Roles)
                    {
                        <a asp-action="Index"
                           asp-route-tab="permissions"
                           asp-route-role="@r.RoleId"
                           class="ui-role-item @(r.RoleId == Model.SelectedRoleId ? "is-active" : "")"
                           aria-current="@(r.RoleId == Model.SelectedRoleId ? "true" : null)">
                            <span class="ui-strong">@HR28.Web.Services.Hr28Roles.DisplayName(r.RoleName)</span>
                            <small class="ui-muted">
                                @(r.UserCount == 1 ? "1 person" : $"{r.UserCount} people")
                                @(r.IsBuiltIn ? " · built-in" : " · custom")
                            </small>
                        </a>
                    }
                </nav>

                <form asp-action="CreateRole" method="post" class="ui-inline-form" style="margin-top: 14px;">
                    @Html.AntiForgeryToken()
                    <div class="ui-inline-form-title">New role</div>
                    <div class="ui-field" style="margin: 0 0 8px;">
                        <label for="newRoleName" class="ui-label">Name</label>
                        <input id="newRoleName" name="name" class="ui-input" required minlength="2" maxlength="50" placeholder="e.g. Field Coordinator" />
                    </div>
                    <div class="ui-field" style="margin: 0 0 8px;">
                        <label for="newRoleDescription" class="ui-label">Description <span class="ui-optional">(optional)</span></label>
                        <input id="newRoleDescription" name="description" class="ui-input" maxlength="200" />
                    </div>
                    <input type="hidden" name="voterProfileView" value="Full" />
                    <button type="submit" class="ui-btn ui-btn-primary ui-btn-sm">
                        <partial name="_Icon" model='"plus"' /> Create role
                    </button>
                </form>
            </section>

            <!-- The selected role -->
            @if (selected != null)
            {
                var display = HR28.Web.Services.Hr28Roles.DisplayName(selected.RoleName);

                <section class="ui-card ui-card-lg">
                    <form asp-action="SaveRole" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="roleId" value="@selected.RoleId" />

                        <div class="ui-card-head">
                            <h2>@display</h2>
                            @if (selected.IsBuiltIn)
                            {
                                <span class="ui-pill is-muted" title="Built-in roles can't be renamed or deleted">Built-in</span>
                            }
                        </div>

                        @if (!selected.IsBuiltIn)
                        {
                            <div class="ui-grid-2">
                                <div class="ui-field">
                                    <label for="roleName" class="ui-label">Name</label>
                                    <input id="roleName" name="name" class="ui-input" value="@selected.RoleName" required minlength="2" maxlength="50" />
                                </div>
                                <div class="ui-field">
                                    <label for="roleDescription" class="ui-label">Description <span class="ui-optional">(optional)</span></label>
                                    <input id="roleDescription" name="description" class="ui-input" value="@selected.Description" maxlength="200" />
                                </div>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(selected.Description))
                        {
                            <p class="ui-muted" style="margin: -6px 0 14px;">@selected.Description</p>
                        }

                        <fieldset class="ui-field">
                            <legend class="ui-label">When someone with this role opens a voter</legend>
                            @if (selected.HasAllPermissions)
                            {
                                <p class="ui-muted" style="margin: 0;">The Administrator always sees the full profile.</p>
                                <input type="hidden" name="voterProfileView" value="Full" />
                            }
                            else
                            {
                                <div class="ui-choice-row">
                                    <label class="ui-check-card">
                                        <input type="radio" name="voterProfileView" value="Full" checked="@(selected.VoterProfileView != "AddEncounter")" />
                                        <span>
                                            <strong>Full profile</strong>
                                            <small>Details, plus the sections this role may view below.</small>
                                        </span>
                                    </label>
                                    <label class="ui-check-card">
                                        <input type="radio" name="voterProfileView" value="AddEncounter" checked="@(selected.VoterProfileView == "AddEncounter")" />
                                        <span>
                                            <strong>Add encounter only</strong>
                                            <small>Goes straight to recording an encounter, with a short summary of the voter.</small>
                                        </span>
                                    </label>
                                </div>
                                <div class="ui-hint">If someone has several roles, the full profile wins when any of them allows it.</div>
                            }
                        </fieldset>

                        <div class="ui-field">
                            <span class="ui-label">What this role may do</span>
                            <partial name="_RightsGrid" model='new HR28.Web.Models.RightsGridModel
                            {
                                Permissions = matrix.Permissions,
                                Selected = selected.Permissions.ToHashSet(),
                                InputName = "grants",
                                AllGranted = selected.HasAllPermissions
                            }' />
                            @if (!selected.HasAllPermissions)
                            {
                                <div class="ui-hint">
                                    Example: a Collector who should only add encounters needs "View" voters and "Add" encounters, with "View" encounters left unticked so no history is shown.
                                </div>
                            }
                        </div>

                        <div class="ui-form-actions" style="align-items: center;">
                            <button type="submit" class="ui-btn ui-btn-primary">
                                <partial name="_Icon" model='"check"' />
                                Save role
                            </button>
                            <span class="ui-muted" style="font-size: 13px;">Changes apply straight away and are recorded in the audit trail.</span>
                        </div>
                    </form>

                    @if (!selected.IsBuiltIn)
                    {
                        <form asp-action="DeleteRole" method="post" style="margin-top: 16px;"
                              data-confirm="Delete the role &quot;@display&quot;?">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="roleId" value="@selected.RoleId" />
                            <button type="submit" class="ui-btn ui-btn-ghost ui-btn-sm ui-btn-danger" disabled="@(selected.UserCount > 0)">
                                <partial name="_Icon" model='"trash"' /> Delete role
                            </button>
                            @if (selected.UserCount > 0)
                            {
                                <span class="ui-muted" style="font-size: 13px;">Remove this role from everyone who has it first (Users → Roles).</span>
                            }
                        </form>
                    }
                </section>
            }
        </div>
    }

    @* ---------------- LISTS (administrators) ---------------- *@
    @if (Model.Tab == "lists")
    {
        <div class="ui-note">
            <partial name="_Icon" model='"info"' />
            <span>These lists fill the drop-downs on the forms and filters. Renaming an entry updates every record that uses it. An entry can only be deleted when nothing uses it.</span>
        </div>

        <div class="ui-settings-grid">
            <section class="ui-card">
                <div class="ui-card-head">
                    <h2>Influencer categories <span class="ui-count is-violet">@Model.InfluencerCategories.Count</span></h2>
                </div>

                <form asp-action="SaveInfluencerCategory" method="post" class="ui-inline-form">
                    @Html.AntiForgeryToken()
                    <div class="ui-inline-form-title">New category</div>
                    <div style="display: flex; gap: 8px; align-items: flex-end;">
                        <div class="ui-field" style="flex: 1; margin: 0;">
                            <label for="newCategoryName" class="ui-label">Name</label>
                            <input id="newCategoryName" name="name" class="ui-input" required maxlength="60" placeholder="e.g. Atoll Council" />
                        </div>
                        <button type="submit" class="ui-btn ui-btn-primary ui-btn-sm">
                            <partial name="_Icon" model='"plus"' /> Add
                        </button>
                    </div>
                </form>

                @if (!Model.InfluencerCategories.Any())
                {
                    <div class="ui-empty">No categories yet. Add the first one above.</div>
                }
                else
                {
                    <div class="ui-table-wrap">
                        <table class="ui-table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th class="is-right">Influencers</th>
                                    <th><span class="visually-hidden">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cat in Model.InfluencerCategories)
                                {
                                    <tr>
                                        @if (Model.EditCategoryId == cat.Id)
                                        {
                                            <td colspan="3">
                                                <form asp-action="SaveInfluencerCategory" method="post" style="display: flex; gap: 8px; align-items: center;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@cat.Id" />
                                                    <label for="editCategoryName" class="visually-hidden">New name for @cat.Name</label>
                                                    <input id="editCategoryName" name="name" class="ui-input" value="@cat.Name" required maxlength="60" autofocus style="flex: 1;" />
                                                    <button type="submit" class="ui-btn ui-btn-primary ui-btn-sm">Save</button>
                                                    <a asp-action="Index" asp-route-tab="lists" class="ui-btn ui-btn-ghost ui-btn-sm">Cancel</a>
                                                </form>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="ui-strong">@cat.Name</td>
                                            <td class="ui-num is-right">
                                                @if (cat.InfluencerCount > 0)
                                                {
                                                    <a asp-controller="Influencers" asp-action="Index" asp-route-category="@cat.Id" class="ui-link">@cat.InfluencerCount.ToString("N0")</a>
                                                }
                                                else
                                                {
                                                    <span class="ui-faint">0</span>
                                                }
                                            </td>
                                            <td class="is-right" style="white-space: nowrap;">
                                                <a asp-action="Index" asp-route-tab="lists" asp-route-editCategory="@cat.Id" class="ui-btn ui-btn-ghost ui-btn-sm" aria-label="Rename @cat.Name" title="Rename">
                                                    <partial name="_Icon" model='"edit"' />
                                                </a>
                                                @if (cat.InfluencerCount == 0)
                                                {
                                                    <form asp-action="DeleteInfluencerCategory" asp-route-id="@cat.Id" method="post" style="display: inline;"
                                                          data-confirm="Delete the category &quot;@cat.Name&quot;?">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="ui-btn ui-btn-ghost ui-btn-sm ui-btn-danger" aria-label="Delete @cat.Name" title="Delete">
                                                            <partial name="_Icon" model='"trash"' />
                                                        </button>
                                                    </form>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <p class="ui-muted" style="margin: 12px 0 0; font-size: 13px;">Every change is recorded in the audit trail.</p>
            </section>

            <section class="ui-card">
                <div class="ui-card-head">
                    <h2>Political parties <span class="ui-count is-blue">@Model.Parties.Count</span></h2>
                </div>

                <p class="ui-muted" style="margin: -6px 0 12px; font-size: 13px;">
                    Parties registered with the Elections Commission. A voter with no party is shown as "Not known".
                </p>

                <form asp-action="SaveParty" method="post" class="ui-inline-form">
                    @Html.AntiForgeryToken()
                    <div class="ui-inline-form-title">New party</div>
                    <div style="display: flex; gap: 8px; align-items: flex-end; flex-wrap: wrap;">
                        <div class="ui-field" style="flex: 1 1 180px; margin: 0;">
                            <label for="newPartyName" class="ui-label">Name</label>
                            <input id="newPartyName" name="name" class="ui-input" required maxlength="100" placeholder="Full party name" />
                        </div>
                        <div class="ui-field" style="flex: 0 0 110px; margin: 0;">
                            <label for="newPartyShort" class="ui-label">Short name</label>
                            <input id="newPartyShort" name="shortName" class="ui-input ui-upper" required maxlength="10" placeholder="e.g. MDP" />
                        </div>
                        <button type="submit" class="ui-btn ui-btn-primary ui-btn-sm">
                            <partial name="_Icon" model='"plus"' /> Add
                        </button>
                    </div>
                </form>

                <div class="ui-table-wrap">
                    <table class="ui-table">
                        <thead>
                            <tr>
                                <th>Party</th>
                                <th class="is-right">Voters</th>
                                <th><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var party in Model.Parties)
                            {
                                <tr>
                                    @if (Model.EditPartyId == party.Id)
                                    {
                                        <td colspan="3">
                                            <form asp-action="SaveParty" method="post" style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@party.Id" />
                                                <label for="editPartyName" class="visually-hidden">Name</label>
                                                <input id="editPartyName" name="name" class="ui-input" value="@party.Name" required maxlength="100" autofocus style="flex: 1 1 180px;" />
                                                <label for="editPartyShort" class="visually-hidden">Short name</label>
                                                <input id="editPartyShort" name="shortName" class="ui-input ui-upper" value="@party.ShortName" required maxlength="10" style="flex: 0 0 90px;" />
                                                <button type="submit" class="ui-btn ui-btn-primary ui-btn-sm">Save</button>
                                                <a asp-action="Index" asp-route-tab="lists" class="ui-btn ui-btn-ghost ui-btn-sm">Cancel</a>
                                            </form>
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            <span class="ui-tag">@party.ShortName</span>
                                            <span class="ui-strong">@party.Name</span>
                                            @if (party.IsDefaultFilter)
                                            {
                                                <span class="ui-pill is-blue" title="The Voters list opens filtered to this party">Voters list opens here</span>
                                            }
                                        </td>
                                        <td class="ui-num is-right">@party.VoterCount.ToString("N0")</td>
                                        <td class="is-right" style="white-space: nowrap;">
                                            @if (!party.IsDefaultFilter)
                                            {
                                                <form asp-action="SetDefaultParty" asp-route-id="@party.Id" method="post" style="display: inline;">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="ui-btn ui-btn-ghost ui-btn-sm" title="Open the Voters list on @party.ShortName">Open list here</button>
                                                </form>
                                            }
                                            <a asp-action="Index" asp-route-tab="lists" asp-route-editParty="@party.Id" class="ui-btn ui-btn-ghost ui-btn-sm" aria-label="Edit @party.Name" title="Edit">
                                                <partial name="_Icon" model='"edit"' />
                                            </a>
                                            @if (party.VoterCount == 0)
                                            {
                                                <form asp-action="DeleteParty" asp-route-id="@party.Id" method="post" style="display: inline;"
                                                      data-confirm="Delete &quot;@party.Name&quot;?">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="ui-btn ui-btn-ghost ui-btn-sm ui-btn-danger" aria-label="Delete @party.Name" title="Delete">
                                                        <partial name="_Icon" model='"trash"' />
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.Parties.Any(p => p.IsDefaultFilter))
                {
                    <form asp-action="SetDefaultParty" method="post" style="margin-top: 12px;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ui-btn ui-btn-ghost ui-btn-sm">Open the Voters list on all parties instead</button>
                    </form>
                }

                <p class="ui-muted" style="margin: 12px 0 0; font-size: 13px;">Every change is recorded in the audit trail.</p>
            </section>
        </div>
    }

    @* ---------------- CONSTITUENCIES & ISLANDS (administrators) ---------------- *@
    @if (Model.Tab == "geography")
    {
        <div class="ui-note">
            <partial name="_Icon" model='"info"' />
            <span>Each island belongs to exactly one constituency. An island that already has voters can be renamed but not moved to another constituency.</span>
        </div>

        <div class="ui-settings-grid">

            <!-- Constituencies -->
            <section class="ui-card">
                <div class="ui-card-head">
                    <h2>Constituencies <span class="ui-count">@Model.Constituencies.Count</span></h2>
                    <a asp-action="Index" asp-route-tab="geography" asp-route-newConstituency="true" class="ui-btn ui-btn-secondary ui-btn-sm">
                        <partial name="_Icon" model='"plus"' /> Add
                    </a>
                </div>

                @if (Model.ConstituencyForm is { } cf)
                {
                    <form asp-action="SaveConstituency" method="post" class="ui-inline-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@cf.Id" />
                        <div class="ui-inline-form-title">@(cf.Id.HasValue ? "Edit constituency" : "New constituency")</div>
                        <div class="ui-grid-2" style="grid-template-columns: 120px 1fr;">
                            <div class="ui-field">
                                <label for="cCode" class="ui-label">Code</label>
                                <input id="cCode" name="Code" class="ui-input ui-upper" value="@cf.Code" required maxlength="10" />
                            </div>
                            <div class="ui-field">
                                <label for="cName" class="ui-label">Name</label>
                                <input id="cName" name="Name" class="ui-input" value="@cf.Name" required maxlength="100" />
                            </div>
                        </div>
                        <div style="display: flex; gap: 8px;">
                            <button type="submit" class="ui-btn ui-btn-primary ui-btn-sm">Save</button>
                            <a asp-action="Index" asp-route-tab="geography" class="ui-btn ui-btn-ghost ui-btn-sm">Cancel</a>
                        </div>
                    </form>
                }

                <div class="ui-search" style="margin-bottom: 12px;">
                    <partial name="_Icon" model='"search"' />
                    <label for="cFilter" class="visually-hidden">Filter constituencies</label>
                    <input type="search" id="cFilter" class="ui-input" placeholder="Filter constituencies" data-filter-table="cTable" />
                </div>

                <div class="ui-table-wrap" style="max-height: 560px; overflow-y: auto;">
                    <table class="ui-table" id="cTable">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Name</th>
                                <th class="is-right">Islands</th>
                                <th class="is-right">Voters</th>
                                <th><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Constituencies)
                            {
                                <tr>
                                    <td class="ui-num ui-muted">@c.Code</td>
                                    <td class="ui-strong">@c.Name</td>
                                    <td class="ui-num is-right">
                                        <a asp-action="Index" asp-route-tab="geography" asp-route-constituency="@c.Id" class="ui-link">@c.IslandCount</a>
                                    </td>
                                    <td class="ui-num is-right">@c.VoterCount.ToString("N0")</td>
                                    <td class="is-right">
                                        <a asp-action="Index" asp-route-tab="geography" asp-route-editConstituency="@c.Id" class="ui-btn ui-btn-ghost ui-btn-sm" aria-label="Edit @c.Name">
                                            <partial name="_Icon" model='"edit"' />
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Islands -->
            <section class="ui-card">
                <div class="ui-card-head">
                    <h2>Islands <span class="ui-count is-cyan">@Model.Islands.Count</span></h2>
                    <a asp-action="Index" asp-route-tab="geography" asp-route-newIsland="true" asp-route-constituency="@Model.IslandConstituencyFilter" class="ui-btn ui-btn-secondary ui-btn-sm">
                        <partial name="_Icon" model='"plus"' /> Add
                    </a>
                </div>

                @if (Model.IslandForm is { } isf)
                {
                    <form asp-action="SaveIsland" method="post" class="ui-inline-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@isf.Id" />
                        <div class="ui-inline-form-title">@(isf.Id.HasValue ? "Edit island" : "New island")</div>
                        <div class="ui-grid-2">
                            <div class="ui-field">
                                <label for="iName" class="ui-label">Island name</label>
                                <input id="iName" name="Name" class="ui-input" value="@isf.Name" required maxlength="100" />
                            </div>
                            <div class="ui-field">
                                <label for="iAtoll" class="ui-label">Atoll code</label>
                                <input id="iAtoll" name="Atoll" class="ui-input" value="@isf.Atoll" required maxlength="10" placeholder="e.g. K, HA, Sh" />
                            </div>
                            <div class="ui-field ui-full">
                                <label for="iConstituency" class="ui-label">Constituency</label>
                                <select id="iConstituency" name="ConstituencyId" class="ui-select" required>
                                    <option value="">Select Constituency</option>
                                    @foreach (var c in Model.Constituencies)
                                    {
                                        <option value="@c.Id" selected="@(c.Id == isf.ConstituencyId)">@c.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div style="display: flex; gap: 8px;">
                            <button type="submit" class="ui-btn ui-btn-primary ui-btn-sm">Save</button>
                            <a asp-action="Index" asp-route-tab="geography" asp-route-constituency="@Model.IslandConstituencyFilter" class="ui-btn ui-btn-ghost ui-btn-sm">Cancel</a>
                        </div>
                    </form>
                }

                <form method="get" asp-action="Index" style="display: flex; gap: 10px; margin-bottom: 12px;">
                    <input type="hidden" name="tab" value="geography" />
                    <label for="iFilterConstituency" class="visually-hidden">Show islands for</label>
                    <select id="iFilterConstituency" name="constituency" class="ui-select" onchange="this.form.submit()">
                        <option value="">All constituencies</option>
                        @foreach (var c in Model.Constituencies)
                        {
                            <option value="@c.Id" selected="@(c.Id == Model.IslandConstituencyFilter)">@c.Name</option>
                        }
                    </select>
                    <noscript><button type="submit" class="ui-btn ui-btn-secondary">Show</button></noscript>
                </form>

                @if (!Model.Islands.Any())
                {
                    <div class="ui-empty">No islands for this constituency yet.</div>
                }
                else
                {
                    <div class="ui-table-wrap" style="max-height: 520px; overflow-y: auto;">
                        <table class="ui-table">
                            <thead>
                                <tr>
                                    <th>Island</th>
                                    <th>Atoll</th>
                                    <th>Constituency</th>
                                    <th><span class="visually-hidden">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var i in Model.Islands)
                                {
                                    <tr>
                                        <td class="ui-strong">@i.Name</td>
                                        <td><span class="ui-tag">@i.Atoll</span></td>
                                        <td class="ui-muted">@i.ConstituencyName</td>
                                        <td class="is-right">
                                            <a asp-action="Index" asp-route-tab="geography" asp-route-editIsland="@i.Id" asp-route-constituency="@Model.IslandConstituencyFilter" class="ui-btn ui-btn-ghost ui-btn-sm" aria-label="Edit @i.Name">
                                                <partial name="_Icon" model='"edit"' />
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

        </div>
    }

</div>

@section Scripts
{
    <script>
        (function () {
            // Theme choice (appearance tab)
            var radios = document.querySelectorAll('input[name="hr28Theme"]');
            if (radios.length && window.hr28Theme) {
                var current = window.hr28Theme.get();
                radios.forEach(function (r) {
                    r.checked = r.value === current;
                    r.addEventListener('change', function () {
                        if (r.checked) window.hr28Theme.set(r.value);
                    });
                });
            }

            // Forms that ask before going ahead (text comes from data-confirm, never from script)
            document.querySelectorAll('form[data-confirm]').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    if (!window.confirm(form.dataset.confirm)) e.preventDefault();
                });
            });

            // Client-side filter for long tables
            document.querySelectorAll('[data-filter-table]').forEach(function (input) {
                var table = document.getElementById(input.dataset.filterTable);
                if (!table) return;
                input.addEventListener('input', function () {
                    var term = input.value.trim().toLowerCase();
                    table.querySelectorAll('tbody tr').forEach(function (row) {
                        row.style.display = row.textContent.toLowerCase().includes(term) ? '' : 'none';
                    });
                });
            });
        })();
    </script>
}
