@model HR28.Web.Models.PagedResult<HR28.Web.Models.EncounterListItemDto>

@{
    ViewData["Title"] = "Encounters";

    var filter = ViewBag.Filter as HR28.Web.Models.EncounterListFilterModel ?? new HR28.Web.Models.EncounterListFilterModel();
    var errorMessage = ViewBag.ErrorMessage as string;

    // Granted right; the API checks it again together with the voter's area.
    var canEdit = HR28.Web.Services.Hr28Permissions.Has(Context.Session, HR28.Web.Services.Hr28Permissions.EncountersEdit);

    var startRecord = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
    var endRecord = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
    var firstVisiblePage = Math.Max(1, Model.Page - 2);
    var lastVisiblePage = Math.Min(Model.TotalPages, Model.Page + 2);

    // Filter chips change one value and keep the rest; page links keep everything.
    Dictionary<string, string> ChipRoute(string key, string? value)
    {
        var values = filter.RouteValues();
        values.Remove(key);
        if (!string.IsNullOrWhiteSpace(value)) values[key] = value;
        return values;
    }

    Dictionary<string, string> PageRoute(int pageNumber)
    {
        var values = filter.RouteValues();
        values["page"] = pageNumber.ToString();
        return values;
    }

    string ChipClass(bool active) => active ? "ui-filter-chip is-active" : "ui-filter-chip";
}

<div class="ui-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="ui-alert is-green" role="status">
            <partial name="_Icon" model='"check-circle"' />
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <header class="ui-head">
        <div class="ui-head-main">
            <span class="ui-head-icon is-violet"><partial name="_Icon" model='"calendar"' /></span>
            <div>
                <h1 class="ui-title">Encounters</h1>
                <p class="ui-sub">
                    @Model.TotalCount.ToString("N0")
                    @(Model.TotalCount == 1 ? "encounter" : "encounters")
                    @(filter.IsNarrowed ? "match your search and filters" : "with voters within your assigned scope")
                </p>
            </div>
        </div>
    </header>

    <section class="ui-card">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="ui-alert is-red" role="alert">
                <partial name="_Icon" model='"alert"' />
                <span>@errorMessage</span>
            </div>
        }

        <form asp-action="Index" method="get" role="search">
            <input type="hidden" name="outcome" value="@filter.Outcome" />
            <input type="hidden" name="response" value="@filter.Response" />

            <div class="ui-toolbar">
                <div class="ui-search">
                    <partial name="_Icon" model='"search"' />
                    <label for="encounterSearch" class="visually-hidden">Search encounters</label>
                    <input type="search"
                           id="encounterSearch"
                           name="searchTerm"
                           value="@filter.SearchTerm"
                           maxlength="100"
                           class="ui-input"
                           placeholder="Search by voter name, National ID or notes" />
                </div>

                <label for="encounterType" class="visually-hidden">Encounter type</label>
                <select name="type" id="encounterType" class="ui-select ui-select-auto" onchange="this.form.requestSubmit()">
                    <option value="">All types</option>
                    @foreach (var t in HR28.Web.Models.EncounterListFilterModel.Types)
                    {
                        if (filter.Type == t)
                        {
                            <option value="@t" selected>@t</option>
                        }
                        else
                        {
                            <option value="@t">@t</option>
                        }
                    }
                </select>

                <button type="submit" class="ui-btn ui-btn-primary">Search</button>

                <label for="encounterPageSize" class="visually-hidden">Rows per page</label>
                <select name="pageSize" id="encounterPageSize" class="ui-select ui-select-auto" onchange="this.form.requestSubmit()">
                    @foreach (var size in new[] { 10, 20, 50, 100 })
                    {
                        if (filter.PageSize == size)
                        {
                            <option value="@size" selected>@size per page</option>
                        }
                        else
                        {
                            <option value="@size">@size per page</option>
                        }
                    }
                </select>
            </div>
        </form>

        <nav class="ui-filter-chips" aria-label="Filter by outcome">
            <a class="@ChipClass(string.IsNullOrWhiteSpace(filter.Outcome))"
               asp-action="Index" asp-all-route-data='@ChipRoute("outcome", null)'>All outcomes</a>

            @foreach (var o in HR28.Web.Models.EncounterListFilterModel.Outcomes)
            {
                <a class="@ChipClass(filter.Outcome == o) is-blue"
                   asp-action="Index" asp-all-route-data='@ChipRoute("outcome", o)'>@o</a>
            }
        </nav>

        <nav class="ui-filter-chips" aria-label="Filter by response">
            <a class="@ChipClass(string.IsNullOrWhiteSpace(filter.Response))"
               asp-action="Index" asp-all-route-data='@ChipRoute("response", null)'>All responses</a>

            @foreach (var r in HR28.Web.Models.EncounterListFilterModel.Responses)
            {
                <a class="@ChipClass(filter.Response == r.Value) @r.Tone"
                   asp-action="Index" asp-all-route-data='@ChipRoute("response", r.Value)'>@r.Value</a>
            }

            @if (filter.IsNarrowed)
            {
                <a asp-action="Index" asp-route-pageSize="@filter.PageSize" class="ui-btn ui-btn-ghost ui-btn-sm">Clear all</a>
            }
        </nav>

        @if (!Model.Items.Any())
        {
            <div class="ui-empty">
                <partial name="_Icon" model='"calendar"' />
                @(filter.IsNarrowed
                    ? "No encounters match your search and filters."
                    : "No encounters recorded yet. Add one from a voter's profile.")
            </div>
        }
        else
        {
            <div class="ui-meta">
                Showing <strong>@startRecord.ToString("N0")</strong>
                to <strong>@endRecord.ToString("N0")</strong>
                of <strong>@Model.TotalCount.ToString("N0")</strong>
                @(Model.TotalCount == 1 ? "encounter" : "encounters")
            </div>

            <div class="ui-table-wrap">
                <table class="ui-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Voter</th>
                            <th>Island</th>
                            <th>Type</th>
                            <th>Outcome</th>
                            <th>Response</th>
                            <th class="ui-hide-sm">Notes</th>
                            <th class="ui-hide-sm">Recorded by</th>
                            <th><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Items)
                        {
                            <tr>
                                <td class="ui-strong ui-num" style="white-space: nowrap;">
                                    @e.EncounterDate.ToString("dd MMM yyyy")
                                    <div class="ui-muted" style="font-size: 12px; font-weight: 400;">@e.EncounterDate.ToString("HH:mm")</div>
                                </td>

                                <td style="min-width: 170px;">
                                    <a asp-controller="Voters" asp-action="Profile" asp-route-id="@e.VoterId" class="ui-link">
                                        @(string.IsNullOrWhiteSpace(e.VoterName) ? "Unnamed voter" : e.VoterName)
                                    </a>
                                    <div class="ui-muted" style="font-size: 12px;"><partial name="_CopyId" model="e.VoterNationalId" /></div>
                                </td>

                                <td style="min-width: 130px;">
                                    @if (!string.IsNullOrWhiteSpace(e.IslandName))
                                    {
                                        <div>@e.IslandName</div>
                                    }
                                    else
                                    {
                                        <div class="ui-faint">No island</div>
                                    }
                                    <div class="ui-muted" style="font-size: 12px;">@e.ConstituencyName</div>
                                </td>

                                <td><span class="ui-tag">@e.EncounterType</span></td>

                                <td><span class="ui-tag">@e.Outcome</span></td>

                                <td>
                                    <partial name="_EncounterResponse" model="(e.Id, e.Response)" />
                                </td>

                                <td class="ui-muted ui-hide-sm" style="max-width: 280px;">
                                    @if (string.IsNullOrWhiteSpace(e.Notes) || e.Notes.Trim('-', ' ') == "")
                                    {
                                        <span class="ui-faint">—</span>
                                    }
                                    else
                                    {
                                        @(e.Notes.Length > 120 ? e.Notes[..120] + "…" : e.Notes)
                                    }
                                </td>

                                <td class="ui-muted ui-hide-sm">@e.RecordedBy</td>

                                <td class="is-right" style="white-space: nowrap;">
                                    @if (canEdit)
                                    {
                                        <a asp-action="Edit" asp-route-id="@e.Id" class="ui-btn ui-btn-secondary ui-btn-sm">Edit</a>
                                    }
                                    <a asp-controller="Voters" asp-action="Profile" asp-route-id="@e.VoterId" class="ui-btn ui-btn-secondary ui-btn-sm">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <nav class="ui-pager" aria-label="Encounter pagination">
                @if (Model.HasPreviousPage)
                {
                    <a class="ui-page-btn" asp-action="Index" asp-all-route-data="PageRoute(Model.Page - 1)">‹ Previous</a>
                }
                else
                {
                    <span class="ui-page-btn is-disabled">‹ Previous</span>
                }

                @for (var pageNumber = firstVisiblePage; pageNumber <= lastVisiblePage; pageNumber++)
                {
                    if (pageNumber == Model.Page)
                    {
                        <span class="ui-page-btn is-current" aria-current="page">@pageNumber</span>
                    }
                    else
                    {
                        <a class="ui-page-btn" asp-action="Index" asp-all-route-data="PageRoute(pageNumber)">@pageNumber</a>
                    }
                }

                @if (Model.HasNextPage)
                {
                    <a class="ui-page-btn" asp-action="Index" asp-all-route-data="PageRoute(Model.Page + 1)">Next ›</a>
                }
                else
                {
                    <span class="ui-page-btn is-disabled">Next ›</span>
                }
            </nav>
        }

    </section>

</div>

<partial name="_EncounterResponseDialog" />
