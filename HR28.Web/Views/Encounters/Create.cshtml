@model HR28.Web.Models.CreateEncounterDto

@{
    var isEdit = Model.EncounterId.HasValue;

    // Older encounters may hold a value no longer offered; show it so editing keeps it.
    var types = new[] { "Door Visit", "Phone Call", "Meeting", "Campaign Event", "Office Visit", "Other" };
    var legacyType = !string.IsNullOrWhiteSpace(Model.EncounterType) && !types.Contains(Model.EncounterType)
        ? Model.EncounterType
        : null;

    ViewData["Title"] = isEdit ? "Edit Encounter" : "Add Encounter";

    // Who the encounter is with (null on edit or if the voter can't be loaded).
    var summary = ViewBag.Voter as HR28.Web.Models.VoterSearchDto;

    // "Add encounter only" roles don't open the profile; lead them back to the list.
    var addOnly = HR28.Web.Services.Hr28Permissions.OpensVotersOnAddEncounter(Context.Session);
}

<div class="ui-page is-narrow">

    <header class="ui-head">
        <div class="ui-head-main">
            <span class="ui-head-icon is-green"><partial name="_Icon" model='"message"' /></span>
            <div>
                <nav class="ui-crumb" aria-label="Breadcrumb">
                    @if (addOnly && !isEdit)
                    {
                        <a asp-controller="Voters" asp-action="Index">Voters</a>
                    }
                    else
                    {
                        <a asp-controller="Voters" asp-action="Profile" asp-route-id="@Model.VoterId">Voter profile</a>
                    }
                    <span aria-hidden="true">/</span> <span>@(isEdit ? "Edit encounter" : "Add encounter")</span>
                </nav>
                <h1 class="ui-title">@(isEdit ? "Edit Encounter" : "Add Encounter")</h1>
                <p class="ui-sub">
                    @(isEdit
                        ? "Correct this encounter. The change is recorded in the Audit Trail."
                        : "Record a concise, factual interaction with this voter.")
                </p>
            </div>
        </div>
    </header>

    @if (summary != null)
    {
        var who = string.IsNullOrWhiteSpace(summary.FullName) ? "Unnamed voter" : summary.FullName;
        var place = string.Join(", ", new[] { summary.Address, summary.IslandName, summary.ConstituencyName }.Where(s => !string.IsNullOrWhiteSpace(s)));

        <section class="ui-card" aria-label="Voter">
            <div class="ui-person">
                <span class="ui-avatar" aria-hidden="true">@string.Concat(who.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])))</span>
                <span>
                    <strong>@who</strong>
                    <small class="ui-num">@summary.NationalId</small>
                </span>
                <span style="margin-left: auto;"><partial name="_StatusPill" model="summary.SupportStatus" /></span>
            </div>
            @if (!string.IsNullOrWhiteSpace(place))
            {
                <div class="ui-muted" style="margin-top: 8px; font-size: 13px;">@place</div>
            }
        </section>
    }

    <section class="ui-card ui-card-lg">

        <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.EncounterId" method="post">

            @Html.AntiForgeryToken()

            <input asp-for="VoterId" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="ui-summary"></div>

            <div class="ui-grid-2">

                <div class="ui-field">
                    <label asp-for="EncounterDate" class="ui-label">Date and time</label>

                    <input asp-for="EncounterDate"
                           type="datetime-local"
                           class="ui-input" />

                    <span asp-validation-for="EncounterDate" class="ui-error"></span>
                </div>

                <div class="ui-field">
                    <label asp-for="EncounterType" class="ui-label">Encounter type</label>

                    <select asp-for="EncounterType" class="ui-select">
                        <option value="">Select Encounter Type</option>
                        @if (legacyType != null)
                        {
                            <option value="@legacyType">@legacyType</option>
                        }
                        <option value="Door Visit">Door Visit</option>
                        <option value="Phone Call">Phone Call</option>
                        <option value="Meeting">Meeting</option>
                        <option value="Campaign Event">Campaign Event</option>
                        <option value="Office Visit">Office Visit</option>
                        <option value="Other">Other</option>
                    </select>

                    <span asp-validation-for="EncounterType" class="ui-error"></span>
                </div>

            </div>

            <div class="ui-grid-2">

                <div class="ui-field">
                    <span class="ui-label" id="h28OutcomeLabel">Outcome</span>

                    <div class="ui-chips h28-chip-group" data-select="h28OutcomeSelect" role="radiogroup" aria-labelledby="h28OutcomeLabel">
                        @foreach (var o in HR28.Web.Models.EncounterListFilterModel.Outcomes)
                        {
                            <span class="ui-chip is-blue" data-v="@o" role="radio" tabindex="0">@o</span>
                        }
                    </div>

                    <!-- The real field that gets posted; the chips just set it -->
                    <select asp-for="Outcome" id="h28OutcomeSelect" class="ui-hidden" aria-hidden="true" tabindex="-1">
                        <option value="">Select Outcome</option>
                        @foreach (var o in HR28.Web.Models.EncounterListFilterModel.Outcomes)
                        {
                            <option value="@o">@o</option>
                        }
                    </select>

                    <span asp-validation-for="Outcome" class="ui-error"></span>
                </div>

                <div class="ui-field">
                    <span class="ui-label" id="h28ResponseLabel">Response</span>

                    <div class="ui-chips h28-chip-group" data-select="h28ResponseSelect" role="radiogroup" aria-labelledby="h28ResponseLabel">
                        @foreach (var r in HR28.Web.Models.EncounterListFilterModel.Responses)
                        {
                            <span class="ui-chip @r.Tone" data-v="@r.Value" role="radio" tabindex="0">@r.Value</span>
                        }
                    </div>

                    <select asp-for="Response" id="h28ResponseSelect" class="ui-hidden" aria-hidden="true" tabindex="-1">
                        <option value="">Select Response</option>
                        @foreach (var r in HR28.Web.Models.EncounterListFilterModel.Responses)
                        {
                            <option value="@r.Value">@r.Value</option>
                        }
                    </select>

                    <div class="ui-hint">Green = supports, yellow = undecided, red = does not support.</div>
                    <span asp-validation-for="Response" class="ui-error"></span>
                </div>

            </div>

            <div class="ui-field">
                <label asp-for="Notes" class="ui-label">Notes</label>

                <textarea asp-for="Notes"
                          id="h28EncounterNotes"
                          class="ui-textarea"
                          rows="5"
                          maxlength="1000"
                          placeholder="Enter concise, factual notes only."></textarea>

                <div class="ui-counter">
                    <span id="h28EncounterCount">0</span> / 1000
                </div>

                <span asp-validation-for="Notes" class="ui-error"></span>
            </div>

            <div class="ui-form-actions">
                <button type="submit" class="ui-btn ui-btn-primary">
                    <partial name="_Icon" model='"check"' />
                    @(isEdit ? "Save changes" : "Save encounter")
                </button>

                @if (addOnly && !isEdit)
                {
                    <a asp-controller="Voters" asp-action="Index" class="ui-btn ui-btn-secondary">Cancel</a>
                }
                else
                {
                    <a asp-controller="Voters"
                       asp-action="Profile"
                       asp-route-id="@Model.VoterId"
                       class="ui-btn ui-btn-secondary">
                        Cancel
                    </a>
                }
            </div>

        </form>

    </section>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            // Outcome and response chips each drive their hidden select
            document.querySelectorAll(".h28-chip-group").forEach(function (group) {
                var select = document.getElementById(group.dataset.select);
                var chips = group.querySelectorAll(".ui-chip");

                function syncChips() {
                    chips.forEach(function (chip) {
                        var selected = chip.dataset.v === select.value;
                        chip.classList.toggle("active", selected);
                        chip.setAttribute("aria-checked", selected ? "true" : "false");
                    });
                }

                chips.forEach(function (chip) {
                    chip.addEventListener("click", function () {
                        select.value = chip.dataset.v;
                        syncChips();
                        if (window.jQuery && jQuery(select).valid) {
                            jQuery(select).valid();
                        }
                    });

                    chip.addEventListener("keydown", function (e) {
                        if (e.key === "Enter" || e.key === " ") {
                            e.preventDefault();
                            chip.click();
                        }
                    });
                });

                syncChips(); // keeps the chip selected after a failed validation post-back
            });

            // Notes character counter
            var box = document.getElementById("h28EncounterNotes");
            var count = document.getElementById("h28EncounterCount");

            function update() { count.textContent = box.value.length; }

            box.addEventListener("input", update);
            update();
        })();
    </script>
}
