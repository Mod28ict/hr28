@model HR28.Web.Models.CreateEncounterDto

@{
    ViewData["Title"] = "Add Encounter";
}

<div class="container mt-4">

    <h2>Add Encounter</h2>

    <p class="text-muted">
        Record a concise, factual interaction with this voter.
    </p>

    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="VoterId"
               type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <div class="mb-3">

            <label asp-for="EncounterDate"
                   class="form-label">
            </label>

            <input asp-for="EncounterDate"
                   type="datetime-local"
                   class="form-control" />

            <span asp-validation-for="EncounterDate"
                  class="text-danger">
            </span>

        </div>

        <div class="mb-3">

            <label asp-for="EncounterType"
                   class="form-label">
            </label>

            <select asp-for="EncounterType"
                    class="form-select">

                <option value="">
                    Select Encounter Type
                </option>

                <option value="Door Visit">
                    Door Visit
                </option>

                <option value="Phone Call">
                    Phone Call
                </option>

                <option value="Meeting">
                    Meeting
                </option>

                <option value="Campaign Event">
                    Campaign Event
                </option>

                <option value="Office Visit">
                    Office Visit
                </option>

                <option value="Other">
                    Other
                </option>

            </select>

            <span asp-validation-for="EncounterType"
                  class="text-danger">
            </span>

        </div>

        <div class="mb-3">

            <label asp-for="Outcome"
                   class="form-label">
            </label>

            <select asp-for="Outcome"
                    class="form-select">

                <option value="">
                    Select Outcome
                </option>

                <option value="Positive">
                    Positive
                </option>

                <option value="Undecided">
                    Undecided
                </option>

                <option value="Negative">
                    Negative
                </option>

                <option value="Follow-up Required">
                    Follow-up Required
                </option>

                <option value="No Contact">
                    No Contact
                </option>

            </select>

            <span asp-validation-for="Outcome"
                  class="text-danger">
            </span>

        </div>

        <div class="mb-3">

            <label asp-for="Notes"
                   class="form-label">
            </label>

            <textarea asp-for="Notes"
                      class="form-control"
                      rows="5"
                      maxlength="1000"
                      placeholder="Enter concise, factual notes only.">
            </textarea>

            <span asp-validation-for="Notes"
                  class="text-danger">
            </span>

        </div>

        <button type="submit"
                class="btn btn-success">

            Save Encounter

        </button>

        <a asp-controller="Voters"
           asp-action="Profile"
           asp-route-id="@Model.VoterId"
           class="btn btn-secondary">

            Cancel

        </a>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}