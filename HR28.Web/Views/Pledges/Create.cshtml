@model HR28.Web.Models.CreatePledgeDto

@{
    ViewData["Title"] = "Add Pledge";
}

<div class="ui-page is-narrow">

    <header class="ui-head">
        <div class="ui-head-main">
            <span class="ui-head-icon is-amber"><partial name="_Icon" model='"handshake"' /></span>
            <div>
                <nav class="ui-crumb" aria-label="Breadcrumb">
                    <a asp-controller="Voters" asp-action="Profile" asp-route-id="@Model.VoterId">Voter profile</a>
                    <span aria-hidden="true">/</span> <span>Add pledge</span>
                </nav>
                <h1 class="ui-title">Add Pledge</h1>
                <p class="ui-sub">Record a candidate or campaign commitment made to this voter.</p>
            </div>
        </div>
    </header>

    <section class="ui-card ui-card-lg">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <input asp-for="VoterId" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="ui-summary"></div>

            <div class="ui-note is-amber">
                <partial name="_Icon" model='"info"' />
                <span>Record pledges clearly and factually. They are tracked against the voter and appear in pledge reports.</span>
            </div>

            <div class="ui-field">
                <label asp-for="Title" class="ui-label">Pledge title</label>

                <input asp-for="Title"
                       class="ui-input"
                       placeholder="Example: House rent assistance" />

                <span asp-validation-for="Title" class="ui-error"></span>
            </div>

            <div class="ui-field">
                <label asp-for="Description" class="ui-label">Description</label>

                <textarea asp-for="Description"
                          id="h28PledgeDescription"
                          class="ui-textarea"
                          rows="5"
                          maxlength="2000"
                          placeholder="Describe the commitment clearly and factually."></textarea>

                <div class="ui-counter">
                    <span id="h28PledgeCount">0</span> / 2000
                </div>

                <span asp-validation-for="Description" class="ui-error"></span>
            </div>

            <div class="ui-grid-2">

                <div class="ui-field">
                    <label asp-for="PledgeDate" class="ui-label">Pledge date</label>

                    <input asp-for="PledgeDate"
                           type="datetime-local"
                           class="ui-input" />

                    <span asp-validation-for="PledgeDate" class="ui-error"></span>
                </div>

                <div class="ui-field">
                    <label asp-for="DueDate" class="ui-label">
                        Due date <span class="ui-optional">(optional)</span>
                    </label>

                    <input asp-for="DueDate"
                           type="date"
                           class="ui-input" />

                    <span asp-validation-for="DueDate" class="ui-error"></span>
                </div>

            </div>

            <div class="ui-form-actions">
                <button type="submit" class="ui-btn ui-btn-primary">
                    <partial name="_Icon" model='"check"' />
                    Save pledge
                </button>

                <a asp-controller="Voters"
                   asp-action="Profile"
                   asp-route-id="@Model.VoterId"
                   class="ui-btn ui-btn-secondary">
                    Cancel
                </a>
            </div>

        </form>

    </section>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            var box = document.getElementById("h28PledgeDescription");
            var count = document.getElementById("h28PledgeCount");

            if (!box || !count) return;

            function update() {
                count.textContent = box.value.length;
            }

            box.addEventListener("input", update);
            update();
        })();
    </script>
}
