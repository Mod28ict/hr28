@model HR28.Web.Models.Users.UserAccessViewModel

@{
    ViewData["Title"] = "Assign Scope";
}

<div class="ui-page is-narrow">

    <header class="ui-head">
        <div class="ui-head-main">
            <span class="ui-head-icon is-cyan"><partial name="_Icon" model='"globe"' /></span>
            <div>
                <nav class="ui-crumb" aria-label="Breadcrumb">
                    <a asp-action="Index">Users</a> <span aria-hidden="true">/</span> <span>Assign scope</span>
                </nav>
                <h1 class="ui-title">Assign Scope</h1>
                <p class="ui-sub">Configure the geographic area whose records this user can access.</p>
            </div>
        </div>
    </header>

    <section class="ui-card ui-card-lg">

        <form asp-action="AssignScope" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="ui-summary"></div>

            <input asp-for="UserId" type="hidden" />
            <input asp-for="UserName" type="hidden" />

            <div class="ui-field">
                <span class="ui-label">User</span>
                <div class="ui-person" style="padding: 12px 14px; border-radius: 12px; background: var(--ui-subtle);">
                    <span class="ui-avatar" aria-hidden="true"><partial name="_Icon" model='"user"' /></span>
                    <strong>@Model.UserName</strong>
                </div>
            </div>

            <div class="ui-grid-2">
                <div class="ui-field">
                    <label for="ConstituencyDropdown" class="ui-label">Constituency</label>

                    <select asp-for="ConstituencyId"
                            id="ConstituencyDropdown"
                            class="ui-select">
                        <option value="">Select Constituency</option>

                        @foreach (var constituency in Model.Constituencies)
                        {
                            <option value="@constituency.Id">@constituency.Name</option>
                        }
                    </select>

                    <span asp-validation-for="ConstituencyId" class="ui-error"></span>
                </div>

                <div class="ui-field">
                    <label for="IslandDropdown" class="ui-label">
                        Island <span class="ui-optional">(optional)</span>
                    </label>

                    <select asp-for="IslandId"
                            id="IslandDropdown"
                            class="ui-select">
                        <option value="">All islands in constituency</option>

                        @foreach (var island in Model.Islands)
                        {
                            <option value="@island.Id">@island.Name</option>
                        }
                    </select>

                    <div class="ui-hint" id="h28IslandHint">Leave blank to grant access to the entire constituency.</div>

                    <span asp-validation-for="IslandId" class="ui-error"></span>
                </div>
            </div>

            <div class="ui-form-actions">
                <button type="submit" class="ui-btn ui-btn-primary">
                    <partial name="_Icon" model='"check"' />
                    Assign scope
                </button>

                <a asp-action="Index" class="ui-btn ui-btn-secondary">Cancel</a>
            </div>

        </form>

    </section>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {
            const constituencyDropdown = $('#ConstituencyDropdown');
            const islandDropdown = $('#IslandDropdown');
            const hint = $('#h28IslandHint');
            const defaultHint = hint.text();

            function resetIslands() {
                islandDropdown
                    .empty()
                    .append($('<option>').val('').text('All islands in constituency'));
            }

            constituencyDropdown.on('change', function () {
                const constituencyId = $(this).val();

                resetIslands();
                islandDropdown.prop('disabled', true);
                hint.text(defaultHint);

                if (!constituencyId) {
                    return;
                }

                hint.text('Loading islands…');

                $.getJSON('@Url.Action("GetIslands", "Users")', { constituencyId: constituencyId })
                    .done(function (data) {
                        $.each(data, function (_, island) {
                            islandDropdown.append($('<option>').val(island.id).text(island.name));
                        });

                        islandDropdown.prop('disabled', false);
                        hint.text(defaultHint);
                    })
                    .fail(function () {
                        hint.text('Could not load islands. Please try again.');
                    });
            });

            if (!constituencyDropdown.val()) {
                islandDropdown.prop('disabled', true);
            }
        });
    </script>
}
