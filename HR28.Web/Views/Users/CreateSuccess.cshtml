@model HR28.Web.Models.UserCreateViewModel

@{
    ViewData["Title"] = "User Created";

    var code =
        Model?.GeneratedAuthorizationCode
        ?? string.Empty;
}

<div class="ui-page is-narrow" style="max-width: 640px;">

    <section class="ui-card ui-card-lg" style="text-align: center;">

        <span class="ui-head-icon is-green" style="width: 64px; height: 64px; margin: 4px auto 16px; border-radius: 50%;">
            <partial name="_Icon" model='"check"' />
        </span>

        <h1 class="ui-title">User created</h1>
        <p class="ui-sub">The account is ready. Share the authorization code with the user securely.</p>

        <div style="margin: 26px 0 8px;" class="ui-label">Authorization code</div>

        <div id="authCode" class="ui-mono ui-code-box">@code</div>

        <button type="button" id="copyBtn" class="ui-btn ui-btn-secondary" style="margin-top: 14px;">
            <partial name="_Icon" model='"copy"' />
            <span>Copy code</span>
        </button>

        <div class="ui-note is-amber" style="margin: 22px 0; text-align: left;">
            <partial name="_Icon" model='"alert"' />
            <div>
                <strong>Save this code now</strong>
                The user needs it for first login and OTP verification.
            </div>
        </div>

        <div class="ui-form-actions" style="justify-content: center;">
            <a asp-action="Index" class="ui-btn ui-btn-primary">
                <partial name="_Icon" model='"arrow-left"' />
                Back to Users
            </a>

            <a asp-action="Create" class="ui-btn ui-btn-secondary">
                <partial name="_Icon" model='"user-plus"' />
                Create another
            </a>
        </div>

    </section>

</div>

@section Scripts
{
    <script>
        (function () {
            const btn = document.getElementById("copyBtn");
            const label = btn.querySelector("span");
            const code = document.getElementById("authCode");

            btn.addEventListener("click", function () {
                if (!navigator.clipboard) return;

                navigator.clipboard.writeText(code.innerText.trim()).then(function () {
                    label.textContent = "Copied";

                    setTimeout(function () {
                        label.textContent = "Copy code";
                    }, 2000);
                });
            });
        })();
    </script>
}
