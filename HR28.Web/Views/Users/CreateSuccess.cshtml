@model HR28.Web.Models.UserCreateViewModel

@{
    // After creating a user. Authorization codes are never shown to administrators: they go
    // only to the person by SMS (activation and Reset code, owner 2026-10-15).
    ViewData["Title"] = "User Created";
}

<div class="ui-page is-narrow" style="max-width: 640px;">

    <section class="ui-card ui-card-lg" style="text-align: center;">

        <span class="ui-head-icon is-green" style="width: 64px; height: 64px; margin: 4px auto 16px; border-radius: 50%;">
            <partial name="_Icon" model='"check"' />
        </span>

        <h1 class="ui-title">User created</h1>
        <p class="ui-sub">@Model?.User.FullName can't sign in yet. The account is inactive until you finish these steps.</p>

        <ol class="ui-steps-list">
            <li><strong>Give a role.</strong> At least one role is needed before the account can be activated.</li>
            <li><strong>Add an area</strong> (constituency or island), so they can see voters.</li>
            <li><strong>Activate the account.</strong> A welcome SMS with their authorization code is sent to @Model?.User.MobileNumber. Nobody else sees the code.</li>
        </ol>

        <div class="ui-form-actions" style="justify-content: center;">
            <a asp-action="AssignRole" asp-route-id="@Model?.EditId" class="ui-btn ui-btn-primary">Give a role</a>
            <a asp-action="AssignScope" asp-route-id="@Model?.EditId" class="ui-btn ui-btn-secondary">Add an area</a>
            <a asp-action="Index" class="ui-btn ui-btn-ghost">Back to Users</a>
        </div>

    </section>

</div>
