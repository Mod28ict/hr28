@model HR28.Web.Models.Users.UserAccessViewModel

@{
    ViewData["Title"] = "Assign Role";
}

<div class="ui-page is-narrow">

    <header class="ui-head">
        <div class="ui-head-main">
            <span class="ui-head-icon is-violet"><partial name="_Icon" model='"shield"' /></span>
            <div>
                <nav class="ui-crumb" aria-label="Breadcrumb">
                    <a asp-action="Index">Users</a> <span aria-hidden="true">/</span> <span>Assign role</span>
                </nav>
                <h1 class="ui-title">Assign Role</h1>
                <p class="ui-sub">Roles decide what a user can do. Their scope decides which records it applies to.</p>
            </div>
        </div>
    </header>

    <section class="ui-card ui-card-lg">

        <form method="post">

            <input asp-for="UserId" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="ui-summary"></div>

            <div class="ui-field">
                <span class="ui-label">User</span>
                <div class="ui-person" style="padding: 12px 14px; border-radius: 12px; background: var(--ui-subtle);">
                    <span class="ui-avatar" aria-hidden="true"><partial name="_Icon" model='"user"' /></span>
                    <strong>@Model.UserName</strong>
                </div>
            </div>

            <div class="ui-field">
                <label asp-for="RoleId" class="ui-label">Role</label>

                <select asp-for="RoleId" class="ui-select">
                    <option value="">Select Role</option>

                    @foreach (var role in Model.Roles)
                    {
                        <option value="@role.Id">@role.Name</option>
                    }
                </select>

                <span asp-validation-for="RoleId" class="ui-error"></span>
            </div>

            <div class="ui-form-actions">
                <button type="submit" class="ui-btn ui-btn-primary">
                    <partial name="_Icon" model='"check"' />
                    Save role
                </button>

                <a asp-action="Index" class="ui-btn ui-btn-secondary">Cancel</a>
            </div>

        </form>

    </section>

</div>
