@model List<HR28.Web.Models.Users.UserDto>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Users</h2>
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

        <a asp-action="Create"
           class="btn btn-primary">
            Create User
        </a>
    </div>

    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>Full Name</th>
                <th>National ID</th>
                <th>Mobile Number</th>
                <th>Email</th>
                <th>Designation</th>
                <th>Role</th>

                <th>Scope</th>

                <th>Authorization Code</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.NationalId</td>
                    <td>@user.MobileNumber</td>
                    <td>@user.Email</td>
                    <td>@user.Designation</td>
                    <td>
                        @(string.IsNullOrWhiteSpace(user.RoleName)
                            ? "-"
                            : user.RoleName)
                    </td>

                    <td>
                        @if (!string.IsNullOrWhiteSpace(
                                user.ConstituencyName))
                        {
                            @user.ConstituencyName

                            @if (!string.IsNullOrWhiteSpace(
                                    user.IslandName))
                            {
                                <text> / @user.IslandName</text>
                            }
                        }
                        else
                        {
                            <text>-</text>
                        }
                    </td>

                    <td>
                        <code>@user.AuthorizationCode</code>
                    </td>
                    <td>
                        @(user.IsActive
                            ? "Active"
                            : "Inactive")
                    </td>
                    <td>

                        <a asp-action="AssignRole"
                           asp-route-id="@user.Id"
                           class="btn btn-sm btn-warning">
                            Edit Role
                        </a>

                        <a asp-action="AssignScope"
                           asp-route-id="@user.Id"
                           class="btn btn-sm btn-info">
                            Edit Scope
                        </a>

                </td>
                </tr>
            }

        </tbody>

    </table>

</div>
