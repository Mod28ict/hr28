@model HR28.Web.Models.Users.UserPageModel

@{
    ViewData["Title"] = "Users";

    var users = Model.Items;

    // Totals count every user, not just this page.
    var totalUsers = Model.TotalUsers;
    var activeUsers = Model.ActiveUsers;
    var inactiveUsers = Model.InactiveUsers;
    var unassigned = Model.NoRoleUsers;

    var search = ViewBag.Search as string;
    var status = ViewBag.Status as string;
    var errorMessage = ViewBag.ErrorMessage as string;
    var filtered = !string.IsNullOrWhiteSpace(search) || status != null;

    // Page links keep the search, status and page size.
    Dictionary<string, string> PageRoute(int pageNumber)
    {
        var values = new Dictionary<string, string> { ["page"] = pageNumber.ToString(), ["pageSize"] = Model.PageSize.ToString() };
        if (!string.IsNullOrWhiteSpace(search)) values["search"] = search;
        if (status != null) values["status"] = status;
        return values;
    }

    var startRecord = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
    var endRecord = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
    var firstVisiblePage = Math.Max(1, Model.Page - 2);
    var lastVisiblePage = Math.Min(Model.TotalPages, Model.Page + 2);

    // You can't delete your own account (the API checks this too).
    var myId = Context.Session.GetString("UserId");

    string InitialsOf(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
}

<div class="ui-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="ui-alert is-green" role="status">
            <partial name="_Icon" model='"check-circle"' />
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <header class="ui-head">
        <div class="ui-head-main">
            <span class="ui-head-icon is-blue"><partial name="_Icon" model='"user"' /></span>
            <div>
                <nav class="ui-crumb" aria-label="Breadcrumb"><span>Administration</span></nav>
                <h1 class="ui-title">Users</h1>
                <p class="ui-sub">Manage platform accounts, roles and access scopes.</p>
            </div>
        </div>

        <div class="ui-head-actions">
            <a asp-action="Create" class="ui-btn ui-btn-primary">
                <partial name="_Icon" model='"user-plus"' />
                Create user
            </a>
        </div>
    </header>

    <section class="ui-stats">
        <div class="ui-stat is-blue">
            <span class="ui-stat-icon"><partial name="_Icon" model='"users"' /></span>
            <div>
                <div class="ui-stat-label">Total users</div>
                <div class="ui-stat-value">@totalUsers.ToString("N0")</div>
            </div>
        </div>
        <div class="ui-stat is-green">
            <span class="ui-stat-icon"><partial name="_Icon" model='"user-check"' /></span>
            <div>
                <div class="ui-stat-label">Active</div>
                <div class="ui-stat-value">@activeUsers.ToString("N0")</div>
            </div>
        </div>
        <div class="ui-stat is-red">
            <span class="ui-stat-icon"><partial name="_Icon" model='"user-x"' /></span>
            <div>
                <div class="ui-stat-label">Inactive</div>
                <div class="ui-stat-value">@inactiveUsers.ToString("N0")</div>
            </div>
        </div>
        <div class="ui-stat is-amber">
            <span class="ui-stat-icon"><partial name="_Icon" model='"shield"' /></span>
            <div>
                <div class="ui-stat-label">No role assigned</div>
                <div class="ui-stat-value">@unassigned.ToString("N0")</div>
            </div>
        </div>
    </section>

    <section class="ui-card">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="ui-alert is-red" role="alert">
                <partial name="_Icon" model='"alert"' />
                <span>@errorMessage</span>
            </div>
        }

        <form asp-action="Index" method="get" role="search" class="ui-toolbar">
            <div class="ui-search">
                <partial name="_Icon" model='"search"' />
                <label for="h28UserSearch" class="visually-hidden">Search users</label>
                <input type="search"
                       id="h28UserSearch"
                       name="search"
                       value="@search"
                       maxlength="100"
                       class="ui-input"
                       placeholder="Search by name, ID card, phone, role or area" />
            </div>

            <label for="h28UserStatus" class="visually-hidden">Status</label>
            <select id="h28UserStatus" name="status" class="ui-select" style="flex: 0 0 160px;">
                <option value="">All statuses</option>
                <option value="active" selected="@(status == "active")">Active</option>
                <option value="inactive" selected="@(status == "inactive")">Inactive</option>
            </select>

            <label for="h28UserPageSize" class="visually-hidden">Users per page</label>
            <select id="h28UserPageSize" name="pageSize" class="ui-select" style="flex: 0 0 130px;">
                @foreach (var size in new[] { 10, 20, 50, 100 })
                {
                    <option value="@size" selected="@(Model.PageSize == size)">@size per page</option>
                }
            </select>

            <button type="submit" class="ui-btn ui-btn-secondary">Search</button>
            @if (filtered)
            {
                <a asp-action="Index" asp-route-pageSize="@Model.PageSize" class="ui-btn ui-btn-ghost">Clear</a>
            }
        </form>

        @if (!users.Any())
        {
            <div class="ui-empty" role="status">
                <partial name="_Icon" model='"users"' />
                @if (filtered)
                {
                    <strong>No users match your search</strong>
                    <span>Check the spelling, or clear the search to see everyone.</span>
                    <a asp-action="Index" asp-route-pageSize="@Model.PageSize" class="ui-btn ui-btn-secondary ui-btn-sm" style="margin-top: 6px;">Clear search</a>
                }
                else if (Model.TotalCount == 0 && Model.TotalUsers == 0 && errorMessage == null)
                {
                    <span>No users created yet.</span>
                }
                else
                {
                    <span>There are no users on this page.</span>
                    <a asp-action="Index" asp-route-pageSize="@Model.PageSize" class="ui-btn ui-btn-secondary ui-btn-sm" style="margin-top: 6px;">Go to the first page</a>
                }
            </div>
        }
        else
        {
            <div class="ui-meta">
                Showing <strong>@startRecord.ToString("N0")</strong>
                to <strong>@endRecord.ToString("N0")</strong>
                of <strong>@Model.TotalCount.ToString("N0")</strong> @(Model.TotalCount == 1 ? "user" : "users")
            </div>

            <div class="ui-table-wrap">
                <table class="ui-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>National ID</th>
                            <th>Contact</th>
                            <th>Roles</th>
                            <th>Areas</th>
                            <th>Status</th>
                            <th><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>

                    <tbody id="h28UserBody">
                        @foreach (var user in users)
                        {
                            var name = string.IsNullOrWhiteSpace(user.FullName) ? "Unnamed user" : user.FullName;

                            var roles = user.Roles.Count > 0
                                ? user.Roles
                                : (string.IsNullOrWhiteSpace(user.RoleName) ? new List<string>() : new List<string> { user.RoleName });

                            string RoleTone(string role)
                            {
                                var key = role.ToLowerInvariant();
                                return key.Contains("super") ? "is-violet" :
                                       key.Contains("national") ? "is-blue" :
                                       key.Contains("reporter") ? "is-cyan" :
                                       "is-muted";
                            }

                            var isAdminUser = HR28.Web.Services.Hr28Roles.IsAdministrator(
                                HR28.Web.Services.Hr28Roles.ToSession(roles));

                            <tr>
                                <td>
                                    <div class="ui-person" style="min-width: 200px;">
                                        <span class="ui-avatar" aria-hidden="true">@InitialsOf(name)</span>
                                        <span>
                                            <strong>@name</strong>
                                            @if (!string.IsNullOrWhiteSpace(user.Designation))
                                            {
                                                <small>@user.Designation</small>
                                            }
                                        </span>
                                    </div>
                                </td>

                                <td class="ui-num ui-muted" style="white-space: nowrap;">@user.NationalId</td>

                                <td style="min-width: 160px;">
                                    <div class="ui-num">@user.MobileNumber</div>
                                    @if (!string.IsNullOrWhiteSpace(user.Email))
                                    {
                                        <div class="ui-muted" style="font-size: 12px;">@user.Email</div>
                                    }
                                </td>

                                <td>
                                    <div class="ui-chip-row">
                                        @if (!roles.Any())
                                        {
                                            <span class="ui-pill is-amber">No role</span>
                                        }
                                        @foreach (var r in roles)
                                        {
                                            <span class="ui-pill @RoleTone(r)">@HR28.Web.Services.Hr28Roles.DisplayName(r)</span>
                                        }
                                    </div>
                                </td>

                                <td style="min-width: 160px;">
                                    @if (isAdminUser && !user.Scopes.Any())
                                    {
                                        <span class="ui-muted">All areas</span>
                                    }
                                    else if (!user.Scopes.Any())
                                    {
                                        <span class="ui-faint">Not assigned</span>
                                    }
                                    else
                                    {
                                        foreach (var s in user.Scopes.Take(2))
                                        {
                                            <div style="font-size: 13px;">@s.Label</div>
                                        }
                                        if (user.Scopes.Count > 2)
                                        {
                                            <a asp-action="AssignScope" asp-route-id="@user.Id" class="ui-link" style="font-size: 12px;">+@(user.Scopes.Count - 2) more</a>
                                        }
                                    }
                                </td>

                                <td>
                                    @if (string.Equals(user.Id.ToString(), myId, StringComparison.OrdinalIgnoreCase))
                                    {
                                        @* Your own account can't be switched off from here. *@
                                        <span class="ui-pill @(user.IsActive ? "is-green" : "is-red")">
                                            @(user.IsActive ? "Active" : "Inactive")
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="ui-status-btn h28-active-btn"
                                                title="Change whether @name can sign in"
                                                data-id="@user.Id"
                                                data-name="@name"
                                                data-active="@(user.IsActive ? "true" : "false")">
                                            <span class="ui-pill @(user.IsActive ? "is-green" : "is-red")">
                                                @(user.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </button>
                                    }
                                </td>

                                <td>
                                    <div style="display: flex; gap: 6px; white-space: nowrap;">
                                        <a asp-action="Edit"
                                           asp-route-id="@user.Id"
                                           class="ui-btn ui-btn-secondary ui-btn-sm"
                                           title="Edit @name's details">
                                            <partial name="_Icon" model='"edit"' />
                                            Edit
                                        </a>

                                        <a asp-action="AssignRole"
                                           asp-route-id="@user.Id"
                                           class="ui-btn ui-btn-soft is-violet ui-btn-sm">
                                            Roles
                                        </a>

                                        <a asp-action="AssignScope"
                                           asp-route-id="@user.Id"
                                           class="ui-btn ui-btn-soft is-cyan ui-btn-sm">
                                            Areas
                                        </a>

                                        <form asp-action="ResetCode"
                                              method="post"
                                              class="h28-reset-form"
                                              data-name="@name">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <input type="hidden" name="name" value="@name" />
                                            <button type="submit" class="ui-btn ui-btn-soft is-amber ui-btn-sm" title="Issue a new authorization code">
                                                <partial name="_Icon" model='"key"' />
                                                Reset code
                                            </button>
                                        </form>

                                        @if (!string.Equals(user.Id.ToString(), myId, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <form asp-action="Delete"
                                                  asp-route-id="@user.Id"
                                                  method="post"
                                                  class="h28-delete-user"
                                                  data-name="@name">
                                                <button type="submit" class="ui-btn ui-btn-ghost ui-btn-sm ui-btn-danger" aria-label="Delete @name" title="Delete @name">
                                                    <partial name="_Icon" model='"trash"' />
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        }

        @if (Model.TotalPages > 1)
        {
            <nav class="ui-pager" aria-label="Users pagination">

                @if (Model.HasPreviousPage)
                {
                    <a class="ui-page-btn"
                       asp-action="Index"
                       asp-all-route-data="PageRoute(Model.Page - 1)">‹ Previous</a>
                }
                else
                {
                    <span class="ui-page-btn is-disabled">‹ Previous</span>
                }

                @if (firstVisiblePage > 1)
                {
                    <a class="ui-page-btn"
                       asp-action="Index"
                       asp-all-route-data="PageRoute(1)">1</a>

                    if (firstVisiblePage > 2)
                    {
                        <span class="ui-page-btn is-disabled">…</span>
                    }
                }

                @for (var pageNumber = firstVisiblePage; pageNumber <= lastVisiblePage; pageNumber++)
                {
                    if (pageNumber == Model.Page)
                    {
                        <span class="ui-page-btn is-current" aria-current="page">@pageNumber</span>
                    }
                    else
                    {
                        <a class="ui-page-btn"
                           asp-action="Index"
                           asp-all-route-data="PageRoute(pageNumber)">@pageNumber</a>
                    }
                }

                @if (lastVisiblePage < Model.TotalPages)
                {
                    if (lastVisiblePage < Model.TotalPages - 1)
                    {
                        <span class="ui-page-btn is-disabled">…</span>
                    }

                    <a class="ui-page-btn"
                       asp-action="Index"
                       asp-all-route-data="PageRoute(Model.TotalPages)">@Model.TotalPages.ToString("N0")</a>
                }

                @if (Model.HasNextPage)
                {
                    <a class="ui-page-btn"
                       asp-action="Index"
                       asp-all-route-data="PageRoute(Model.Page + 1)">Next ›</a>
                }
                else
                {
                    <span class="ui-page-btn is-disabled">Next ›</span>
                }

            </nav>
        }

    </section>

</div>

<dialog id="h28ActiveDialog" class="ui-dialog" aria-labelledby="h28ActiveTitle">
    <form asp-action="SetActive" method="post" class="ui-dialog-body">
        <input type="hidden" name="id" id="h28ActiveId" />
        <input type="hidden" name="name" id="h28ActiveName" />

        <h2 id="h28ActiveTitle" class="ui-dialog-title">Account status</h2>
        <p class="ui-muted" id="h28ActiveWho"></p>

        <div class="ui-status-choices" role="radiogroup" aria-labelledby="h28ActiveTitle">
            <label class="ui-status-choice">
                <input type="radio" name="isActive" value="true" />
                <span class="ui-pill is-green">Active</span>
                <small class="ui-muted">Can sign in and work as their roles allow.</small>
            </label>
            <label class="ui-status-choice">
                <input type="radio" name="isActive" value="false" />
                <span class="ui-pill is-red">Inactive</span>
                <small class="ui-muted">Can't sign in; signed out on their next click. Their records are kept.</small>
            </label>
        </div>

        <div class="ui-form-actions">
            <button type="submit" class="ui-btn ui-btn-primary">Save status</button>
            <button type="button" class="ui-btn ui-btn-secondary" id="h28ActiveCancel">Cancel</button>
        </div>
    </form>
</dialog>

@section Scripts
{
    <script>
        (function () {
            // Status pop-up: click Active / Inactive to change it.
            var activeDialog = document.getElementById("h28ActiveDialog");

            document.querySelectorAll(".h28-active-btn").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    document.getElementById("h28ActiveId").value = btn.dataset.id;
                    document.getElementById("h28ActiveName").value = btn.dataset.name;
                    document.getElementById("h28ActiveWho").textContent = btn.dataset.name;
                    activeDialog.querySelectorAll('input[name="isActive"]').forEach(function (r) {
                        r.checked = r.value === btn.dataset.active;
                    });
                    activeDialog.showModal();
                });
            });

            document.getElementById("h28ActiveCancel").addEventListener("click", function () { activeDialog.close(); });

            // Deleting is permanent: say so first.
            document.querySelectorAll(".h28-delete-user").forEach(function (form) {
                form.addEventListener("submit", function (e) {
                    var ok = window.confirm(
                        "Permanently delete " + form.dataset.name + "?\n\n" +
                        "This cannot be undone. If they have recorded encounters or pledges, " +
                        "the account can't be deleted; deactivate it instead (Edit → Account is active).");

                    if (!ok) {
                        e.preventDefault();
                        e.stopImmediatePropagation();
                    }
                });
            });

            // Confirm before issuing a new code (the old one stops working at once).
            document.querySelectorAll(".h28-reset-form").forEach(function (form) {
                form.addEventListener("submit", function (e) {
                    var ok = window.confirm(
                        "Issue a new authorization code for " + form.dataset.name + "?\n\n" +
                        "Their current code will stop working immediately. " +
                        "You will see the new code once, so be ready to give it to them.");

                    if (!ok) {
                        e.preventDefault();
                        e.stopImmediatePropagation();
                    }
                });
            });
        })();
    </script>
}
