@model HR28.Web.Models.UserCreateViewModel

@{
    // The same form creates and edits a user.
    var title = Model.IsEdit ? "Edit User" : "Create User";
    ViewData["Title"] = title;
}

<div class="ui-page is-narrow">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="ui-alert is-green" role="status">
            <partial name="_Icon" model='"check-circle"' />
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <header class="ui-head">
        <div class="ui-head-main">
            <span class="ui-head-icon is-blue"><partial name="_Icon" model='@(Model.IsEdit ? "edit" : "user-plus")' /></span>
            <div>
                <nav class="ui-crumb" aria-label="Breadcrumb">
                    <a asp-action="Index">Users</a> <span aria-hidden="true">/</span> <span>@(Model.IsEdit ? "Edit user" : "Create user")</span>
                </nav>
                <h1 class="ui-title">@title</h1>
                <p class="ui-sub">
                    @(Model.IsEdit
                        ? "Change this person's details. Every change is recorded in the audit trail."
                        : "Create a secure platform account before assigning its role and geographic access scope.")
                </p>
            </div>
        </div>
    </header>

    <section class="ui-card ui-card-lg">

        <form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.EditId" method="post" id="h28CreateUserForm">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="ui-summary"></div>

            <!-- 1. IDENTITY -->
            <div class="ui-section">
                <div class="ui-section-head">
                    <span class="ui-step">1</span>
                    <div>
                        <div class="ui-section-title">Identity</div>
                        <div class="ui-section-sub">Official identification and the user's full name</div>
                    </div>
                </div>

                <div class="ui-grid-2">
                    <div class="ui-field">
                        <label asp-for="User.NationalId" class="ui-label">National ID</label>
                        <input asp-for="User.NationalId"
                               id="h28UserNationalId"
                               class="ui-input ui-upper"
                               maxlength="7"
                               placeholder="A123456"
                               autocomplete="off" />
                        <span asp-validation-for="User.NationalId" class="ui-error"></span>
                    </div>

                    <div class="ui-field">
                        <label asp-for="User.Designation" class="ui-label">
                            Designation <span class="ui-optional">(optional)</span>
                        </label>
                        <input asp-for="User.Designation"
                               class="ui-input"
                               placeholder="Example: Constituency Coordinator" />
                        <span asp-validation-for="User.Designation" class="ui-error"></span>
                    </div>

                    <div class="ui-field ui-full">
                        <label asp-for="User.FullName" class="ui-label">Full name</label>
                        <input asp-for="User.FullName"
                               class="ui-input"
                               placeholder="Enter the user's full name" />
                        <span asp-validation-for="User.FullName" class="ui-error"></span>
                    </div>
                </div>
            </div>

            <!-- 2. CONTACT -->
            <div class="ui-section">
                <div class="ui-section-head">
                    <span class="ui-step">2</span>
                    <div>
                        <div class="ui-section-title">Contact information</div>
                        <div class="ui-section-sub">Contact details used for account communication</div>
                    </div>
                </div>

                <div class="ui-grid-2">
                    <div class="ui-field">
                        <label asp-for="User.MobileNumber" class="ui-label">Mobile number</label>
                        <input asp-for="User.MobileNumber"
                               class="ui-input h28-digits-only"
                               inputmode="numeric"
                               autocomplete="tel"
                               maxlength="7"
                               pattern="\d{7}"
                               title="7 digits, e.g. 7771234"
                               placeholder="7XXXXXX" />
                        <span asp-validation-for="User.MobileNumber" class="ui-error"></span>
                    </div>

                    <div class="ui-field">
                        <label asp-for="User.Email" class="ui-label">
                            Email <span class="ui-optional">(optional)</span>
                        </label>
                        <input asp-for="User.Email"
                               class="ui-input"
                               type="email"
                               inputmode="email"
                               autocomplete="email"
                               placeholder="name@example.com" />
                        <span asp-validation-for="User.Email" class="ui-error"></span>
                    </div>

                    <div class="ui-field ui-full">
                        <label asp-for="User.Address" class="ui-label">
                            Address <span class="ui-optional">(optional)</span>
                        </label>
                        <textarea asp-for="User.Address"
                                  id="h28UserAddress"
                                  class="ui-textarea"
                                  maxlength="500"
                                  placeholder="House name, street and island"></textarea>
                        <div class="ui-counter"><span id="h28AddressCount">0</span> / 500</div>
                        <span asp-validation-for="User.Address" class="ui-error"></span>
                    </div>
                </div>
            </div>

            <!-- 3. ADMINISTRATION -->
            <div class="ui-section">
                <div class="ui-section-head">
                    <span class="ui-step">3</span>
                    <div>
                        <div class="ui-section-title">Administration</div>
                        <div class="ui-section-sub">Internal notes and the next access-control steps</div>
                    </div>
                </div>

                <div class="ui-field">
                    <label asp-for="User.Remarks" class="ui-label">
                        Remarks <span class="ui-optional">(optional)</span>
                    </label>
                    <textarea asp-for="User.Remarks"
                              id="h28UserRemarks"
                              class="ui-textarea"
                              maxlength="1000"
                              placeholder="Add relevant administrative notes"></textarea>
                    <div class="ui-counter"><span id="h28RemarksCount">0</span> / 1000</div>
                    <span asp-validation-for="User.Remarks" class="ui-error"></span>
                </div>

                @if (Model.IsEdit)
                {
                    <div class="ui-field">
                        <label class="ui-check-card" for="h28UserActive">
                            <input type="checkbox" id="h28UserActive" name="IsActive" value="true" checked="@Model.IsActive" />
                            <span>
                                <strong>Account is active</strong>
                                <small>Untick to stop this person signing in. They are signed out on their next click; records they made are kept.</small>
                            </span>
                        </label>
                        <input type="hidden" name="IsActive" value="false" />
                    </div>

                    <div class="ui-note is-amber">
                        <partial name="_Icon" model='"info"' />
                        <div>
                            <strong>Changing the mobile number</strong>
                            Sign-in codes go to this number, so a change is recorded in the audit trail and an SMS warning
                            is sent to the old number. Roles and areas are changed from the Users list.
                        </div>
                    </div>
                }
                else
                {
                    <div class="ui-note">
                        <partial name="_Icon" model='"shield"' />
                        <div>
                            <strong>Role and scope are assigned separately</strong>
                            After creating the account, return to the Users page and assign both a role and a
                            geographic scope. The generated authorization code will be displayed on the next screen.
                        </div>
                    </div>
                }
            </div>

            <div class="ui-form-actions">
                <button type="submit" class="ui-btn ui-btn-primary">
                    <partial name="_Icon" model='"check"' />
                    @(Model.IsEdit ? "Save changes" : "Create user")
                </button>

                <a asp-action="Index" class="ui-btn ui-btn-secondary">Cancel</a>
            </div>

        </form>

    </section>

    @if (Model.IsEdit)
    {
        <section class="ui-card" aria-labelledby="h28DevicesTitle">
            <div class="ui-card-head">
                <h2 id="h28DevicesTitle">Remembered devices</h2>
            </div>

            @if (Model.RememberedDevices > 0)
            {
                <p class="ui-muted" style="margin: 0 0 12px;">
                    @Model.User.FullName ticked "Remember me" on
                    <strong>@Model.RememberedDevices @(Model.RememberedDevices == 1 ? "device" : "devices")</strong>,
                    so they only need the SMS code there. Forget them if a phone or computer is lost, shared or replaced.
                    Resetting their authorization code also forgets them.
                </p>

                <form asp-action="ForgetDevices" asp-route-id="@Model.EditId" method="post" class="h28-confirm"
                      data-confirm="Forget all remembered devices of @Model.User.FullName? They will need their authorization code again on every device.">
                    <input type="hidden" name="name" value="@Model.User.FullName" />
                    <button type="submit" class="ui-btn ui-btn-secondary">
                        <partial name="_Icon" model='"key"' />
                        Forget remembered devices
                    </button>
                </form>
            }
            else
            {
                <p class="ui-muted" style="margin: 0;">No remembered devices. This person enters their authorization code every time.</p>
            }
        </section>
    }

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Asks first (the text comes from data-confirm, never from script).
        document.querySelectorAll('form.h28-confirm').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                if (!window.confirm(form.dataset.confirm)) e.preventDefault();
            });
        });
    </script>

    <script>
        (function () {
            const nationalId = document.getElementById("h28UserNationalId");

            if (nationalId) {
                nationalId.addEventListener("input", function () {
                    const position = nationalId.selectionStart;
                    nationalId.value = nationalId.value.toUpperCase();
                    nationalId.setSelectionRange(position, position);
                });
            }

            function configureCounter(field, counter) {
                if (!field || !counter) {
                    return;
                }

                function updateCounter() {
                    counter.textContent = field.value.length;
                }

                field.addEventListener("input", updateCounter);
                updateCounter();
            }

            configureCounter(document.getElementById("h28UserAddress"), document.getElementById("h28AddressCount"));
            configureCounter(document.getElementById("h28UserRemarks"), document.getElementById("h28RemarksCount"));
        })();
    </script>
}
