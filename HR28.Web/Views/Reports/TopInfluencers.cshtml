@model List<HR28.Web.Models.TopInfluencerDto>

@{
    ViewData["Title"] = "Top Influencers";

    var rows = Model ?? new List<HR28.Web.Models.TopInfluencerDto>();
}

<div class="ui-page">

    <header class="ui-head">
        <div class="ui-head-main">
            <span class="ui-head-icon is-violet"><partial name="_Icon" model='"star"' /></span>
            <div>
                <nav class="ui-crumb" aria-label="Breadcrumb"><a asp-action="Index">Reports</a> <span aria-hidden="true">/</span> <span>Influencers</span></nav>
                <h1 class="ui-title">Top Influencers</h1>
                <p class="ui-sub">Influencers ranked by the number of voters linked to them.</p>
            </div>
        </div>
        <div class="ui-head-actions">
            <partial name="_ScopeChip" model="(bool)(ViewBag.IsAdministrator ?? false)" />
        </div>
    </header>

    <section class="ui-card">
        @if (!rows.Any())
        {
            <div class="ui-empty">
                <partial name="_Icon" model='"star"' />
                No influencers have linked voters yet.
            </div>
        }
        else
        {
            <div class="ui-table-wrap">
                <table class="ui-table">
                    <thead>
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>Name</th>
                            <th class="is-right">Linked voters</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var rank = 0; }
                        @foreach (var item in rows)
                        {
                            rank++;
                            <tr>
                                <td class="ui-num ui-muted">@rank</td>
                                <td class="ui-strong">@item.FullName</td>
                                <td class="ui-num is-right">@item.LinkedVoters</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

</div>
