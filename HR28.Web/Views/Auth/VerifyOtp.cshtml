@model HR28.Web.Models.Auth.VerifyOtpRequest

<h2>Verify OTP</h2>

<form method="post">

    <div class="mb-3">
        <label>Authorization Code</label>

        <input asp-for="AuthorizationCode"
               class="form-control"
               value="@TempData["AuthorizationCode"]" />
    </div>

    <div class="mb-3">
        <label>OTP Code</label>

        <input asp-for="OtpCode"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-success">
        Verify OTP
    </button>

</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mt-3">
        @ViewBag.Error
    </div>
}