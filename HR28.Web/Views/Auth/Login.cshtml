@model HR28.Web.Models.Auth.GenerateOtpRequest

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>HR28 | Secure Login</title>

    <style>

        :root {
            --primary: #2563eb;
            --primary-light: #60a5fa;
            --primary-dark: #1d4ed8;
            --navy: #071426;
            --navy-light: #102947;
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --border: #dbe4ef;
            --danger: #dc2626;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
            margin: 0;
        }

        body {
            min-height: 100vh;
            font-family: "Segoe UI", Arial, sans-serif;
            color: var(--text-dark);
            background: #f8fafc;
        }

        button,
        input {
            font-family: inherit;
        }

        .auth-page {
            display: grid;
            grid-template-columns: minmax(0, 1.15fr) minmax(460px, 0.85fr);
            min-height: 100vh;
        }

        /* Left hero section */

        .hero-panel {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 100vh;
            padding: 48px 64px;
            overflow: hidden;
            color: white;
            background:
                radial-gradient(
                    circle at 18% 18%,
                    rgba(59, 130, 246, 0.30),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 80% 78%,
                    rgba(14, 165, 233, 0.18),
                    transparent 34%
                ),
                linear-gradient(
                    145deg,
                    #061323 0%,
                    #0a1e37 52%,
                    #123f78 100%
                );
        }

        .hero-panel::before {
            content: "";
            position: absolute;
            inset: 0;
            opacity: 0.18;
            background-image:
                linear-gradient(
                    rgba(255, 255, 255, 0.05) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    90deg,
                    rgba(255, 255, 255, 0.05) 1px,
                    transparent 1px
                );
            background-size: 70px 70px;
            pointer-events: none;
        }

        .hero-panel::after {
            content: "";
            position: absolute;
            width: 470px;
            height: 470px;
            right: -180px;
            bottom: -190px;
            border: 1px solid rgba(255, 255, 255, 0.10);
            border-radius: 50%;
            box-shadow:
                0 0 0 70px rgba(255, 255, 255, 0.025),
                0 0 0 140px rgba(255, 255, 255, 0.018);
            pointer-events: none;
        }

        .brand,
        .hero-content,
        .hero-footer {
            position: relative;
            z-index: 1;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .brand-mark {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            border-radius: 15px;
            color: white;
            font-size: 18px;
            font-weight: 800;
            letter-spacing: -1px;
            background: linear-gradient(
                135deg,
                var(--primary),
                var(--primary-light)
            );
            box-shadow: 0 12px 30px rgba(37, 99, 235, 0.35);
        }

        .brand-name {
            font-size: 22px;
            font-weight: 800;
            letter-spacing: 0.2px;
        }

        .brand-caption {
            margin-top: 2px;
            color: #a9bfd8;
            font-size: 12px;
        }

.hero-content {
    max-width: 680px;
    margin: 60px 0;

    animation: fadeInUp .8s ease;
}

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 25px;
            padding: 9px 14px;
            border: 1px solid rgba(147, 197, 253, 0.22);
            border-radius: 999px;
            color: #bfdbfe;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.9px;
            text-transform: uppercase;
            background: rgba(37, 99, 235, 0.10);
        }

        .eyebrow-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #60a5fa;
            box-shadow: 0 0 14px #60a5fa;
        }

        .hero-title {
            max-width: 650px;
            margin: 0;
            font-size: clamp(44px, 5vw, 72px);
            line-height: 1.03;
            letter-spacing: -3px;
            font-weight: 780;
        }

        .hero-title span {
            color: #7db4ff;
        }

        .hero-description {
            max-width: 590px;
            margin: 25px 0 0;
            color: #b7cae0;
            font-size: 18px;
            line-height: 1.75;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
            max-width: 620px;
            margin-top: 38px;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 12px;
            min-height: 58px;
            padding: 13px 15px;
            border: 1px solid rgba(255, 255, 255, 0.09);
            border-radius: 15px;
            color: #e5effb;
            font-size: 14px;
            font-weight: 600;
            background: rgba(255, 255, 255, 0.045);
            backdrop-filter: blur(10px);
        }

        .feature-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 31px;
            width: 31px;
            height: 31px;
            border-radius: 10px;
            color: #bfdbfe;
            background: rgba(59, 130, 246, 0.18);
        }

        .feature-icon svg {
            width: 16px;
            height: 16px;
        }

        .hero-footer {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #829bb7;
            font-size: 12px;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #22c55e;
            box-shadow: 0 0 12px rgba(34, 197, 94, 0.75);
        }

        /* Right login section */

        .login-panel {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 50px;
            background:
                radial-gradient(
                    circle at 100% 0%,
                    rgba(219, 234, 254, 0.65),
                    transparent 34%
                ),
                #f8fafc;
        }

.login-wrapper {
    width: 100%;
    max-width: 440px;

    animation: fadeInRight .9s ease;
}


        .mobile-brand {
            display: none;
            align-items: center;
            gap: 12px;
            margin-bottom: 45px;
        }

        .login-heading {
            margin: 0;
            color: #0f172a;
            font-size: 40px;
            line-height: 1.13;
            letter-spacing: -1.4px;
            font-weight: 760;
        }

        .login-description {
            margin: 14px 0 35px;
            color: var(--text-muted);
            font-size: 15px;
            line-height: 1.6;
        }

        .security-notice {
            display: flex;
            gap: 12px;
            align-items: flex-start;
            margin-bottom: 28px;
            padding: 15px 16px;
            border: 1px solid #dbeafe;
            border-radius: 14px;
            background: #eff6ff;
        }

        .security-notice-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 34px;
            width: 34px;
            height: 34px;
            border-radius: 10px;
            color: var(--primary);
            background: white;
            box-shadow: 0 6px 16px rgba(37, 99, 235, 0.10);
        }

        .security-notice-icon svg {
            width: 17px;
            height: 17px;
        }

        .security-notice-title {
            margin-bottom: 3px;
            color: #1e3a8a;
            font-size: 13px;
            font-weight: 750;
        }

        .security-notice-text {
            color: #557099;
            font-size: 12px;
            line-height: 1.5;
        }

        .form-group {
            margin-bottom: 22px;
        }

        .form-label {
            display: block;
            margin-bottom: 9px;
            color: #334155;
            font-size: 13px;
            font-weight: 700;
        }

        .input-shell {
            position: relative;
        }

        .input-icon {
            position: absolute;
            top: 50%;
            left: 17px;
            width: 19px;
            height: 19px;
            color: #94a3b8;
            transform: translateY(-50%);
            pointer-events: none;
            transition: color 0.2s ease;
        }

        .form-control {
            display: block;
            width: 100%;
            height: 60px;
            padding: 0 48px 0 50px;
            border: 1px solid var(--border);
            border-radius: 14px;
            outline: none;
            color: #0f172a;
            font-size: 15px;
            background: white;
            box-shadow: 0 6px 22px rgba(15, 23, 42, 0.035);
            transition:
                border-color 0.2s ease,
                box-shadow 0.2s ease,
                transform 0.2s ease;
        }

        .form-control::placeholder {
            color: #a0aec0;
        }

        .form-control:hover {
            border-color: #b9c8da;
        }

        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.11);
        }

        .input-shell:focus-within .input-icon {
            color: var(--primary);
        }

        .clear-button {
            position: absolute;
            top: 50%;
            right: 14px;
            display: none;
            align-items: center;
            justify-content: center;
            width: 30px;
            height: 30px;
            padding: 0;
            border: 0;
            border-radius: 9px;
            color: #94a3b8;
            background: transparent;
            cursor: pointer;
            transform: translateY(-50%);
        }

        .clear-button:hover {
            color: #475569;
            background: #f1f5f9;
        }

        .clear-button svg {
            width: 16px;
            height: 16px;
        }

        .field-validation-error {
            display: block;
            margin-top: 8px;
            color: var(--danger);
            font-size: 13px;
        }

        .input-validation-error {
            border-color: #ef4444;
        }

        .alert-error {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 22px;
            padding: 14px 15px;
            border: 1px solid #fecaca;
            border-radius: 13px;
            color: #991b1b;
            font-size: 13px;
            line-height: 1.5;
            background: #fef2f2;
        }

        .alert-error svg {
            flex: 0 0 18px;
            width: 18px;
            height: 18px;
            margin-top: 1px;
        }

        .submit-button {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            height: 60px;
            padding: 0 24px;
            border: 0;
            border-radius: 14px;
            color: white;
            font-size: 15px;
            font-weight: 750;
            background: linear-gradient(
                135deg,
                var(--primary-dark),
                #3b82f6
            );
            box-shadow: 0 14px 30px rgba(37, 99, 235, 0.24);
            cursor: pointer;
            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease,
                opacity 0.2s ease;
        }

        .submit-button:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 18px 35px rgba(37, 99, 235, 0.30);
        }

        .submit-button:active:not(:disabled) {
            transform: translateY(0);
        }

        .submit-button:disabled {
            cursor: not-allowed;
            opacity: 0.72;
        }

        .button-arrow {
            width: 18px;
            height: 18px;
            transition: transform 0.2s ease;
        }

        .submit-button:hover:not(:disabled) .button-arrow {
            transform: translateX(3px);
        }

        .spinner {
            display: none;
            width: 18px;
            height: 18px;
            border: 2px solid rgba(255, 255, 255, 0.35);
            border-top-color: white;
            border-radius: 50%;
            animation: spin 0.75s linear infinite;
        }

        .submit-button.loading .spinner {
            display: inline-block;
        }

        .submit-button.loading .button-arrow {
            display: none;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .login-footer {
            margin-top: 32px;
            text-align: center;
            color: #94a3b8;
            font-size: 12px;
            line-height: 1.6;
        }

        .login-footer strong {
            color: #64748b;
            font-weight: 700;
        }

        /* Responsive styles */

        @@media (max-width: 1100px) {
            .auth-page {
                grid-template-columns: minmax(0, 1fr) minmax(420px, 0.9fr);
            }

            .hero-panel {
                padding: 40px;
            }

            .hero-title {
                font-size: 50px;
                letter-spacing: -2px;
            }

            .login-panel {
                padding: 40px;
            }
        }

        @@media (max-width: 850px) {
            .auth-page {
                display: block;
            }

            .hero-panel {
                display: none;
            }

            .login-panel {
                min-height: 100vh;
                padding: 35px 24px;
                background:
                    radial-gradient(
                        circle at 100% 0%,
                        rgba(191, 219, 254, 0.75),
                        transparent 34%
                    ),
                    radial-gradient(
                        circle at 0% 100%,
                        rgba(219, 234, 254, 0.7),
                        transparent 36%
                    ),
                    #f8fafc;
            }

            .login-wrapper {
                max-width: 480px;
            }

            .mobile-brand {
                display: flex;
            }

            .login-heading {
                font-size: 36px;
            }
        }

        @@media (max-width: 480px) {
            .login-panel {
                align-items: flex-start;
                padding: 24px 20px 35px;
            }

            .mobile-brand {
                margin-bottom: 52px;
            }

            .login-heading {
                font-size: 32px;
            }

            .security-notice {
                padding: 13px;
            }

            .form-control,
            .submit-button {
                height: 56px;
            }
        }
@@keyframes fadeInUp {

    from {
        opacity: 0;
        transform: translateY(25px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}
@@keyframes fadeInRight {

    from {
        opacity: 0;
        transform: translateX(40px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }
}
    </style>

    <link rel="stylesheet" href="~/css/auth-glass.css" asp-append-version="true" />
</head>

<body>
@if (TempData["SessionExpired"] != null)
{
    <div class="alert alert-warning">
        @TempData["SessionExpired"]
    </div>
}
    <main class="auth-page">

        <section class="hero-panel">
            <header class="brand">
                <div class="brand-mark">H28</div>

                <div>
                    <div class="brand-name">Hithaai Roohun 2028</div>
                    <div class="brand-caption">
                        Campaign Intelligence Platform
                    </div>
                </div>
            </header>

            <div class="hero-content">
                <div class="eyebrow">
                    <span class="eyebrow-dot"></span>
                    Secure campaign operations
                </div>

                <h1 class="hero-title">
                    Turn voter insights into
                    <span>campaign action.</span>
                </h1>

                <p class="hero-description">
                    A unified platform for voter registration, engagement
                    tracking, constituency operations and campaign oversight.
                </p>

                <div class="feature-grid">
                    <div class="feature-item">
                        <span class="feature-icon">
                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 aria-hidden="true">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                <circle cx="9" cy="7" r="4" />
                                <path d="M19 8v6M22 11h-6" />
                            </svg>
                        </span>

                        Voter registration
                    </div>

                    <div class="feature-item">
                        <span class="feature-icon">
                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 aria-hidden="true">
                                <path d="M3 3v18h18" />
                                <path d="m7 16 4-5 4 3 5-7" />
                            </svg>
                        </span>

                        Campaign analytics
                    </div>

                    <div class="feature-item">
                        <span class="feature-icon">
                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 aria-hidden="true">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                                <path d="m9 12 2 2 4-4" />
                            </svg>
                        </span>

                        Role-based access
                    </div>

                    <div class="feature-item">
                        <span class="feature-icon">
                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 aria-hidden="true">
                                <path d="M9 11l3 3L22 4" />
                                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                            </svg>
                        </span>

                        Complete audit trail
                    </div>
                </div>
            </div>

            <footer class="hero-footer">
                <span class="status-dot"></span>
                Secure access portal
            </footer>
        </section>

        <section class="login-panel">
            <div class="login-wrapper">

                <div class="mobile-brand">
                    <div class="brand-mark">H28</div>

                    <div>
                        <div class="brand-name" style="color: #0f172a;">
                            HR28
                        </div>

                        <div class="brand-caption" style="color: #64748b;">
                            Campaign Intelligence Platform
                        </div>
                    </div>
                </div>

                <h2 class="login-heading">Welcome back</h2>

                <p class="login-description">
                    Enter your assigned authorization code.
                    A one-time verification code will be sent to continue.
                </p>

                <div class="security-notice">
                    <div class="security-notice-icon">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             aria-hidden="true">
                            <rect x="3" y="11" width="18" height="10" rx="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                    </div>

                    <div>
                        <div class="security-notice-title">
                            Secure two-step authentication
                        </div>

                        <div class="security-notice-text">
                            Your authorization code is verified before an OTP
                            is issued.
                        </div>
                    </div>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert-error" role="alert">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             aria-hidden="true">
                            <circle cx="12" cy="12" r="10" />
                            <path d="M12 8v4" />
                            <path d="M12 16h.01" />
                        </svg>

                        <span>@ViewBag.Error</span>
                    </div>
                }

                <form method="post" id="loginForm">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert-error">
                    </div>

                    <div class="form-group">
                        <label asp-for="AuthorizationCode"
                               class="form-label">
                            Authorization code
                        </label>

                        <div class="input-shell">
                            <svg class="input-icon"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 aria-hidden="true">
                                <circle cx="7.5" cy="15.5" r="5.5" />
                                <path d="m12 12 4-4 4 4-2 2 2 2-3 3" />
                            </svg>

                            <input asp-for="AuthorizationCode"
                                   id="authorizationCode"
                                   class="form-control"
                                   placeholder="Enter your authorization code"
                                   autocomplete="off"
                                   autocapitalize="characters"
                                   spellcheck="false"
                                   autofocus />

                            <button type="button"
                                    id="clearCodeButton"
                                    class="clear-button"
                                    aria-label="Clear authorization code">
                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     aria-hidden="true">
                                    <path d="M18 6 6 18M6 6l12 12" />
                                </svg>
                            </button>
                        </div>

                        <span asp-validation-for="AuthorizationCode"
                              class="field-validation-error">
                        </span>
                    </div>

                    <button type="submit"
                            id="loginButton"
                            class="submit-button">
                        <span class="spinner" aria-hidden="true"></span>

                        <span id="buttonText">Send verification code</span>

                        <svg class="button-arrow"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             aria-hidden="true">
                            <path d="M5 12h14M13 6l6 6-6 6" />
                        </svg>
                    </button>
                </form>

                <div class="login-footer">
                    Protected by secure OTP verification<br />
                    <strong>HR28 Secure Access Portal</strong>
                </div>
            </div>
        </section>

    </main>

    <script>
        (function () {
            const form = document.getElementById("loginForm");
            const input = document.getElementById("authorizationCode");
            const button = document.getElementById("loginButton");
            const buttonText = document.getElementById("buttonText");
            const clearButton = document.getElementById("clearCodeButton");

            function updateClearButton() {
                if (!input || !clearButton) {
                    return;
                }

                clearButton.style.display =
                    input.value.trim().length > 0 ? "flex" : "none";
            }

            if (input) {
                input.addEventListener("input", function () {
                    updateClearButton();
                });
            }

            if (clearButton && input) {
                clearButton.addEventListener("click", function () {
                    input.value = "";
                    input.focus();
                    updateClearButton();
                });
            }

            if (form && button && buttonText) {
                form.addEventListener("submit", function () {
                    if (!form.checkValidity()) {
                        return;
                    }

                    button.disabled = true;
                    button.classList.add("loading");
                    buttonText.textContent = "Sending verification code...";
                });
            }

            updateClearButton();
        })();
    </script>
</body>
</html>