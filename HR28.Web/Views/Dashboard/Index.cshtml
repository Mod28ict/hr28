@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                Welcome back!
            </h2>

            <p class="text-muted">
                Here's what's happening across HR28.
            </p>
        </div>

        <div>
            <a asp-controller="Voters"
               asp-action="Create"
               class="btn btn-primary">
                + Add Voter
            </a>
        </div>

    </div>

    <div class="row g-3">

        <div class="col-md-3">
            <div class="card stat-card border-0 shadow-sm">
                <div class="card-body">

                    <div class="stat-title">
                        Total Voters
                    </div>

                    <div class="stat-value text-primary">
                        @Model.Dashboard?.TotalVoters.ToString("N0")
                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card border-0 shadow-sm">
                <div class="card-body">

                    <div class="stat-title">
                        Supporters
                    </div>

                    <div class="stat-value text-success">
                        @Model.Dashboard?.Supporters.ToString("N0")
                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card border-0 shadow-sm">
                <div class="card-body">

                    <div class="stat-title">
                        Influencers
                    </div>

                    <div class="stat-value text-warning">
                        @Model.Dashboard?.TotalInfluencers.ToString("N0")
                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card border-0 shadow-sm">
                <div class="card-body">

                    <div class="stat-title">
                        Encounters
                    </div>

                    <div class="stat-value text-info">
                        @Model.Dashboard?.TotalEncounters.ToString("N0")
                    </div>

                </div>
            </div>
        </div>

    </div>

    <div class="row g-3 mt-2">

        <div class="col-md-3">
            <div class="card stat-card border-0 shadow-sm">
                <div class="card-body">

                    <div class="stat-title">
                        Total Pledges
                    </div>

                    <div class="stat-value text-secondary">
                        @Model.Dashboard?.TotalPledges.ToString("N0")
                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card border-0 shadow-sm">
                <div class="card-body">

                    <div class="stat-title">
                        Completed Pledges
                    </div>

                    <div class="stat-value text-dark">
                        @Model.Dashboard?.CompletedPledges.ToString("N0")
                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card border-0 shadow-sm">
                <div class="card-body">

                    <div class="stat-title">
                        Opponents
                    </div>

                    <div class="stat-value text-danger">
                        @Model.Dashboard?.Opponents.ToString("N0")
                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card border-0 shadow-sm">
                <div class="card-body">

                    <div class="stat-title">
                        Undecided
                    </div>

                    <div class="stat-value text-warning">
                        @Model.Dashboard?.Undecided.ToString("N0")
                    </div>

                </div>
            </div>
        </div>

    </div>

    <div class="row mt-4">

        <div class="col-md-5">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white">
                    <h5>
                        Voter Distribution
                    </h5>
                </div>

                <div class="card-body">

                    <table class="table table-sm">

                        <tr>
                            <td>Supporters</td>
                            <td>
                                @Model.Dashboard?.Supporters
                            </td>
                        </tr>

                        <tr>
                            <td>Opponents</td>
                            <td>
                                @Model.Dashboard?.Opponents
                            </td>
                        </tr>

                        <tr>
                            <td>Undecided</td>
                            <td>
                                @Model.Dashboard?.Undecided
                            </td>
                        </tr>

                        <tr>
                            <td>Neutral</td>
                            <td>
                                @Model.Dashboard?.Neutral
                            </td>
                        </tr>

                    </table>

                </div>

            </div>

        </div>

        <div class="col-md-7">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white">
                    <h5>
                        Recent Activity
                    </h5>
                </div>

                <div class="card-body">

                    <table class="table">

                        <thead>
                        <tr>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>Date</th>
                        </tr>
                        </thead>

                        <tbody>

                        @foreach (var item in Model.Activities.Take(10))
                        {
                            <tr>
                                <td>@item.Action</td>
                                <td>@item.EntityName</td>
                                <td>
                                    @item.CreatedAt.ToString("dd-MMM-yyyy HH:mm")
                                </td>
                            </tr>
                        }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

    <div class="row mt-4">

        <div class="col-md-12">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white">
                    <h5>
                        Recent Voters
                    </h5>
                </div>

                <div class="card-body">

                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>National ID</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var voter in Model.RecentVoters.Take(10))
                        {
                            <tr>
                                <td>@voter.FullName</td>
                                <td>@voter.NationalId</td>
                            </tr>
                        }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>
    