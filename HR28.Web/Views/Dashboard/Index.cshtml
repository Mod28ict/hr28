@model HR28.Web.Models.DashboardViewModel

<div class="container mt-4">

    <h2>HR28 Dashboard</h2>

    <div class="row">

        <div class="col-md-3 mb-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h5>Total Voters</h5>
                    <h2>@Model.Dashboard?.TotalVoters</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h5>Supporters</h5>
                    <h2>@Model.Dashboard?.Supporters</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card bg-warning">
                <div class="card-body">
                    <h5>Influencers</h5>
                    <h2>@Model.Dashboard?.TotalInfluencers</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h5>Encounters</h5>
                    <h2>@Model.Dashboard?.TotalEncounters</h2>
                </div>
            </div>
        </div>

    </div>

    <div class="row">

        <div class="col-md-3 mb-3">
            <div class="card bg-secondary text-white">
                <div class="card-body">
                    <h5>Total Pledges</h5>
                    <h2>@Model.Dashboard?.TotalPledges</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card bg-dark text-white">
                <div class="card-body">
                    <h5>Completed Pledges</h5>
                    <h2>@Model.Dashboard?.CompletedPledges</h2>
                </div>
            </div>
        </div>
        <hr />

        <h3>Recent Activity</h3>

        <table class="table table-striped">

            <thead>
                <tr>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Date</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model.Activities)
                {
                    <tr>
                        <td>@item.Action</td>
                        <td>@item.EntityName</td>
                        <td>@item.CreatedAt.ToString("dd-MMM-yyyy HH:mm")</td>
                    </tr>
                }

            </tbody>

        </table>
        <hr />

        <h3>Recent Voters</h3>

        <table class="table table-striped">

            <thead>
                <tr>
                    <th>National ID</th>
                    <th>Name</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var voter in Model.RecentVoters)
                {
                    <tr>
                        <td>@voter.NationalId</td>
                        <td>@voter.FullName</td>
                        <td>@voter.SupportStatus</td>
                    </tr>
                }

            </tbody>

        </table>

    </div>


</div>