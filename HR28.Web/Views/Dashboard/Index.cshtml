@model HR28.Web.Models.DashboardViewModel
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Dashboard";

    var dashboard = Model?.Dashboard ?? new HR28.Web.Models.DashboardDto();
    var activities = Model?.Activities ?? new();
    var recentVoters = Model?.RecentVoters ?? new();
    var constituencies = Model?.Constituencies ?? new();

    var role = Context.Session.GetString("UserRole");
    var isReporter = !HR28.Web.Services.Hr28Roles.CanManageRecords(role);
    var isSuperAdmin = HR28.Web.Services.Hr28Roles.IsSuperAdministrator(role);

    // The API decides scope; administrators get national figures.
    var isAdministrator = dashboard.IsAdministrator;

    var fullName = Context.Session.GetString("UserName") ?? "there";
    var firstName = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? fullName;

    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";

    var totalVoters = dashboard.TotalVoters;

    // Voters whose status is set; the donut shares are of these, not of all voters.
    var classified = dashboard.Supporters + dashboard.Undecided + dashboard.Neutral + dashboard.Opponents;

    decimal Share(int part, int whole) =>
        whole == 0 ? 0 : Math.Round(part * 100m / whole, 1);

    var supporterPct = Share(dashboard.Supporters, classified);
    var undecidedPct = Share(dashboard.Undecided, classified);
    var neutralPct = Share(dashboard.Neutral, classified);
    var opponentPct = Share(dashboard.Opponents, classified);

    var stop1 = supporterPct;
    var stop2 = stop1 + undecidedPct;
    var stop3 = stop2 + neutralPct;
    var donutStyle = classified == 0
        ? "background: var(--hd-track);"
        : FormattableString.Invariant(
            $"background: conic-gradient(var(--hd-green) 0 {stop1}%, var(--hd-amber) {stop1}% {stop2}%, var(--hd-blue) {stop2}% {stop3}%, var(--hd-red) {stop3}% 100%);");

    var topConstituencies = constituencies
        .Where(c => c.TotalVoters > 0)
        .OrderByDescending(c => c.SupportPercentage)
        .Take(6)
        .ToList();

    string BandClass(decimal pct) => pct >= 65 ? "is-green" : pct >= 45 ? "is-amber" : "is-red";

    var withVoters = constituencies.Count(c => c.TotalVoters > 0);
    var highBand = constituencies.Count(c => c.TotalVoters > 0 && c.SupportPercentage >= 65);
    var midBand = constituencies.Count(c => c.TotalVoters > 0 && c.SupportPercentage >= 45 && c.SupportPercentage < 65);
    var lowBand = constituencies.Count(c => c.TotalVoters > 0 && c.SupportPercentage < 45);
    var noData = constituencies.Count - withVoters;
    var coveragePct = constituencies.Count == 0 ? 0 : (int)Math.Round(withVoters * 100m / constituencies.Count);

    string Pct(decimal value) => value.ToString("0.#") + "%";

    string RelativeTime(DateTime when)
    {
        var utc = when.Kind == DateTimeKind.Local ? when.ToUniversalTime() : when;
        var span = DateTime.UtcNow - utc;

        if (span.TotalMinutes < 1) return "Just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} min ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} hr ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays} day{((int)span.TotalDays == 1 ? "" : "s")} ago";
        return utc.ToLocalTime().ToString("dd MMM yyyy");
    }

    (string Tone, string Icon) ActivityStyle(string action)
    {
        var a = action.ToLowerInvariant();
        if (a.Contains("delete") || a.Contains("remove")) return ("is-red", "trash");
        if (a.Contains("create") || a.Contains("add") || a.Contains("link")) return ("is-green", "plus");
        return ("is-blue", "edit");
    }

    string StatusClass(string status) => status switch
    {
        "Supporter" => "is-green",
        "Undecided" => "is-amber",
        "Opponent" or "Opposition" => "is-red",
        "Neutral" => "is-blue",
        _ => "is-muted"
    };

    string InitialsOf(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
}

<div class="hd">

    <!-- HEADER -->
    <section class="hd-header">
        <div>
            <h1 class="hd-greeting">@greeting, @firstName <span aria-hidden="true">👋</span></h1>
            <p class="hd-sub">Here's what's happening across your campaign today.</p>
        </div>

        <div class="hd-header-side">
            <div class="hd-date">
                <span class="hd-date-icon"><partial name="_Icon" model='"calendar"' /></span>
                <span>
                    <strong>@DateTime.Now.ToString("dddd, dd MMMM yyyy")</strong>
                    <small>Let's make progress.</small>
                </span>
            </div>

            @if (!isReporter)
            {
                <a class="hd-btn-primary" asp-controller="Voters" asp-action="Create">
                    <partial name="_Icon" model='"plus"' />
                    Add Voter
                </a>
            }

            <blockquote class="hd-quote">
                <p>“Better insights.<br />Stronger connections.”</p>
                <cite>— HR28</cite>
            </blockquote>
        </div>
    </section>

    <!-- KPI CARDS -->
    <section class="hd-kpis" aria-label="Key figures">

        <div class="hd-kpi is-blue">
            <span class="hd-kpi-icon"><partial name="_Icon" model='"users"' /></span>
            <div>
                <div class="hd-kpi-label">Total Voters</div>
                <div class="hd-kpi-value">@totalVoters.ToString("N0")</div>
                <div class="hd-kpi-foot">In your scope</div>
            </div>
        </div>

        <div class="hd-kpi is-green">
            <span class="hd-kpi-icon"><partial name="_Icon" model='"user-check"' /></span>
            <div>
                <div class="hd-kpi-label">Supporters</div>
                <div class="hd-kpi-value">@dashboard.Supporters.ToString("N0")</div>
                <div class="hd-kpi-foot"><b>@Pct(Share(dashboard.Supporters, totalVoters))</b> of voters</div>
            </div>
        </div>

        <div class="hd-kpi is-amber">
            <span class="hd-kpi-icon"><partial name="_Icon" model='"help"' /></span>
            <div>
                <div class="hd-kpi-label">Undecided</div>
                <div class="hd-kpi-value">@dashboard.Undecided.ToString("N0")</div>
                <div class="hd-kpi-foot"><b>@Pct(Share(dashboard.Undecided, totalVoters))</b> of voters</div>
            </div>
        </div>

        <div class="hd-kpi is-red">
            <span class="hd-kpi-icon"><partial name="_Icon" model='"user-x"' /></span>
            <div>
                <div class="hd-kpi-label">Opposition</div>
                <div class="hd-kpi-value">@dashboard.Opponents.ToString("N0")</div>
                <div class="hd-kpi-foot"><b>@Pct(Share(dashboard.Opponents, totalVoters))</b> of voters</div>
            </div>
        </div>

        <div class="hd-kpi is-violet">
            <span class="hd-kpi-icon"><partial name="_Icon" model='"calendar"' /></span>
            <div>
                <div class="hd-kpi-label">Encounters</div>
                <div class="hd-kpi-value">@dashboard.TotalEncounters.ToString("N0")</div>
                <div class="hd-kpi-foot">Recorded to date</div>
            </div>
        </div>

        <div class="hd-kpi is-green">
            <span class="hd-kpi-icon"><partial name="_Icon" model='"handshake"' /></span>
            <div>
                <div class="hd-kpi-label">Pledges</div>
                <div class="hd-kpi-value">@dashboard.TotalPledges.ToString("N0")</div>
                <div class="hd-kpi-foot"><b>@dashboard.OpenPledges.ToString("N0")</b> open · @dashboard.CompletedPledges.ToString("N0") completed</div>
            </div>
        </div>

        <div class="hd-kpi is-violet">
            <span class="hd-kpi-icon"><partial name="_Icon" model='"star"' /></span>
            <div>
                <div class="hd-kpi-label">Influencers</div>
                <div class="hd-kpi-value">@dashboard.TotalInfluencers.ToString("N0")</div>
                <div class="hd-kpi-foot">Community connectors</div>
            </div>
        </div>

        @if (isAdministrator)
        {
            <div class="hd-kpi is-blue">
                <span class="hd-kpi-icon"><partial name="_Icon" model='"user"' /></span>
                <div>
                    <div class="hd-kpi-label">Users</div>
                    <div class="hd-kpi-value">@dashboard.TotalUsers.ToString("N0")</div>
                    <div class="hd-kpi-foot">@dashboard.TotalRoles.ToString("N0") access roles</div>
                </div>
            </div>
        }
        else
        {
            <div class="hd-kpi is-blue">
                <span class="hd-kpi-icon"><partial name="_Icon" model='"map-pin"' /></span>
                <div>
                    <div class="hd-kpi-label">Your area</div>
                    <div class="hd-kpi-value">@dashboard.TotalIslands.ToString("N0")</div>
                    <div class="hd-kpi-foot">islands in @dashboard.TotalConstituencies.ToString("N0") @(dashboard.TotalConstituencies == 1 ? "constituency" : "constituencies")</div>
                </div>
            </div>
        }

    </section>

    <!-- ANALYTICS ROW -->
    <section class="hd-row hd-row-analytics">

        <!-- Voter distribution -->
        <div class="hd-card">
            <div class="hd-card-head">
                <h2>Voter Distribution</h2>
                <span class="hd-chip">@(isAdministrator ? "All constituencies" : "Your assigned area")</span>
            </div>

            @if (classified == 0)
            {
                <div class="hd-empty">No voters have a support status yet.</div>
            }
            else
            {
                <div class="hd-dist">
                    <div class="hd-donut" style="@donutStyle" role="img"
                         aria-label="@($"Supporters {Pct(supporterPct)}, Undecided {Pct(undecidedPct)}, Neutral {Pct(neutralPct)}, Opposition {Pct(opponentPct)}")">
                        <div class="hd-donut-center">
                            <strong>@classified.ToString("N0")</strong>
                            <span>Voters with status</span>
                        </div>
                    </div>

                    <ul class="hd-legend">
                        <li><i class="is-green"></i><span>Supporters</span><b>@Pct(supporterPct)</b><em>@dashboard.Supporters.ToString("N0")</em></li>
                        <li><i class="is-amber"></i><span>Undecided</span><b>@Pct(undecidedPct)</b><em>@dashboard.Undecided.ToString("N0")</em></li>
                        <li><i class="is-blue"></i><span>Neutral</span><b>@Pct(neutralPct)</b><em>@dashboard.Neutral.ToString("N0")</em></li>
                        <li><i class="is-red"></i><span>Opposition</span><b>@Pct(opponentPct)</b><em>@dashboard.Opponents.ToString("N0")</em></li>
                    </ul>
                </div>

                @if (classified < totalVoters)
                {
                    <p class="hd-note">@((totalVoters - classified).ToString("N0")) voters have no support status recorded.</p>
                }
            }
        </div>

        <!-- Constituency performance -->
        <div class="hd-card">
            <div class="hd-card-head">
                <h2>Constituency Performance</h2>
                <a class="hd-link" asp-controller="Reports" asp-action="ConstituencySummary">View all</a>
            </div>

            @if (!topConstituencies.Any())
            {
                <div class="hd-empty">No constituency in your area has voters yet.</div>
            }
            else
            {
                <p class="hd-caption">Share of voters who are supporters</p>
                <ul class="hd-bars">
                    @foreach (var c in topConstituencies)
                    {
                        var pct = Math.Clamp(c.SupportPercentage, 0, 100);
                        <li>
                            <span class="hd-bar-name" title="@c.ConstituencyName">@c.ConstituencyName</span>
                            <span class="hd-bar-track">
                                <span class="hd-bar-fill @BandClass(pct)" style="width: @(pct.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
                            </span>
                            <b>@Pct(pct)</b>
                        </li>
                    }
                </ul>
            }
        </div>

        <!-- Coverage -->
        <div class="hd-card">
            <div class="hd-card-head">
                <h2>Coverage</h2>
                <span class="hd-chip">Support level</span>
            </div>

            <div class="hd-coverage">
                <div class="hd-coverage-stats">
                    <div>
                        <span>Constituencies</span>
                        <strong>@dashboard.TotalConstituencies.ToString("N0")</strong>
                    </div>
                    <div>
                        <span>Islands</span>
                        <strong>@dashboard.TotalIslands.ToString("N0")</strong>
                    </div>
                    @if (constituencies.Any())
                    {
                        <div>
                            <span>With voters</span>
                            <strong>@coveragePct%</strong>
                        </div>
                    }
                </div>

                @if (constituencies.Any())
                {
                    <div class="hd-progress" role="progressbar" aria-label="Constituencies with voters"
                         aria-valuenow="@coveragePct" aria-valuemin="0" aria-valuemax="100">
                        <span style="width: @coveragePct%"></span>
                    </div>

                    <ul class="hd-bands">
                        <li><i class="is-green"></i>High support <small>65%+</small><b>@highBand</b></li>
                        <li><i class="is-amber"></i>Medium <small>45–64%</small><b>@midBand</b></li>
                        <li><i class="is-red"></i>Low support <small>under 45%</small><b>@lowBand</b></li>
                        <li><i class="is-muted"></i>No data<b>@noData</b></li>
                    </ul>
                }
                else
                {
                    <p class="hd-note">Constituencies and islands in your assigned scope.</p>
                }
            </div>
        </div>

    </section>

    <!-- LISTS ROW -->
    <section class="hd-row hd-row-lists">

        <!-- Recent activity -->
        <div class="hd-card">
            <div class="hd-card-head">
                <h2>@(isAdministrator ? "Recent Activity" : "Your Recent Activity")</h2>
                <a class="hd-link" asp-controller="Audit" asp-action="Index">View all</a>
            </div>

            @if (!activities.Any())
            {
                <div class="hd-empty">No recent activity yet.</div>
            }
            else
            {
                <ul class="hd-list">
                    @foreach (var activity in activities.Take(5))
                    {
                        var style = ActivityStyle(activity.Action);
                        var what = string.IsNullOrWhiteSpace(activity.EntityLabel)
                            ? activity.EntityName
                            : $"{activity.EntityName}: {activity.EntityLabel}";

                        <li>
                            <span class="hd-list-icon @style.Tone"><partial name="_Icon" model="@style.Icon" /></span>
                            <span class="hd-list-text">
                                <strong title="@activity.Action">
                                    @if (isAdministrator && !string.IsNullOrWhiteSpace(activity.ActorName))
                                    {
                                        @activity.ActorName<text> · </text>
                                    }
                                    @activity.Action
                                </strong>
                                <small title="@what">@what · @RelativeTime(activity.CreatedAt)</small>
                            </span>
                        </li>
                    }
                </ul>
            }
        </div>

        <!-- Recently added voters -->
        <div class="hd-card">
            <div class="hd-card-head">
                <h2>Recently Added Voters</h2>
                @if (!isReporter)
                {
                    <a class="hd-link" asp-controller="Voters" asp-action="Index">View all</a>
                }
            </div>

            @if (!recentVoters.Any())
            {
                <div class="hd-empty">No voters added yet.</div>
            }
            else
            {
                <ul class="hd-list">
                    @foreach (var voter in recentVoters.Take(5))
                    {
                        var name = string.IsNullOrWhiteSpace(voter.FullName) ? "Unnamed voter" : voter.FullName;
                        var place = string.Join(" · ", new[] { voter.IslandName, voter.ConstituencyName }.Where(s => !string.IsNullOrWhiteSpace(s)));
                        var status = string.IsNullOrWhiteSpace(voter.SupportStatus) ? "Not set" : voter.SupportStatus;

                        <li>
                            <span class="hd-avatar" aria-hidden="true">@InitialsOf(name)</span>
                            <span class="hd-list-text">
                                @if (!isReporter)
                                {
                                    <a asp-controller="Voters" asp-action="Profile" asp-route-id="@voter.Id"><strong>@name</strong></a>
                                }
                                else
                                {
                                    <strong>@name</strong>
                                }
                                <small>@(string.IsNullOrEmpty(place) ? "No location set" : place)</small>
                            </span>
                            <span class="hd-pill @StatusClass(voter.SupportStatus)">@status</span>
                        </li>
                    }
                </ul>
            }
        </div>

        <!-- Quick actions -->
        <div class="hd-card">
            <div class="hd-card-head">
                <h2>Quick Actions</h2>
            </div>

            <div class="hd-actions">
                @if (!isReporter)
                {
                    <a class="hd-action is-blue" asp-controller="Voters" asp-action="Create">
                        <partial name="_Icon" model='"user-plus"' />
                        <span>Add Voter</span>
                    </a>
                    <a class="hd-action is-blue" asp-controller="Voters" asp-action="Index" title="Choose a voter, then record an encounter">
                        <partial name="_Icon" model='"calendar"' />
                        <span>Record Encounter</span>
                    </a>
                    <a class="hd-action is-green" asp-controller="Voters" asp-action="Index" title="Choose a voter, then add a pledge">
                        <partial name="_Icon" model='"handshake"' />
                        <span>Add Pledge</span>
                    </a>
                    <a class="hd-action is-violet" asp-controller="Influencers" asp-action="Create">
                        <partial name="_Icon" model='"star"' />
                        <span>Add Influencer</span>
                    </a>
                }
                @if (isSuperAdmin)
                {
                    <a class="hd-action is-blue" asp-controller="Users" asp-action="Index">
                        <partial name="_Icon" model='"users"' />
                        <span>Manage Users</span>
                    </a>
                }
                else
                {
                    <a class="hd-action is-blue" asp-controller="Audit" asp-action="Index">
                        <partial name="_Icon" model='"clipboard"' />
                        <span>Audit Trail</span>
                    </a>
                }
                <a class="hd-action is-green" asp-controller="Reports" asp-action="Index">
                    <partial name="_Icon" model='"chart"' />
                    <span>Reports</span>
                </a>
                @if (isReporter)
                {
                    <a class="hd-action is-amber" asp-controller="Reports" asp-action="Pledges">
                        <partial name="_Icon" model='"file"' />
                        <span>Pledge Report</span>
                    </a>
                }
            </div>
        </div>

    </section>

</div>
